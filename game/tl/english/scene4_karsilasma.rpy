# English translation — scene4_karsilasma.rpy (Scene 4: The Snuffed Knight)

# game/scene4_karsilasma.rpy:34
translate english sahne4_karsilasma_20431d2e:

    # si "Işık yaklaşıyor. Ben de ona."
    si "The light approaches. So do I."

# game/scene4_karsilasma.rpy:36
translate english sahne4_karsilasma_a264fd1c:

    # s "Neden yaklaşıyorum?"
    s "Why am I approaching?"

# game/scene4_karsilasma.rpy:38
translate english sahne4_karsilasma_a36e843b:

    # si "Fısıltı hâlâ sessiz. Kafamın içi ilk defa bu kadar boş."
    si "The whisper is still silent. My head has never been this empty."

# game/scene4_karsilasma.rpy:40
translate english sahne4_karsilasma_ef3d3fec:

    # s "Yalnızlık böyle bir şeymiş demek."
    s "So this is what loneliness is like."

# game/scene4_karsilasma.rpy:42
translate english sahne4_karsilasma_e3042820:

    # s "Sevmedim. Sesin geri gelsin istedim."
    s "I didn't like it. I wanted your voice back."

# game/scene4_karsilasma.rpy:44
translate english sahne4_karsilasma_ad598ea4:

    # s "Bunu daha da sevmedim."
    s "I liked that even less."

# game/scene4_karsilasma.rpy:49
translate english sahne4_karsilasma_0378b32d:

    # si "Işık köşeyi dönüyor. Ve ikimiz de duruyoruz."
    si "The light rounds the corner. And we both stop."

# game/scene4_karsilasma.rpy:51
translate english sahne4_karsilasma_680898e3:

    # si "Burası bir oda. Yuvarlak, taş. Zeminindeki lekeler eski ve kahverengi."
    si "This is a chamber. Round, stone. The stains on its floor are old and brown."

# game/scene4_karsilasma.rpy:53
translate english sahne4_karsilasma_fa024a6a:

    # si "Bir adam. Zırhı paslı, kayışlarından dökülüyor."
    si "A man. His armor is rusted, sagging off its straps."

# game/scene4_karsilasma.rpy:55
translate english sahne4_karsilasma_99fc790d:

    # si "Elinde bir lamba. Benimkinin eşi."
    si "A lamp in his hand. The twin of mine."

# game/scene4_karsilasma.rpy:57
translate english sahne4_karsilasma_9e3ec9c9:

    # s "Ama alevi... avuç içi kadar. Ölmek üzere."
    s "But his flame... is the size of a palm. About to die."

# game/scene4_karsilasma.rpy:59
translate english sahne4_karsilasma_60b8a2c9:

    # si "Yüzü kurumuş toprak gibi çatlamış. Gözleri iki kör kuyu."
    si "His face is cracked like dried earth. His eyes are two blind wells."

# game/scene4_karsilasma.rpy:61
translate english sahne4_karsilasma_639b733f:

    # sk "..."
    sk "..."

# game/scene4_karsilasma.rpy:63
translate english sahne4_karsilasma_fe55baf6:

    # sk "Yeni."
    sk "New."

# game/scene4_karsilasma.rpy:65
translate english sahne4_karsilasma_c08d8c1d:

    # sk "Yenisin. Alevin gür."
    sk "You're new. Your flame is full."

# game/scene4_karsilasma.rpy:67
translate english sahne4_karsilasma_25bae4d2:

    # s "Kimsin?"
    s "Who are you?"

# game/scene4_karsilasma.rpy:69
translate english sahne4_karsilasma_2a4a149b:

    # si "Kuru bir ses çıkarıyor. Gülüyor olabilir."
    si "He makes a dry sound. It might be laughter."

# game/scene4_karsilasma.rpy:71
translate english sahne4_karsilasma_a7228684:

    # sk "Kim yok. Kim çoktan bitti."
    sk "There is no who. The who ended long ago."

# game/scene4_karsilasma.rpy:73
translate english sahne4_karsilasma_a3dd4700:

    # sk "Ben sadece... kaldım."
    sk "I just... remained."

# game/scene4_karsilasma.rpy:80
translate english sahne4_tanisma_57fb08e4:

    # si "Başını yana eğiyor. Kulak kabartır gibi."
    si "He tilts his head. As if listening for something."

# game/scene4_karsilasma.rpy:82
translate english sahne4_tanisma_228047ff:

    # sk "Kafan. Dolu mu hâlâ?"
    sk "Your head. Is it still occupied?"

# game/scene4_karsilasma.rpy:84
translate english sahne4_tanisma_849b9dc7:

    # s "...ne?"
    s "...what?"

# game/scene4_karsilasma.rpy:86
translate english sahne4_tanisma_f17711eb:

    # sk "İçindeki. Konuşan. Tatlı sözler fısıldayan."
    sk "The one inside. The one that talks. That whispers sweet things."

# game/scene4_karsilasma.rpy:88
translate english sahne4_tanisma_362f4d21:

    # s "Sen nereden—"
    s "How do you—"

# game/scene4_karsilasma.rpy:90
translate english sahne4_tanisma_241504de:

    # sk "Bende de vardı."
    sk "I had one too."

# game/scene4_karsilasma.rpy:92
translate english sahne4_tanisma_4622e8be:

    # sk "Bir gün sustu. Ve bir daha konuşmadı."
    sk "One day it went quiet. And never spoke again."

# game/scene4_karsilasma.rpy:94
translate english sahne4_tanisma_7609aa1e:

    # sk "Sustuğu gün... dökülmeye başladım."
    sk "The day it went quiet... I began to crumble."

# game/scene4_karsilasma.rpy:96
translate english sahne4_tanisma_b050777c:

    # si "Çatlak yüzünü ışığa çeviriyor. Çatlakların içi boş."
    si "He turns his cracked face to the light. The cracks are hollow inside."

# game/scene4_karsilasma.rpy:98
translate english sahne4_tanisma_99af4db9:

    # sk "İsmimi o götürdü. Yüzümü o götürdü."
    sk "It took my name. It took my face."

# game/scene4_karsilasma.rpy:100
translate english sahne4_tanisma_5693e39d:

    # sk "Alevim de peşinden gitti."
    sk "My flame followed after."

# game/scene4_karsilasma.rpy:113
translate english sahne4_istek_f09e2692:

    # si "Bir adım atıyor. Lambası titriyor."
    si "He takes a step. His lamp trembles."

# game/scene4_karsilasma.rpy:115
translate english sahne4_istek_f515d21b:

    # sk "Alevinden ver."
    sk "Give me some of your flame."

# game/scene4_karsilasma.rpy:117
translate english sahne4_istek_81c3c1f0:

    # sk "Bir nefes. Bir nefes yeter."
    sk "One breath. One breath is enough."

# game/scene4_karsilasma.rpy:119
translate english sahne4_istek_d004a3a3:

    # si "Elini uzatıyor. Parmakları kavruk dallar gibi."
    si "He holds out his hand. His fingers are like scorched branches."

# game/scene4_karsilasma.rpy:125
translate english sahne4_istek_fceea8b0:

    # s "...döndün."
    s "...you're back."

# game/scene4_karsilasma.rpy:129
translate english sahne4_istek_cdf84b0c:

    # s "Neden?"
    s "Why?"

# game/scene4_karsilasma.rpy:158
translate english sahne4_sor_f833cfaf:

    # s "İçimdeki şey... ne istiyor benden?"
    s "The thing inside me... what does it want from me?"

# game/scene4_karsilasma.rpy:160
translate english sahne4_sor_20ff343d:

    # si "Sönmüş adam duruyor. Kör kuyular bana dönüyor."
    si "The snuffed man goes still. The blind wells turn toward me."

# game/scene4_karsilasma.rpy:162
translate english sahne4_sor_86c2f30b:

    # sk "İstemek."
    sk "Want."

# game/scene4_karsilasma.rpy:164
translate english sahne4_sor_d6eaf60a:

    # sk "Onlar istemez. Beklerler."
    sk "They don't want. They wait."

# game/scene4_karsilasma.rpy:166
translate english sahne4_sor_5ee1cf95:

    # s "Neyi bekler?"
    s "Wait for what?"

# game/scene4_karsilasma.rpy:168
translate english sahne4_sor_3ed08769:

    # sk "Yer."
    sk "A place."

# game/scene4_karsilasma.rpy:170
translate english sahne4_sor_63f7664d:

    # sk "Senden geriye kalan yeri."
    sk "The place that's left when you're gone."

# game/scene4_karsilasma.rpy:174
translate english sahne4_sor_274e0da8:

    # s "İlk defa bu kadar hızlı cevap verdin."
    s "That's the fastest you've ever answered."

# game/scene4_karsilasma.rpy:190
translate english sahne4_geri_cekil_92d508e9:

    # s "Geri çekil."
    s "Step back."

# game/scene4_karsilasma.rpy:192
translate english sahne4_geri_cekil_7dca0298:

    # si "Sesime, benim olmayan bir ağırlık biniyor."
    si "A weight that isn't mine settles onto my voice."

# game/scene4_karsilasma.rpy:194
translate english sahne4_geri_cekil_47cb6c92:

    # s "Alevimden uzak dur."
    s "Stay away from my flame."

# game/scene4_karsilasma.rpy:213
translate english sahne4_geri_krit_basari_09852d27:

    # si "Sönmüş adam donuyor."
    si "The snuffed man freezes."

# game/scene4_karsilasma.rpy:215
translate english sahne4_geri_krit_basari_a8990977:

    # sk "O ses."
    sk "That voice."

# game/scene4_karsilasma.rpy:217
translate english sahne4_geri_krit_basari_2ca19498:

    # sk "İkiniz birden konuştunuz."
    sk "The two of you spoke at once."

# game/scene4_karsilasma.rpy:219
translate english sahne4_geri_krit_basari_5c4d4178:

    # si "Geri geri gidiyor. Kavruk eli göğsünde, kalkan gibi."
    si "He backs away. His scorched hand is on his chest, like a shield."

# game/scene4_karsilasma.rpy:221
translate english sahne4_geri_krit_basari_6552ebe0:

    # sk "Bende de öyle başlamıştı."
    sk "That's how it started with me too."

# game/scene4_karsilasma.rpy:223
translate english sahne4_geri_krit_basari_2660ef29:

    # si "Karanlığa karışmadan önce duruyor. Kemerinden bir şey çözüyor."
    si "Before he melts into the dark, he stops. Unfastens something from his belt."

# game/scene4_karsilasma.rpy:225
translate english sahne4_geri_krit_basari_b69d1ce2:

    # si "Taşın üstüne bırakıyor: bir kılıç. Paslı, kınsız. Ama kılıç."
    si "He lays it on the stone: a sword. Rusted, sheathless. But a sword."

# game/scene4_karsilasma.rpy:227
translate english sahne4_geri_krit_basari_c6c8612e:

    # sk "Kuleye silahsız gidilmez. Bana artık... yük."
    sk "No one goes to the tower unarmed. To me it's just... weight now."

# game/scene4_karsilasma.rpy:231
translate english sahne4_geri_krit_basari_c881230e:

    # centered "{color=#f5e9d0}KILIÇ ALINDI{/color}"
    centered "{color=#f5e9d0}SWORD TAKEN{/color}"

# game/scene4_karsilasma.rpy:233
translate english sahne4_geri_krit_basari_cf97d4e3:

    # si "Kabzayı kavrıyorum. Ellerim onu tanıyor."
    si "I grip the hilt. My hands know it."

# game/scene4_karsilasma.rpy:241
translate english sahne4_geri_basari_bb31ddd5:

    # si "Sönmüş adam sallanıyor. İleri... sonra geri."
    si "The snuffed man sways. Forward... then back."

# game/scene4_karsilasma.rpy:243
translate english sahne4_geri_basari_ba3d8abd:

    # sk "Gür alev. Gür ses."
    sk "Full flame. Full voice."

# game/scene4_karsilasma.rpy:245
translate english sahne4_geri_basari_70fb07fb:

    # sk "Benim de sesim gürdü. Bir zamanlar."
    sk "My voice was full too. Once."

# game/scene4_karsilasma.rpy:247
translate english sahne4_geri_basari_9c82a87b:

    # si "Dönüyor. Sürüklenen adımlarla, karanlığa."
    si "He turns. With dragging steps, into the dark."

# game/scene4_karsilasma.rpy:249
translate english sahne4_geri_basari_6b1e6fff:

    # sk "Kuleye gidiyorsan... acele et. Alevler kulede daha yavaş ölür."
    sk "If you're going to the tower... hurry. Flames die slower in the tower."

# game/scene4_karsilasma.rpy:251
translate english sahne4_geri_basari_2b3a587e:

    # si "Işığı köşede kayboluyor. Küçük, kırmızı, yalnız."
    si "His light vanishes around the corner. Small, red, alone."

# game/scene4_karsilasma.rpy:253
translate english sahne4_geri_basari_64328799:

    # s "Bir gün o... ben miyim?"
    s "Is he... me, one day?"

# game/scene4_karsilasma.rpy:261
translate english sahne4_geri_basarisiz_b2a53297:

    # si "Kör kuyular kısılıyor."
    si "The blind wells narrow."

# game/scene4_karsilasma.rpy:263
translate english sahne4_geri_basarisiz_68bd522a:

    # sk "Hayır. HAYIR. Beklemek bitti."
    sk "No. NO. The waiting is over."

# game/scene4_karsilasma.rpy:265
translate english sahne4_geri_basarisiz_753cb4a2:

    # si "Üstüme atılıyor. Kavruk parmaklar lambanın sapını buluyor."
    si "He lunges at me. Scorched fingers find the lamp's handle."

# game/scene4_karsilasma.rpy:281
translate english sahne4_bogusma_zafer_0c7fc0dd:

    # si "Bileğini yakalıyorum. Kuru dal gibi — buruyorum."
    si "I catch his wrist. Like a dry branch — I twist."

# game/scene4_karsilasma.rpy:283
translate english sahne4_bogusma_zafer_5ba23a8f:

    # si "Çatırdıyor. İnsan sesi değil; eski kapı sesi."
    si "It cracks. Not a human sound; the sound of an old door."

# game/scene4_karsilasma.rpy:285
translate english sahne4_bogusma_zafer_9b8de0f8:

    # si "Geriliyor. İki büklüm, lambasını göğsüne bastırıyor."
    si "He recoils. Doubled over, pressing his lamp to his chest."

# game/scene4_karsilasma.rpy:287
translate english sahne4_bogusma_zafer_cb3a0836:

    # sk "Bekleyeceğim. Karanlıkta."
    sk "I will wait. In the dark."

# game/scene4_karsilasma.rpy:289
translate english sahne4_bogusma_zafer_2f8fe891:

    # sk "Hepiniz sonunda karanlığa iniyorsunuz."
    sk "All of you come down to the dark eventually."

# game/scene4_karsilasma.rpy:291
translate english sahne4_bogusma_zafer_3295a113:

    # si "Karanlık onu geri alıyor."
    si "The dark takes him back."

# game/scene4_karsilasma.rpy:299
translate english sahne4_bogusma_bedel_a113e586:

    # si "Parmaklar sapı kavrıyor. Çekiyor."
    si "The fingers grip the handle. They pull."

# game/scene4_karsilasma.rpy:301
translate english sahne4_bogusma_bedel_133e530d:

    # si "Lamba aramızda. Alev savruluyor, küçülüyor—"
    si "The lamp is between us. The flame whips, shrinks—"

# game/scene4_karsilasma.rpy:303
translate english sahne4_bogusma_bedel_e47f9336:

    # s "Duvarlar. Duvarlar yaklaşıyor."
    s "The walls. The walls are closing in."

# game/scene4_karsilasma.rpy:305
translate english sahne4_bogusma_bedel_3945ca5a:

    # si "Dizimi karnına gömüyorum. Katlanıyor. Lambayı göğsüme çekiyorum."
    si "I drive my knee into his gut. He folds. I pull the lamp to my chest."

# game/scene4_karsilasma.rpy:307
translate english sahne4_bogusma_bedel_48b3c994:

    # si "Alev doğruluyor. Ama eski boyunda değil."
    si "The flame steadies. But it is not its old height."

# game/scene4_karsilasma.rpy:309
translate english sahne4_bogusma_bedel_da2d15b2:

    # s "Artık değil."
    s "Not anymore."

# game/scene4_karsilasma.rpy:313
translate english sahne4_bogusma_bedel_dcb506cf:

    # centered "{color=#cc2222}ALEV KÜÇÜLDÜ{/color}"
    centered "{color=#cc2222}THE FLAME SHRANK{/color}"

# game/scene4_karsilasma.rpy:317
translate english sahne4_bogusma_bedel_8de01411:

    # si "Sönmüş adam, dökülen parçalarını toplaya toplaya karanlığa emekliyor."
    si "The snuffed man crawls into the dark, gathering the pieces that fall off him."

# game/scene4_karsilasma.rpy:325
translate english sahne4_bogusma_olum_87423df6:

    # si "Parmaklar bileklerime kilitleniyor. Kuru. Ama demir gibi."
    si "The fingers lock around my wrists. Dry. But like iron."

# game/scene4_karsilasma.rpy:327
translate english sahne4_bogusma_olum_1f7b6071:

    # sk "O zaman ikimiz de."
    sk "Then both of us."

# game/scene4_karsilasma.rpy:329
translate english sahne4_bogusma_olum_4b14af9a:

    # sk "İkimiz de karanlıkta."
    sk "Both of us, in the dark."

# game/scene4_karsilasma.rpy:331
translate english sahne4_bogusma_olum_c2cefebb:

    # si "Çekiyor. Işığın çemberi ayaklarımın altından kayıyor."
    si "He pulls. The circle of light slides out from under my feet."

# game/scene4_karsilasma.rpy:333
translate english sahne4_bogusma_olum_baae1023:

    # s "Alevim. Alevim nerede—"
    s "My flame. Where is my flame—"

# game/scene4_karsilasma.rpy:344
translate english sahne4_geri_krit_fiyasko_5d990b97:

    # si "Kör kuyular... genişliyor."
    si "The blind wells... widen."

# game/scene4_karsilasma.rpy:346
translate english sahne4_geri_krit_fiyasko_b622f26f:

    # sk "Ses."
    sk "The voice."

# game/scene4_karsilasma.rpy:348
translate english sahne4_geri_krit_fiyasko_e2eb2bf6:

    # sk "SESİ DUYDUM. İçindekini duydum."
    sk "I HEARD THE VOICE. I heard the one inside you."

# game/scene4_karsilasma.rpy:350
translate english sahne4_geri_krit_fiyasko_e05dd19a:

    # sk "Onu istiyorum. VER. ONU. BANA."
    sk "I want it. GIVE. IT. TO ME."

# game/scene4_karsilasma.rpy:352
translate english sahne4_geri_krit_fiyasko_f813e825:

    # si "Lambaya değil. {b}Kafama{/b} atılıyor."
    si "Not at the lamp. He lunges at {b}my head{/b}."

# game/scene4_karsilasma.rpy:360
translate english sahne4_geri_krit_fiyasko_a222f424:

    # si "Onu kendimden söküp fırlatıyorum."
    si "I tear him off me and hurl him away."

# game/scene4_karsilasma.rpy:362
translate english sahne4_geri_krit_fiyasko_3cb310b4:

    # si "Taşa çarpıyor. Parçaları dökülüyor — kuru, gri parçalar."
    si "He hits the stone. Pieces fall off him — dry, gray pieces."

# game/scene4_karsilasma.rpy:364
translate english sahne4_geri_krit_fiyasko_9ef9f827:

    # si "Doğrulmuyor. Sürünerek, karanlığa."
    si "He doesn't get up. He crawls, into the dark."

# game/scene4_karsilasma.rpy:366
translate english sahne4_geri_krit_fiyasko_510cb53d:

    # sk "Verecektin."
    sk "You would have given it."

# game/scene4_karsilasma.rpy:368
translate english sahne4_geri_krit_fiyasko_0aab6532:

    # sk "Bir gün sen de vermek isteyeceksin. O zaman hatırla: verecektin."
    sk "One day you'll want to give it too. Remember then: you would have."

# game/scene4_karsilasma.rpy:376
translate english sahne4_geri_krit_fiyasko_04a33bf0:

    # si "Parmakları şakaklarıma yapışıyor."
    si "His fingers clamp onto my temples."

# game/scene4_karsilasma.rpy:378
translate english sahne4_geri_krit_fiyasko_df627e3d:

    # s "Kafamın içinde bir şey ÇEKİLİYOR—"
    s "Something inside my head is being PULLED—"

# game/scene4_karsilasma.rpy:396
translate english sahne4_alev_ver_528a4f28:

    # s "Yaklaş."
    s "Come closer."

# game/scene4_karsilasma.rpy:400
translate english sahne4_alev_ver_38bc50e2:

    # s "Bir nefes. Sadece bir nefes."
    s "One breath. Just one breath."

# game/scene4_karsilasma.rpy:404
translate english sahne4_alev_ver_b63eb1ae:

    # s "Sen sustuğunda ben durmadım. Şimdi de durmuyorum."
    s "I didn't stop when you went quiet. I'm not stopping now."

# game/scene4_karsilasma.rpy:410
translate english sahne4_alev_ver_6a01b558:

    # si "Durmuyorum."
    si "I don't stop."

# game/scene4_karsilasma.rpy:412
translate english sahne4_alev_ver_3c4a927e:

    # si "Lambamı uzatıyorum. Sönmüş adam kendi lambasının camını açıyor."
    si "I hold out my lamp. The snuffed man opens the glass of his own."

# game/scene4_karsilasma.rpy:414
translate english sahne4_alev_ver_991168d6:

    # si "İki alev birbirine uzanıyor. Ve değiyor."
    si "The two flames reach for each other. And touch."

# game/scene4_karsilasma.rpy:419
translate english sahne4_alev_ver_14ea3c8c:

    # si "Bir an — tek bir an — başka bir yerdeyim."
    si "For a moment — a single moment — I am somewhere else."

# game/scene4_karsilasma.rpy:421
translate english sahne4_alev_ver_87a38318:

    # s "Bir oda. Taş duvarlar. Bir ayna. Yerde uyanan bir adam."
    s "A room. Stone walls. A mirror. A man waking on the floor."

# game/scene4_karsilasma.rpy:423
translate english sahne4_alev_ver_72a88a59:

    # s "Adam o. Genç. Yüzü bütün. Ve kafasının içinde bir ses: {i}Kalk.{/i}"
    s "The man is him. Young. His face whole. And a voice inside his head: {i}Get up.{/i}"

# game/scene4_karsilasma.rpy:425
translate english sahne4_alev_ver_891ea8b4:

    # s "Aynı oda. Benim odam."
    s "The same room. My room."

# game/scene4_karsilasma.rpy:427
translate english sahne4_alev_ver_e8e74c02:

    # s "{b}Aynı ses.{/b}"
    s "{b}The same voice.{/b}"

# game/scene4_karsilasma.rpy:432
translate english sahne4_alev_ver_d77e75fc:

    # si "Alevler ayrılıyor."
    si "The flames part."

# game/scene4_karsilasma.rpy:434
translate english sahne4_alev_ver_9deafb27:

    # si "Onunki artık bir kıvılcım değil; küçük, dik bir alev. Benimki... eksik."
    si "His is no longer a spark; it's a small, upright flame. Mine is... less."

# game/scene4_karsilasma.rpy:438
translate english sahne4_alev_ver_dcb506cf:

    # centered "{color=#cc2222}ALEV KÜÇÜLDÜ{/color}"
    centered "{color=#cc2222}THE FLAME SHRANK{/color}"

# game/scene4_karsilasma.rpy:440
translate english sahne4_alev_ver_b9900305:

    # si "Sönmüş adam alevine bakıyor. Çatlak yüzünde bir şey kıpırdıyor."
    si "The snuffed man looks at his flame. Something stirs in his cracked face."

# game/scene4_karsilasma.rpy:442
translate english sahne4_alev_ver_c2bb9b65:

    # si "Belki bir yüz ifadesiydi. Bir zamanlar."
    si "Maybe it was an expression. Once."

# game/scene4_karsilasma.rpy:444
translate english sahne4_alev_ver_c7b2c2fd:

    # sk "Sıcak."
    sk "Warm."

# game/scene4_karsilasma.rpy:446
translate english sahne4_alev_ver_57531d84:

    # sk "Unutmuşum."
    sk "I had forgotten."

# game/scene4_karsilasma.rpy:454
translate english sahne4_hediye_cc4aef28:

    # si "Bana doğru eğiliyor. Sesi düşüyor. Fısıltıdan da alçağa."
    si "He leans toward me. His voice drops. Lower than a whisper."

# game/scene4_karsilasma.rpy:456
translate english sahne4_hediye_ba275a95:

    # sk "Dinle. İçindeki uyurken dinle."
    sk "Listen. Listen while the one inside you sleeps."

# game/scene4_karsilasma.rpy:458
translate english sahne4_hediye_3b4fca87:

    # sk "Adın. Hâlâ bir yerde saklı mı?"
    sk "Your name. Is it still hidden somewhere?"

# game/scene4_karsilasma.rpy:460
translate english sahne4_hediye_8f5c8efb:

    # s "Bilmiyorum. Hatırlamıyorum."
    s "I don't know. I don't remember."

# game/scene4_karsilasma.rpy:462
translate english sahne4_hediye_3a59480d:

    # sk "Bulduğunda... ona söyleme."
    sk "When you find it... don't tell it."

# game/scene4_karsilasma.rpy:464
translate english sahne4_hediye_09b7b3ec:

    # sk "Adını aldığı gün, kalmak için sebebi kalmaz."
    sk "The day it takes your name, it has no reason left to stay."

# game/scene4_karsilasma.rpy:470
translate english sahne4_hediye_53982ec9:

    # si "Sönmüş adam kemerinden paslı bir kılıç çözüyor. İki eliyle uzatıyor."
    si "The snuffed man unfastens a rusted sword from his belt. He offers it with both hands."

# game/scene4_karsilasma.rpy:472
translate english sahne4_hediye_894d61f0:

    # sk "Nefese karşılık. Kuleye silahsız gidilmez."
    sk "For the breath. No one goes to the tower unarmed."

# game/scene4_karsilasma.rpy:476
translate english sahne4_hediye_c881230e:

    # centered "{color=#f5e9d0}KILIÇ ALINDI{/color}"
    centered "{color=#f5e9d0}SWORD TAKEN{/color}"

# game/scene4_karsilasma.rpy:478
translate english sahne4_hediye_aba61fdd:

    # si "Karanlığa dönüyor. Ama adımları... daha az sürükleniyor."
    si "He turns back to the dark. But his steps... drag a little less."

# game/scene4_karsilasma.rpy:491
translate english sahne4_son_4de7b256:

    # si "Sönmüş gitti. Ben buradayım. Bu da bir şey."
    si "The Snuffed is gone. I am here. That's something."

# game/scene4_karsilasma.rpy:496
translate english sahne4_son_21b40869:

    # si "Yürümeye devam ediyorum."
    si "I keep walking."

# game/scene4_karsilasma.rpy:502
translate english sahne4_son_dfcdbce3:

    # s "Gelirsem?"
    s "And if I do?"

# game/scene4_karsilasma.rpy:506
translate english sahne4_son_226cb403:

    # si "Cevap yok. Ama kafamın içinde bir yerde, bir şey not alıyor."
    si "No answer. But somewhere inside my head, something takes a note."

# game/scene4_karsilasma.rpy:514
translate english sahne4_son_9369bd5d:

    # s "Biz. Yine biz."
    s "We. \"We\" again."

# game/scene4_karsilasma.rpy:520
translate english sahne4_son_7b02a1b0:

    # s "İltifat mı bu? Senden?"
    s "Was that a compliment? From you?"

# game/scene4_karsilasma.rpy:530
translate english sahne4_son_5f725d86:

    # si "Koridor bir eşiğe açılıyor: geniş, taş bir merdiven. Yukarı."
    si "The corridor opens onto a threshold: a wide stone stairway. Going up."

# game/scene4_karsilasma.rpy:532
translate english sahne4_son_2624f6f6:

    # si "Ve çok yukarıda, karanlığın inceldiği yerde: pencereler. Sıra sıra, sönük pencereler."
    si "And far above, where the darkness thins: windows. Row upon row of dead windows."

# game/scene4_karsilasma.rpy:534
translate english sahne4_son_8aa1340f:

    # s "Bir kule. İçindeyiz. Ya da altındayız."
    s "A tower. We're inside it. Or underneath it."

# game/scene4_karsilasma.rpy:536
translate english sahne4_son_43ebb7ab:

    # s "Kule ne, biliyor musun?"
    s "Do you know what the tower is?"

# game/scene4_karsilasma.rpy:540
translate english sahne4_son_1a35d2ea:

    # s "Söyleyecek misin?"
    s "Are you going to tell me?"

translate english strings:

    # game/scene4_karsilasma.rpy:140
    old "«Geri çekil de. Alevi koru.»"
    new "«Tell him to step back. Protect the flame.»"

    # game/scene4_karsilasma.rpy:143
    old "«Ona alevden ver.»"
    new "«Give him some of the flame.»"

    # game/scene4_karsilasma.rpy:146
    old "«Önce sor: içindeki şey ne istiyor?»"
    new "«Ask him first: what does the thing inside want?»"
# TODO: Translation updated at 2026-09-03 13:38

# game/scene4_karsilasma.rpy:339
translate english sahne4_bogusma_olum_9fa8c73d:

    # si "Ve bilekler çözülüyor."
    si "And the wrists come loose."

# game/scene4_karsilasma.rpy:341
translate english sahne4_bogusma_olum_639b733f:

    # sk "..."
    sk "..."

# game/scene4_karsilasma.rpy:343
translate english sahne4_bogusma_olum_774e9d03:

    # sk "Sesin. Sesin çok yüksek."
    sk "Your voice. Your voice is too loud."

# game/scene4_karsilasma.rpy:345
translate english sahne4_bogusma_olum_a6311b9d:

    # si "Geri sendeliyorum. Işığın çemberine düşüyorum, yüzükoyun."
    si "I stagger back. I fall into the circle of light, face down."

# game/scene4_karsilasma.rpy:351
translate english sahne4_bogusma_olum_1eeec9fd:

    # sk "Seninki hâlâ bağırıyor. Benimki bağırmayı bırakalı çok oldu."
    sk "Yours still screams. Mine stopped screaming a long time ago."

# game/scene4_karsilasma.rpy:403
translate english sahne4_geri_krit_fiyasko_e8bbdccb:

    # si "Parmaklar duruyor."
    si "The fingers stop."

# game/scene4_karsilasma.rpy:405
translate english sahne4_geri_krit_fiyasko_3d7789a0:

    # sk "\"Benim\" dedi."
    sk "\"Benim\" dedi."

# game/scene4_karsilasma.rpy:407
translate english sahne4_geri_krit_fiyasko_0eb51d16:

    # sk "Benimki bunu hiç demedi."
    sk "Mine never said that."

# game/scene4_karsilasma.rpy:409
translate english sahne4_geri_krit_fiyasko_5a301bcf:

    # si "Ve el çekiliyor. Kafamın içinde bir şey yırtık kalıyor."
    si "And the hand withdraws. Something stays torn inside my head."

