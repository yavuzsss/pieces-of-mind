# English translation — scene9_donus.rpy (Scene 9: The Return and the Parting)

# game/scene9_donus.rpy:30
translate english sahne9_donus_143214e5:

    # si "Koridor beni tanıyor artık."
    si "The corridor knows me now."

# game/scene9_donus.rpy:32
translate english sahne9_donus_b92663a1:

    # si "Taşlar ayak sesimi geri veriyor. Bir adım benden, bir adım..."
    si "The stones give my footsteps back. One step from me, one step..."

# game/scene9_donus.rpy:34
translate english sahne9_donus_801dd3b6:

    # si "Hayır. Sadece benden. Sadece benden olsun."
    si "No. Only from me. Let it be only from me."

# game/scene9_donus.rpy:36
translate english sahne9_donus_131b533b:

    # s "İki gündür uyumadım. Belki daha fazla."
    s "I haven't slept in two days. Maybe more."

# game/scene9_donus.rpy:38
translate english sahne9_donus_96311aab:

    # s "Adımlarımı sayıyordum az önce. Sayılar birbirine karıştı."
    s "I was counting my steps just now. The numbers ran together."

# game/scene9_donus.rpy:40
translate english sahne9_donus_6c7ca14b:

    # s "Saymayı bırakıyorum. Saymak artık iyi bir fikir değil."
    s "I stop counting. Counting is no longer a good idea."

# game/scene9_donus.rpy:44
translate english sahne9_donus_c2c8629b:

    # s "Bunu hangi anlamda dedin, sormayacağım."
    s "I'm not going to ask which way you meant that."

# game/scene9_donus.rpy:46
translate english sahne9_donus_9f11860c:

    # si "Lambayı kaldırıyorum."
    si "I raise the lamp."

# game/scene9_donus.rpy:50
translate english sahne9_donus_79459176:

    # si "Alev... alev değil artık. Bir közün son nefesi. Camın dibinde büzülmüş."
    si "The flame... isn't a flame anymore. The last breath of an ember. Huddled at the bottom of the glass."

# game/scene9_donus.rpy:52
translate english sahne9_donus_ebdf35fa:

    # s "Bir alev boyu, demişti. Ben alevi kapıya harcadım."
    s "One flame's length, it said. And I spent the flame on a door."

# game/scene9_donus.rpy:54
translate english sahne9_donus_a22ca852:

    # s "Süreyi kendi elimle kestim."
    s "I cut my own time short with my own hand."

# game/scene9_donus.rpy:58
translate english sahne9_donus_7b1c16e4:

    # si "Alev kısık. Her adımda bir kum tanesi düşüyor sanki."
    si "The flame is low. As if a grain of sand falls with every step."

# game/scene9_donus.rpy:60
translate english sahne9_donus_0555d89a:

    # s "Bir alev boyu. Sürem bu kadar."
    s "One flame's length. That's all the time I have."

# game/scene9_donus.rpy:75
translate english sahne9_ucurum_3f749a7b:

    # si "Uçurum. Daralan çıkıntı. İlk geçişimde burada zar zor tutunmuştum."
    si "The chasm. The narrowing ledge. I barely held on here the first time."

# game/scene9_donus.rpy:77
translate english sahne9_ucurum_1f2138d9:

    # si "Adım atıyorum ve—"
    si "I take a step and—"

# game/scene9_donus.rpy:79
translate english sahne9_ucurum_89d327ed:

    # si "Taş, ayağımın altında kendini düzeltiyor."
    si "The stone straightens itself under my foot."

# game/scene9_donus.rpy:81
translate english sahne9_ucurum_e1554201:

    # s "..."
    s "..."

# game/scene9_donus.rpy:83
translate english sahne9_ucurum_2f757c73:

    # s "Kule düşmeme izin vermiyor."
    s "The tower won't let me fall."

# game/scene9_donus.rpy:87
translate english sahne9_ucurum_d0afece0:

    # s "Tadımı biliyor. Tattığını kırmaz."
    s "It knows my taste. It doesn't break what it's tasted."

# game/scene9_donus.rpy:89
translate english sahne9_ucurum_a1328a28:

    # s "Beni yukarıda istiyor. Bütün."
    s "It wants me at the top. Whole."

# game/scene9_donus.rpy:93
translate english sahne9_ucurum_da1f1885:

    # si "Karşıya geçiyorum. Kolayca. Hiç zorlanmadan."
    si "I cross. Easily. Without any effort at all."

# game/scene9_donus.rpy:95
translate english sahne9_ucurum_52297a1e:

    # s "Dünyada güvenebileceğim tek zemin, beni yemek isteyen kulenin zemini."
    s "The only ground in the world I can trust is the floor of a tower that wants to eat me."

# game/scene9_donus.rpy:97
translate english sahne9_ucurum_e75afc3f:

    # s "Güzel."
    s "Wonderful."

# game/scene9_donus.rpy:112
translate english sahne9_kapi_348f4955:

    # si "Kulenin ağzı. Demir kuşaklı kapı."
    si "The tower's mouth. The iron-banded door."

# game/scene9_donus.rpy:116
translate english sahne9_kapi_e6de2ce9:

    # si "Kapının önünde bir adam yatıyordu. Rahat bir yüzle."
    si "A man was lying in front of the door. With a peaceful face."

# game/scene9_donus.rpy:118
translate english sahne9_kapi_253f87bd:

    # si "Artık yok. Taş, verilenleri tutmuyor."
    si "He's gone now. The stone doesn't keep what is given."

# game/scene9_donus.rpy:120
translate english sahne9_kapi_6dd287f7:

    # s "İyi uykular, her kimsen."
    s "Sleep well, whoever you were."

# game/scene9_donus.rpy:124
translate english sahne9_kapi_6a347fb0:

    # si "Ve karanlıkta, ışığımın tam sınırının dışında... bir hışırtı."
    si "And in the dark, just outside the edge of my light... a rustle."

# game/scene9_donus.rpy:126
translate english sahne9_kapi_c49fe244:

    # yr "Hâlâ o yüz."
    yr "Still that face."

# game/scene9_donus.rpy:128
translate english sahne9_kapi_13a9ec58:

    # yr "Şimdilik."
    yr "For now."

# game/scene9_donus.rpy:130
translate english sahne9_kapi_1d3295c7:

    # si "Ses uzaklaşıyor. Peşimden gelmiyor."
    si "The voice recedes. It doesn't follow."

# game/scene9_donus.rpy:132
translate english sahne9_kapi_b2b1c047:

    # s "Beklemekte iyiyim, demişti."
    s "I am good at waiting, he said."

# game/scene9_donus.rpy:134
translate english sahne9_kapi_e75d1720:

    # s "Bekliyor."
    s "He's waiting."

# game/scene9_donus.rpy:138
translate english sahne9_kapi_42444d71:

    # si "Kapıyı itiyorum. Direnmiyor. Hiç direnmedi zaten."
    si "I push the door. It doesn't resist. It never did."

# game/scene9_donus.rpy:151
translate english sahne9_salon_af83f5d6:

    # si "Salon. Binlerce oyuk. Binlerce sönmüş lamba."
    si "The hall. Thousands of alcoves. Thousands of dead lamps."

# game/scene9_donus.rpy:155
translate english sahne9_salon_fe3ec627:

    # si "Sönmüş'ün lambası hâlâ alt sırada. Camı çatlak. Taşı artık soğuk."
    si "The Snuffed's lamp is still in the bottom row. Its glass cracked. Its stone cold now."

# game/scene9_donus.rpy:157
translate english sahne9_salon_6ba0d28c:

    # s "Soğumuş. Ben yukarıda pazarlık ederken."
    s "It went cold. While I was up there bargaining."

# game/scene9_donus.rpy:159
translate english sahne9_salon_0fd754d7:

    # si "Kendi oyuğumun önünden geçerken duruyorum."
    si "Passing my own alcove, I stop."

# game/scene9_donus.rpy:161
translate english sahne9_salon_5e0f3870:

    # si "Halka parlatılmış. Ve halkanın yanına..."
    si "The ring has been polished. And next to the ring..."

# game/scene9_donus.rpy:163
translate english sahne9_salon_778eb4a5:

    # si "...küçük bir levha eklenmiş. Boş bir levha."
    si "...a small plaque has been added. A blank plaque."

# game/scene9_donus.rpy:165
translate english sahne9_salon_da2850e1:

    # s "Kazınacak bir isim için."
    s "For a name to be carved."

# game/scene9_donus.rpy:167
translate english sahne9_salon_2759af9c:

    # s "Benimki için."
    s "For mine."

# game/scene9_donus.rpy:173
translate english sahne9_salon_914a63da:

    # s "İkisini de yapabiliyorum artık. Bakıyorum ve yürüyorum."
    s "I can do both now. I look, and I walk."

# game/scene9_donus.rpy:188
translate english sahne9_merdiven_b168ff03:

    # si "Merdiven. Yukarı."
    si "The stairs. Up."

# game/scene9_donus.rpy:192
translate english sahne9_merdiven_3b9619f2:

    # si "Ve yaklaştıkça, kafamın içindeki o raflar... yine kaşınıyor. Altın parmağın izi, sahibini duyuyor."
    si "And as I climb, those shelves inside my head... itch again. The golden finger's residue senses its owner."

# game/scene9_donus.rpy:194
translate english sahne9_merdiven_0e1ad4fc:

    # si "Bacaklarım tırmanıyor. Ben konuşuyorum. Uyanık kalmanın tek yolu bu."
    si "My legs climb. I talk. It's the only way to stay awake."

# game/scene9_donus.rpy:196
translate english sahne9_merdiven_04c955c7:

    # s "Bir soru soracağım, içimdeki. Doğru cevap istemiyorum. Cevap istiyorum."
    s "I'm going to ask a question, you inside. I don't want the right answer. I want an answer."

# game/scene9_donus.rpy:198
translate english sahne9_merdiven_f83cb213:

    # s "Koro, fısıltılar isim getirir dedi. Getirmeyen yoktur dedi. Sen getirmemişsin."
    s "The Choir said whispers bring names. Said there are none that don't. You never brought one."

# game/scene9_donus.rpy:202
translate english sahne9_merdiven_6e07b92b:

    # s "Ve ben kaç kez öldüm — sen kaç kez 'Kalk. Yeniden.' dedin?"
    s "And how many times have I died — how many times did you say 'Get up. Again.'?"

# game/scene9_donus.rpy:206
translate english sahne9_merdiven_b2b9daac:

    # s "Uçurumun kenarındaki çentikleri gördüm. Biri burayı defalarca geçmiş."
    s "I saw the notches at the chasm's edge. Someone crossed there many, many times."

# game/scene9_donus.rpy:208
translate english sahne9_merdiven_ee3fb7d6:

    # s "Neden hiç teslim etmedin beni?"
    s "Why did you never hand me over?"

# game/scene9_donus.rpy:215
translate english sahne9_merdiven_7375b361:

    # s "Bilmiyorsun."
    s "You don't know."

# game/scene9_donus.rpy:217
translate english sahne9_merdiven_a965aa0e:

    # s "İlk dürüst cevabın bu olabilir. Korkutucu olan da bu."
    s "That may be your first honest answer. Which is what makes it frightening."

# game/scene9_donus.rpy:221
translate english sahne9_merdiven_c48c7f00:

    # s "Sustun. Yine."
    s "You went silent. Again."

# game/scene9_donus.rpy:223
translate english sahne9_merdiven_347d4efa:

    # s "Ama bu sefer suskunluğun titriyor."
    s "But this time your silence is trembling."

# game/scene9_donus.rpy:229
translate english sahne9_merdiven_17950087:

    # s "İstemedin."
    s "You didn't want to."

# game/scene9_donus.rpy:231
translate english sahne9_merdiven_cdf84b0c:

    # s "Neden?"
    s "Why?"

# game/scene9_donus.rpy:235
translate english sahne9_merdiven_a7729458:

    # s "İstememeyi biliyorsun. Nedenini bilmiyorsun."
    s "You know the not-wanting. You don't know the reason."

# game/scene9_donus.rpy:237
translate english sahne9_merdiven_a29326d2:

    # s "Bende de öyle şeyler var. Aynanın ardına kendi elimle koyduklarım."
    s "I have things like that too. Things I put behind the mirror with my own hands."

# game/scene9_donus.rpy:247
translate english sahne9_sezgi_5e8d3f7b:

    # s "Bir şey daha var."
    s "There's one more thing."

# game/scene9_donus.rpy:249
translate english sahne9_sezgi_b47c5952:

    # s "Alevdeki kadın. Beni adımla çağıran."
    s "The woman in the flame. The one who called me by my name."

# game/scene9_donus.rpy:251
translate english sahne9_sezgi_a0c096ad:

    # s "Sesini tanıyordum, içimdeki. Nereden tanıyordum, biliyor musun?"
    s "I knew her voice, you inside. Do you know where I knew it from?"

# game/scene9_donus.rpy:255
translate english sahne9_sezgi_efbb902b:

    # s "Senden."
    s "From you."

# game/scene9_donus.rpy:257
translate english sahne9_sezgi_f4d62dc5:

    # s "Alçalt, yumuşat, kır — aynı ses."
    s "Lower it, soften it, break it — the same voice."

# game/scene9_donus.rpy:264
translate english sahne9_sezgi_a50b9336:

    # s "İlk kez benden bir şey istedin ve sesin titredi."
    s "For the first time you asked something of me, and your voice shook."

# game/scene9_donus.rpy:266
translate english sahne9_sezgi_1de0709c:

    # s "Kimsin sen?"
    s "Who are you?"

# game/scene9_donus.rpy:270
translate english sahne9_sezgi_daea12c4:

    # s "Belki sen de bilmiyorsun."
    s "Maybe you don't know either."

# game/scene9_donus.rpy:272
translate english sahne9_sezgi_738ff1c8:

    # s "İkimiz de aynayız, içimdeki. Arkasına bir şey saklanmış iki ayna."
    s "We're both mirrors, you inside. Two mirrors with something hidden behind them."

# game/scene9_donus.rpy:277
translate english sahne9_sezgi_3298c242:

    # s "'Kalk. Yeniden.' İlk kelimelerin buydu."
    s "'Get up. Again.' Those were your first words."

# game/scene9_donus.rpy:279
translate english sahne9_sezgi_424a1df6:

    # s "'Yeniden'i hep duydum. Hiç sormadım."
    s "I always heard the 'again.' I never asked about it."

# game/scene9_donus.rpy:281
translate english sahne9_sezgi_1a12fe81:

    # s "Koro seni azarladı — oyalanan fısıltı. Lanetler oyalanmaz, içimdeki."
    s "The Choir scolded you — the whisper that stalls. Curses don't stall, you inside."

# game/scene9_donus.rpy:283
translate english sahne9_sezgi_69ec6fa2:

    # s "Lanetler biriktirmez. Lanetler beklemez."
    s "Curses don't hoard. Curses don't wait."

# game/scene9_donus.rpy:285
translate english sahne9_sezgi_e8cd3c4b:

    # s "Bir şey seni burada tutuyor. Benimle."
    s "Something keeps you here. With me."

# game/scene9_donus.rpy:287
translate english sahne9_sezgi_2c7933cb:

    # s "Ve ben soruyorum: lanetler sever mi?"
    s "And I'm asking: do curses love?"

# game/scene9_donus.rpy:292
translate english sahne9_sezgi_7375b361:

    # s "Bilmiyorsun."
    s "You don't know."

# game/scene9_donus.rpy:294
translate english sahne9_sezgi_96a0a963:

    # s "Sevdiğini hatırlamayan biri gibi bilmiyorsun ama."
    s "But you don't know it the way someone doesn't remember whom they loved."

# game/scene9_donus.rpy:300
translate english sahne9_sezgi_4cfb5937:

    # s "Adımı 'Duymasın' diye saklamışım. Kendimden bile."
    s "I hid my name 'so it wouldn't hear.' Even from myself."

# game/scene9_donus.rpy:302
translate english sahne9_sezgi_fdad0759:

    # s "Kimden sakladığımı artık biliyorum."
    s "I know now who I was hiding it from."

# game/scene9_donus.rpy:304
translate english sahne9_sezgi_bf1273d7:

    # s "Neden sakladığımı... çünkü duyduğunda bir şey olacaktı. Sende. Belki ikimizde."
    s "Why I hid it... because something would happen if you heard it. To you. Maybe to us both."

# game/scene9_donus.rpy:308
translate english sahne9_sezgi_0f443445:

    # s "Adımı aynanın ardına ben koymuşum. Bir sebepten."
    s "I put my name behind the mirror myself. For a reason."

# game/scene9_donus.rpy:310
translate english sahne9_sezgi_547c8cca:

    # s "Sebep sendin galiba, içimdeki. Ya da sana benzeyen bir şeydi."
    s "I think the reason was you, you inside. Or something that looked like you."

# game/scene9_donus.rpy:315
translate english sahne9_sezgi_fa563ae1:

    # si "Merdiven bitiyor. Yukarıda altın ışık."
    si "The stairs end. Above, the golden light."

# game/scene9_donus.rpy:317
translate english sahne9_sezgi_9c30349d:

    # s "Cevapların kalanı orada."
    s "The rest of the answers are up there."

# game/scene9_donus.rpy:319
translate english sahne9_sezgi_f49bc26d:

    # s "Ya da sonu."
    s "Or the end of them."

# game/scene9_donus.rpy:332
translate english sahne9_tepe_949f7a99:

    # ko "Geldin."
    ko "You came."

# game/scene9_donus.rpy:334
translate english sahne9_tepe_5abd0f13:

    # ko "Alev boyu doldu, küçük fısıltı."
    ko "The flame's length is spent, little whisper."

# game/scene9_donus.rpy:336
translate english sahne9_tepe_fc39a2d3:

    # si "Lambama bakıyorum. Alev bir tırnak boyu. Belki daha az."
    si "I look at my lamp. The flame is a fingernail tall. Maybe less."

# game/scene9_donus.rpy:338
translate english sahne9_tepe_0ebfd3b1:

    # ko "Adı mı getirdin..."
    ko "Have you brought the name..."

# game/scene9_donus.rpy:340
translate english sahne9_tepe_7345a9af:

    # ko "...kendini mi?"
    ko "...or yourself?"

# game/scene9_donus.rpy:342
translate english sahne9_tepe_c64723e0:

    # si "Kazandaki altın alev yükseliyor. İsimlerden örülü duvar."
    si "The golden flame rises in the cauldron. A wall woven of names."

# game/scene9_donus.rpy:346
translate english sahne9_tepe_7ff43739:

    # si "Ve içinde bir yerde, bir iplik ötekilerden farklı parlıyor. Beni çağıran."
    si "And somewhere inside, one thread shines differently from the rest. The one that calls me."

# game/scene9_donus.rpy:348
translate english sahne9_tepe_e1554201:

    # s "..."
    s "..."

# game/scene9_donus.rpy:350
translate english sahne9_tepe_15c9d1f4:

    # s "İçimdeki. Karar senin. Hep senindi zaten."
    s "You inside. The decision is yours. It always was."

# game/scene9_donus.rpy:352
translate english sahne9_tepe_d6362929:

    # si "Ve tam o anda uğultu... yumuşuyor."
    si "And at that exact moment, the hum... softens."

# game/scene9_donus.rpy:354
translate english sahne9_tepe_2ce7dae2:

    # si "Bir beşik sallanıyor sanki. Bilerek yapıyorlar."
    si "As if a cradle were rocking. They're doing it on purpose."

# game/scene9_donus.rpy:356
translate english sahne9_tepe_47148ac9:

    # s "Hayır. Hayır, şimdi değil—"
    s "No. No, not now—"

# game/scene9_donus.rpy:358
translate english sahne9_tepe_ed68d0d6:

    # si "İki gün. İki gün uyumadım. Tırmandım, kandım, kan verdim."
    si "Two days. Two days without sleep. I climbed, I bled, I was bled."

# game/scene9_donus.rpy:360
translate english sahne9_tepe_41cd701c:

    # si "Vücut faturayı kesiyor. Tam burada. Tam onların önünde."
    si "The body presents its bill. Right here. Right in front of them."

# game/scene9_donus.rpy:369
translate english sahne9_esik_29f163ea:

    # si "Dizlerim çözülüyor. Taşa iniyorum."
    si "My knees give. I sink to the stone."

# game/scene9_donus.rpy:371
translate english sahne9_esik_cf95a4c6:

    # si "Gözkapaklarım..."
    si "My eyelids..."

# game/scene9_donus.rpy:373
translate english sahne9_esik_408deaa6:

    # si "Ve ellerim. Ellerim kendiliğinden açılıyor. Uykuda herkes verir."
    si "And my hands. My hands open on their own. In sleep, everyone gives."

# game/scene9_donus.rpy:375
translate english sahne9_esik_ed0eb7b2:

    # ko "İşte."
    ko "There."

# game/scene9_donus.rpy:377
translate english sahne9_esik_4384c07f:

    # ko "Herkes uyur, küçük fısıltı. Sen sadece bekleyecektin."
    ko "Everyone sleeps, little whisper. All you had to do was wait."

# game/scene9_donus.rpy:379
translate english sahne9_esik_a47cf5e7:

    # si "Altın ışık avucuma eğiliyor. Adım göğsümde, gevşeyen parmaklarımın ardında."
    si "The golden light leans toward my palm. My name is in my chest, behind my loosening fingers."

# game/scene9_donus.rpy:381
translate english sahne9_esik_f8031c42:

    # si "Kafamın içinde son bir yer uyanık: sen."
    si "One last place inside my head is awake: you."

translate english strings:

    # game/scene9_donus.rpy:214
    old "«Bilmiyorum.»"
    new "«I don't know.»"

    # game/scene9_donus.rpy:228
    old "«İstemedim.»"
    new "«I didn't want to.»"

    # game/scene9_donus.rpy:388
    old "«UYAN. Adı ver. Bitsin.»"
    new "«WAKE UP. Give the name. End it.»"

    # game/scene9_donus.rpy:392
    old "«UYAN. Adı değil — beni alacak.»"
    new "«WAKE UP. Not the name — it will take me.»"

# game/scene9_donus.rpy:356
translate english sahne9_tepe_479c1abb:

    # s "Ve korkmuyorum. Garip, değil mi?"
    s "And I'm not afraid. Strange, isn't it?"

# game/scene9_donus.rpy:358
translate english sahne9_tepe_cc39af59:

    # si "Kendi sesimi duyuyorum. Teslimiyet yok içinde. Rahatlık var. Birine yaslanan bir adamın sesi."
    si "I hear my own voice. There's no surrender in it. There's ease. The voice of a man leaning on someone."

# game/scene9_donus.rpy:362
translate english sahne9_tepe_e477dd78:

    # s "Kim olduğunu hiç bilmedim. Ne istediğini de."
    s "I never knew who you were. Or what you wanted."

# game/scene9_donus.rpy:364
translate english sahne9_tepe_d1a48c4f:

    # s "Ama başka kimsem yok. Gerisini de sen bitir."
    s "But I have no one else. So finish the rest yourself."

# game/scene9_donus.rpy:366
translate english sahne9_tepe_1f6c5a17:

    # si "Kendi sesimi duyuyorum. Güven yok içinde. Sadece yorgunluk. Kumar oynayan bir adamın sesi."
    si "I hear my own voice. There's no trust in it. Only exhaustion. The voice of a man placing a bet."

# game/scene9_donus.rpy:370
translate english sahne9_tepe_fc542cdb:

    # s "Sana güveniyor muyum? Bilmiyorum."
    s "Do I trust you? I don't know."

# game/scene9_donus.rpy:372
translate english sahne9_tepe_7024be28:

    # s "Ama seni tanıyorum artık. Belki o daha önemlidir."
    s "But I know you now. Maybe that matters more."

# TODO: Translation updated at 2026-09-02 19:25

# game/scene9_donus.rpy:350
translate english sahne9_sezgi_3298c242_1:

    # s "'Kalk. Yeniden.' İlk kelimelerin buydu."
    s "'Get up. Again.' Those were your first words."

# game/scene9_donus.rpy:352
translate english sahne9_sezgi_424a1df6_1:

    # s "'Yeniden'i hep duydum. Hiç sormadım."
    s "I always heard the 'again.' I never asked about it."

# game/scene9_donus.rpy:354
translate english sahne9_sezgi_9804b9a5:

    # si "Şimdi soracak gibi oluyorum. Soru ağzımda duruyor."
    si "Now I almost ask. The question sits in my mouth."

# game/scene9_donus.rpy:356
translate english sahne9_sezgi_c570eb9e:

    # si "Şekli var. İçi yok."
    si "It has a shape. It has no inside."

# game/scene9_donus.rpy:358
translate english sahne9_sezgi_e1554201:

    # s "..."
    s "..."

# game/scene9_donus.rpy:360
translate english sahne9_sezgi_62d54d31:

    # s "Gitti."
    s "Gone."

# game/scene9_donus.rpy:364
translate english sahne9_sezgi_6f1e2d51:

    # si "Sen de tutmadın onu. Ya da tuttun ve bırakmadın."
    si "You didn't catch it either. Or you caught it and didn't let go."

# game/scene9_donus.rpy:366
translate english sahne9_sezgi_0a3fd552:

    # s "İkimiz de yorgunuz, içimdeki."
    s "We're both tired, you inside me."

# game/scene9_donus.rpy:368
translate english sahne9_sezgi_77547352:

    # s "Yukarı çıkalım. Orada belki hatırlarım."
    s "Let's go up. Maybe I'll remember there."

# game/scene9_donus.rpy:370
translate english sahne9_sezgi_d2124e9a:

    # si "Hatırlamayacağımı ikimiz de biliyoruz."
    si "We both know I won't."

