# English translation — finaller.rpy (The Four Endings)

# game/finaller.rpy:52
translate english final_teslim_2773e581:

    # si "Kafamın içinde sesin: keskin, kesin."
    si "Your voice inside my head: sharp, certain."

# game/finaller.rpy:54
translate english final_teslim_ea09c079:

    # si "Ve avucum kapanıyor. Uyanıyorum — dizlerimin üstünde, onların önünde."
    si "And my palm closes. I wake — on my knees, in front of them."

# game/finaller.rpy:56
translate english final_teslim_e0ad1bce:

    # s "...ver, diyorsun."
    s "...give it, you say."

# game/finaller.rpy:58
translate english final_teslim_d97b2d27:

    # s "Adımı. Bunca yolu geri almak için indiğim, uyumadan taşıdığım adımı."
    s "My name. The name I went all that way down to reclaim, the name I carried without sleeping."

# game/finaller.rpy:62
translate english final_teslim_443ef025:

    # s "Bitsin."
    s "End it."

# game/finaller.rpy:64
translate english final_teslim_953ab8f1:

    # s "Evet. Bitsin istiyorum. Ne kadar zamandır ayaktayım ben?"
    s "Yes. I want it to end. How long have I been on my feet?"

# game/finaller.rpy:66
translate english final_teslim_3b1ec2a8:

    # s "Çentikler kadar."
    s "As long as the notches."

# game/finaller.rpy:68
translate english final_teslim_1a98f87a:

    # ko "Beden uyanık."
    ko "The body is awake."

# game/finaller.rpy:70
translate english final_teslim_4258c6ac:

    # ko "Ve fısıltı kararını vermiş. Duyduk."
    ko "And the whisper has decided. We heard."

# game/finaller.rpy:72
translate english final_teslim_04d6ef2d:

    # si "Ayağa kalkıyorum. Bacaklarım son bir kez taşıyor beni."
    si "I stand. My legs carry me one last time."

# game/finaller.rpy:74
translate english final_teslim_8150a750:

    # si "Kazana yaklaşıyorum. Altın alev yükseliyor. Sıcak değil."
    si "I approach the cauldron. The golden flame rises. It isn't warm."

# game/finaller.rpy:76
translate english final_teslim_a2d839f8:

    # si "Aç."
    si "It's hungry."

# game/finaller.rpy:80
translate english final_teslim_65c8c125:

    # s "Sönmüş ne demişti? {i}Bulduğunda ona söyleme.{/i}"
    s "What did the Snuffed say? {i}When you find it, don't tell it.{/i}"

# game/finaller.rpy:82
translate english final_teslim_9dee9753:

    # s "Sana söylemeyeceğim, içimdeki. Merak etme."
    s "I won't tell you, you inside. Don't worry."

# game/finaller.rpy:84
translate english final_teslim_fae375b1:

    # s "İsmin gittiği yerden fısıltılar bile alamaz."
    s "Not even whispers can take a name back from where this one is going."

# game/finaller.rpy:86
translate english final_teslim_b56bea3e:

    # s "Bir şartım var."
    s "I have one condition."

# game/finaller.rpy:88
translate english final_teslim_0677175d:

    # s "Söylediğimde kimse tekrarlamayacak."
    s "When I say it, no one repeats it."

# game/finaller.rpy:90
translate english final_teslim_04359d30:

    # ko "Kimse tekrarlayamaz, beden."
    ko "No one can repeat it, body."

# game/finaller.rpy:92
translate english final_teslim_85e347ed:

    # ko "İsimler bizde yankılanmaz. Yanar."
    ko "Names do not echo in us. They burn."

# game/finaller.rpy:99
translate english final_teslim_verilis_f0b77fbf:

    # si "Dudaklarım aralanıyor."
    si "My lips part."

# game/finaller.rpy:101
translate english final_teslim_verilis_971f67be:

    # si "Bir isim söylüyorum."
    si "I say a name."

# game/finaller.rpy:103
translate english final_teslim_verilis_2c015487:

    # si "Duyuyorum — ve duyduğum yerden alev alıyor. Bana kalan: kül tadı."
    si "I hear it — and it catches fire in the very place I hear it. What's left to me: the taste of ash."

# game/finaller.rpy:107
translate english final_teslim_verilis_4df27c2c:

    # si "İsim ağzımdan altın bir iplik gibi çekiliyor. Uzun. Sandığımdan uzun."
    si "The name is drawn from my mouth like a golden thread. Long. Longer than I thought."

# game/finaller.rpy:109
translate english final_teslim_verilis_342cfb17:

    # si "Sanki yıllardır bir ucundan tutuyormuşum da şimdi bırakıyormuşum."
    si "As if I had been holding one end of it for years, and only now let go."

# game/finaller.rpy:111
translate english final_teslim_verilis_a8bd8244:

    # ko "Ahh."
    ko "Ahh."

# game/finaller.rpy:113
translate english final_teslim_verilis_8f369972:

    # ko "Eski bir isim. Derin kök. İyi yanacak."
    ko "An old name. Deep roots. It will burn well."

# game/finaller.rpy:117
translate english final_teslim_verilis_cd2d84ac:

    # si "Ve iplik, alevin içinde kıvrılıp {b}o{/b} ipliğin yanına yerleşiyor."
    si "And the thread curls inside the flame and settles beside {b}that{/b} thread."

# game/finaller.rpy:119
translate english final_teslim_verilis_a841e3c0:

    # si "Beni çağıran sesin yanına."
    si "Beside the voice that called me."

# game/finaller.rpy:121
translate english final_teslim_verilis_311f8a73:

    # si "Ve lambam..."
    si "And my lamp..."

# game/finaller.rpy:123
translate english final_teslim_verilis_21d10999:

    # si "Alev, camın içinde son bir kez doğruluyor. Veda eder gibi."
    si "The flame rises inside the glass one last time. As if saying farewell."

# game/finaller.rpy:125
translate english final_teslim_verilis_e6ccff0e:

    # si "Ve sönüyor."
    si "And goes out."

# game/finaller.rpy:127
translate english final_teslim_verilis_0fea8e3f:

    # s "Alev boyu doldu."
    s "The flame's length is spent."

# game/finaller.rpy:140
translate english final_teslim_sonus_ff36e4e1:

    # s "Tuhaf."
    s "Strange."

# game/finaller.rpy:142
translate english final_teslim_sonus_27e9a31a:

    # s "Hafifim. İlk kez hafifim."
    s "I'm light. For the first time, I'm light."

# game/finaller.rpy:144
translate english final_teslim_sonus_61a87814:

    # s "İçimdeki. Bir şey soracaktım sana."
    s "You inside. I was going to ask you something."

# game/finaller.rpy:146
translate english final_teslim_sonus_03e1a29b:

    # s "İçimde..."
    s "Inside me..."

# game/finaller.rpy:148
translate english final_teslim_sonus_243a87ff:

    # s "...ne vardı içimde?"
    s "...what was inside me?"

# game/finaller.rpy:152
translate english final_teslim_sonus_6abaa3dc:

    # s "Kimse var mı?"
    s "Is anyone there?"

# game/finaller.rpy:154
translate english final_teslim_sonus_3b8e5133:

    # si "..."
    si "..."

# game/finaller.rpy:156
translate english final_teslim_sonus_64f56b78:

    # s "Bekleyeceğim."
    s "I will wait."

# game/finaller.rpy:158
translate english final_teslim_sonus_03198846:

    # s "Neyi beklediğimi unutana kadar."
    s "Until I forget what I was waiting for."

# game/finaller.rpy:160
translate english final_teslim_sonus_e1554201:

    # s "..."
    s "..."

# game/finaller.rpy:162
translate english final_teslim_sonus_6d3d24a8:

    # s "Unuttum bile."
    s "I've already forgotten."

# game/finaller.rpy:168
translate english final_teslim_sonus_135821b2:

    # f "Boş."
    f "Empty."

# game/finaller.rpy:170
translate english final_teslim_sonus_5bbf0b13:

    # f "Kaç kez taşıdım bu bedeni. İlk kez bu kadar boş."
    f "How many times I've carried this body. It's never been this empty."

# game/finaller.rpy:172
translate english final_teslim_sonus_862c2824:

    # ko "Küçük fısıltı."
    ko "Little whisper."

# game/finaller.rpy:174
translate english final_teslim_sonus_4bffe206:

    # ko "Borç ödendi. Yer açıldı."
    ko "The debt is paid. A place has opened."

# game/finaller.rpy:176
translate english final_teslim_sonus_0a54ce59:

    # ko "Gel."
    ko "Come."

# game/finaller.rpy:178
translate english final_teslim_sonus_e57902c9:

    # f "Alevde bir iplik parlıyor. Ötekilerden farklı."
    f "One thread shines in the flame. Different from the others."

# game/finaller.rpy:180
translate english final_teslim_sonus_302f7df5:

    # f "Hep farklıydı. Bunu kimseye söylemedim. Kendime bile."
    f "It was always different. I never told anyone. Not even myself."

# game/finaller.rpy:182
translate english final_teslim_sonus_4b633eff:

    # f "Onu tanıyorum."
    f "I know it."

# game/finaller.rpy:184
translate english final_teslim_sonus_8ec0bf97:

    # f "Tanımıyorum. Ama tanıyorum."
    f "I don't. But I do."

# game/finaller.rpy:186
translate english final_teslim_sonus_ba91a583:

    # f "Geliyorum."
    f "I'm coming."

# game/finaller.rpy:205
translate english final_teslim_epilog_6da7caa0:

    # si "...soğuk."
    si "...cold."

# game/finaller.rpy:207
translate english final_teslim_epilog_dc5db9d5:

    # si "Taş. Sırtımın altında taş var."
    si "Stone. There is stone under my back."

# game/finaller.rpy:209
translate english final_teslim_epilog_8bb72fe9:

    # si "Ne kadar zamandır buradayım?"
    si "How long have I been here?"

# game/finaller.rpy:211
translate english final_teslim_epilog_e1554201:

    # s "..."
    s "..."

# game/finaller.rpy:213
translate english final_teslim_epilog_d374aff4:

    # s "Kalkmalıyım."
    s "I should get up."

# game/finaller.rpy:217
translate english final_teslim_epilog_745a9910:

    # f "Kalk."
    f "Get up."

# game/finaller.rpy:223
translate english final_teslim_epilog_1d85849b:

    # centered "{color=#cc2222}— TESLİM —{/color}\n \n{color=#b8ac93}isim yandı. sıra bekleyen isimler var.{/color}"
    centered "{color=#cc2222}— SURRENDER —{/color}\n \n{color=#b8ac93}the name has burned. other names are waiting their turn.{/color}"

# game/finaller.rpy:239
translate english final_armagan_657a6bb3:

    # si "Ellerim açılıyor. Altın ışık avucuma eğiliyor."
    si "My hands open. The golden light leans toward my palm."

# game/finaller.rpy:241
translate english final_armagan_02f8a9f6:

    # si "Ve sesin gelmiyor."
    si "And your voice doesn't come."

# game/finaller.rpy:243
translate english final_armagan_3f8cca06:

    # si "Uykunun dibinde bile bunu duyuyorum: gelmeyen sesini."
    si "Even at the bottom of sleep I hear it: your voice, not coming."

# game/finaller.rpy:245
translate english final_armagan_8a83a5ee:

    # si "Ve avucum... kendi kendine kapanıyor."
    si "And my palm... closes on its own."

# game/finaller.rpy:247
translate english final_armagan_bdc52b59:

    # si "Uyanıyorum. Kimse uyandırmadı."
    si "I wake. No one woke me."

# game/finaller.rpy:249
translate english final_armagan_ab7c10da:

    # si "Uyandım."
    si "I woke myself."

# game/finaller.rpy:251
translate english final_armagan_761649be:

    # s "Gördüm, içimdeki."
    s "I saw, you inside."

# game/finaller.rpy:253
translate english final_armagan_d38ec16e:

    # s "Elim açıktı. Sen sustun."
    s "My hand was open. You stayed silent."

# game/finaller.rpy:255
translate english final_armagan_50b703c3:

    # s "Ne kadar aç olduğunu duyabiliyordum. Sustuğunu da."
    s "I could hear how hungry you were. And I could hear you staying silent."

# game/finaller.rpy:259
translate english final_armagan_34189bfa:

    # s "Aç olan herkes hırsız değildir."
    s "Not everyone who hungers is a thief."

# game/finaller.rpy:261
translate english final_armagan_0b139f26:

    # s "Ama kimse açlığıyla baş başa da bırakılmamalı."
    s "But no one should be left alone with their hunger, either."

# game/finaller.rpy:263
translate english final_armagan_fd27ed8c:

    # ko "Beden uyanık. Yine."
    ko "The body is awake. Again."

# game/finaller.rpy:265
translate english final_armagan_12da8464:

    # ko "Süre doldu, küçük fısıltı. Adı. Ya da onu."
    ko "The time is up, little whisper. The name. Or him."

# game/finaller.rpy:267
translate english final_armagan_01d74c6c:

    # s "İkisini de alamayacaksın."
    s "You will get neither."

# game/finaller.rpy:269
translate english final_armagan_368fab82:

    # s "Üçüncü yol yok demişlerdi. Doğruydu."
    s "They said there was no third way. That was true."

# game/finaller.rpy:271
translate english final_armagan_3cceff15:

    # s "Ama dördüncü var."
    s "But there is a fourth."

# game/finaller.rpy:281
translate english final_armagan_gercek_8330f5ea:

    # s "Alevdeki ses. Beni adımla çağıran."
    s "The voice in the flame. The one who called me by my name."

# game/finaller.rpy:283
translate english final_armagan_gercek_747f33de:

    # s "Merdivende demiştim: sesini senden tanıyordum."
    s "On the stairs I said: I knew her voice from you."

# game/finaller.rpy:285
translate english final_armagan_gercek_8d4e84b1:

    # s "Yanlış söylemişim."
    s "I had it wrong."

# game/finaller.rpy:287
translate english final_armagan_gercek_7d4a92a7:

    # s "Senin sesini {b}ondan{/b} tanıyordum."
    s "I knew your voice {b}from her{/b}."

# game/finaller.rpy:294
translate english final_armagan_gercek_61a13557:

    # s "Evet."
    s "Yes."

# game/finaller.rpy:296
translate english final_armagan_gercek_b40d2065:

    # s "Bilmiyordun, değil mi? Şimdi bile tam bilmiyorsun."
    s "You didn't know, did you? Even now you don't fully know."

# game/finaller.rpy:298
translate english final_armagan_gercek_976a19d5:

    # s "Önemli değil."
    s "It doesn't matter."

# game/finaller.rpy:300
translate english final_armagan_gercek_4fd15346:

    # s "Bundan sonra ikimiz için de ben hatırlarım."
    s "From now on, I will remember for the both of us."

# game/finaller.rpy:305
translate english final_armagan_gercek_baae4940:

    # s "Kim olduğunu bilmiyorum, içimdeki. Sen de bilmiyorsun."
    s "I don't know who you are, you inside. Neither do you."

# game/finaller.rpy:307
translate english final_armagan_gercek_04ac8987:

    # s "Ama ne olmadığını biliyorum."
    s "But I know what you are not."

# game/finaller.rpy:309
translate english final_armagan_gercek_5080c9ad:

    # s "Lanet değilsin. Lanetler beklemez. Lanetler oyalanmaz."
    s "You're not a curse. Curses don't wait. Curses don't stall."

# game/finaller.rpy:311
translate english final_armagan_gercek_0ab6950f:

    # s "Ve lanetler, sahibi uyurken susup dayanmaz."
    s "And curses don't hold their tongue and endure while their keeper sleeps."

# game/finaller.rpy:322
translate english final_armagan_hediye_ffe2c178:

    # s "Sönmüş demişti: adını ona söyleme."
    s "The Snuffed said: don't tell it your name."

# game/finaller.rpy:324
translate english final_armagan_hediye_70a5cd8a:

    # s "Çalınandan korkuyordu. Haklıydı da."
    s "He feared what gets stolen. And he was right to."

# game/finaller.rpy:326
translate english final_armagan_hediye_fe149294:

    # s "Ama bir şeyi bilmiyordu."
    s "But there was one thing he didn't know."

# game/finaller.rpy:328
translate english final_armagan_hediye_4bc1ed2a:

    # s "Çalınamayan şey, verilendir."
    s "The thing that cannot be stolen is the thing that is given."

# game/finaller.rpy:330
translate english final_armagan_hediye_d36333ca:

    # si "Ayağa kalkıyorum. Bacaklarım titriyor; duruyorum yine de."
    si "I stand. My legs are shaking; I stand anyway."

# game/finaller.rpy:332
translate english final_armagan_hediye_9da1895f:

    # s "İçimdeki. Sana bir armağanım var."
    s "You inside. I have a gift for you."

# game/finaller.rpy:334
translate english final_armagan_hediye_008d7c1c:

    # s "Reddetme. Zaten geri alınamaz."
    s "Don't refuse it. It can't be taken back anyway."

# game/finaller.rpy:336
translate english final_armagan_hediye_5129d5c5:

    # si "Ve adımı söylüyorum."
    si "And I say my name."

# game/finaller.rpy:338
translate english final_armagan_hediye_70227f81:

    # si "Yüksek sesle. İsteyerek. İlk kez."
    si "Out loud. Willingly. For the first time."

# game/finaller.rpy:342
translate english final_armagan_hediye_fcf958ae:

    # si "İsim havada altınlaşmıyor. Yanmıyor. Kaymıyor."
    si "The name doesn't turn gold in the air. It doesn't burn. It doesn't slip."

# game/finaller.rpy:344
translate english final_armagan_hediye_3dfec90f:

    # si "Sadece yer değiştiriyor."
    si "It simply changes places."

# game/finaller.rpy:346
translate english final_armagan_hediye_21152ec5:

    # si "Ya da çoğalıyor. Bilmiyorum. İkimizde birden."
    si "Or multiplies. I don't know. It's in both of us at once."

# game/finaller.rpy:350
translate english final_armagan_hediye_bc6c6d29:

    # s "Söyle bir şey."
    s "Say something."

# game/finaller.rpy:354
translate english final_armagan_hediye_73e15598:

    # s "Biliyorum."
    s "I know."

# game/finaller.rpy:356
translate english final_armagan_hediye_5df553c8:

    # s "Armağan dediğim bu."
    s "That's what makes it a gift."

# game/finaller.rpy:358
translate english final_armagan_hediye_92ebe826:

    # ko "..."
    ko "..."

# game/finaller.rpy:360
translate english final_armagan_hediye_0e546c6b:

    # ko "Verilmiş ad."
    ko "A given name."

# game/finaller.rpy:362
translate english final_armagan_hediye_e2425c88:

    # ko "Verilmiş ad {b}yanmaz{/b}, küçük fısıltı. Küle bile yaramaz."
    ko "A given name {b}does not burn{/b}, little whisper. It isn't even good for ash."

# game/finaller.rpy:364
translate english final_armagan_hediye_7cfca0cb:

    # ko "Ne getirdiniz bize? Hiç. Ne bırakacaksınız? Hiç."
    ko "What have you brought us? Nothing. What will you leave us? Nothing."

# game/finaller.rpy:366
translate english final_armagan_hediye_0b4c6a39:

    # ko "Adlı şeyler. Gidin."
    ko "Named things. Go."

# game/finaller.rpy:368
translate english final_armagan_hediye_3d961585:

    # ko "İkiniz. Tek."
    ko "The two of you. One."

# game/finaller.rpy:370
translate english final_armagan_hediye_27baa280:

    # s "\"İkiniz. Tek.\""
    s "\"The two of you. One.\""

# game/finaller.rpy:372
translate english final_armagan_hediye_ff6ec157:

    # s "Koro'dan duyduğum ilk doğru cümle."
    s "The first true sentence I've heard from the Choir."

# game/finaller.rpy:381
translate english final_armagan_cikis_d1da5a5e:

    # si "İniyoruz. Basamaklar düz. İlk kez düz."
    si "We descend. The steps are level. For the first time, level."

# game/finaller.rpy:385
translate english final_armagan_cikis_0e643e5d:

    # s "Tadımı biliyorsun, kule. Afiyet olsun."
    s "You know my taste, tower. Enjoy it."

# game/finaller.rpy:387
translate english final_armagan_cikis_064d0f59:

    # s "Gerisi benim."
    s "The rest of me is mine."

# game/finaller.rpy:389
translate english final_armagan_cikis_525e7ff9:

    # si "Kule bırakıyor. Tattığını unutmaz — ama verileni tutamaz."
    si "The tower lets go. It doesn't forget what it's tasted — but it cannot hold what is given."

# game/finaller.rpy:393
translate english final_armagan_cikis_13406734:

    # si "Kapı. Kulenin ağzı."
    si "The door. The tower's mouth."

# game/finaller.rpy:395
translate english final_armagan_cikis_9fe3c3ac:

    # si "İtiyorum."
    si "I push."

# game/finaller.rpy:397
translate english final_armagan_cikis_5175b3de:

    # si "Ve öteki taraf..."
    si "And the other side..."

# game/finaller.rpy:404
translate english final_armagan_cikis_2193eb35:

    # si "...oda değil."
    si "...is not the room."

# game/finaller.rpy:414
translate english final_armagan_epilog_af6f4b17:

    # si "Hava. Gerçek hava. Yüzüme çarpıyor."
    si "Air. Real air. It strikes my face."

# game/finaller.rpy:416
translate english final_armagan_epilog_302849d9:

    # si "Ve yağmur."
    si "And rain."

# game/finaller.rpy:420
translate english final_armagan_epilog_b0368a0c:

    # s "Yağmur..."
    s "Rain..."

# game/finaller.rpy:422
translate english final_armagan_epilog_ea9fcc5d:

    # s "Gözlerim doluyor ve nedenini bilmiyorum."
    s "My eyes are filling, and I don't know why."

# game/finaller.rpy:424
translate english final_armagan_epilog_c5c5fadc:

    # s "Yağmurla ilgili bir şey vardı. Aynaya verdim."
    s "There was something about rain. I gave it to the mirror."

# game/finaller.rpy:428
translate english final_armagan_epilog_e1554201:

    # s "..."
    s "..."

# game/finaller.rpy:430
translate english final_armagan_epilog_6a46369a:

    # s "Anlat o zaman."
    s "Then tell it to me."

# game/finaller.rpy:432
translate english final_armagan_epilog_e0a290e9:

    # s "Yol uzun."
    s "The road is long."

# game/finaller.rpy:436
translate english final_armagan_epilog_a3401791:

    # s "Yağmur. Çamur kokusu."
    s "Rain. The smell of mud."

# game/finaller.rpy:438
translate english final_armagan_epilog_0bfa0c3f:

    # s "Biri bana bağırıyordu yağmurun altında. Bir isim. Benim ismim."
    s "Someone was shouting at me in the rain. A name. My name."

# game/finaller.rpy:440
translate english final_armagan_epilog_b0c8057a:

    # s "Kimin bağırdığını artık biliyorum galiba."
    s "I think I know now who was shouting."

# game/finaller.rpy:442
translate english final_armagan_epilog_f24c7f8b:

    # si "Lambayı hâlâ taşıyorum. Alev bir kıvılcım. Kapının dışında... gereksiz."
    si "I'm still carrying the lamp. The flame is a spark. Outside the door... unnecessary."

# game/finaller.rpy:446
translate english final_armagan_epilog_6c28eeec:

    # si "Parmaklarım sapı bırakmak istemiyor."
    si "My fingers don't want to release the handle."

# game/finaller.rpy:448
translate english final_armagan_epilog_cc958ad4:

    # si "Teker teker açıyorum onları. Teker teker."
    si "I open them one by one. One by one."

# game/finaller.rpy:450
translate english final_armagan_epilog_f8e0b078:

    # si "Lambayı eşiğe bırakıyorum. İçeriye. Ait olduğu yere."
    si "I set the lamp down on the threshold. Facing inward. Where it belongs."

# game/finaller.rpy:452
translate english final_armagan_epilog_1c93c5e0:

    # s "Işığın değdiği kadardı dünya."
    s "The world was as far as the light could reach."

# game/finaller.rpy:454
translate english final_armagan_epilog_da2d15b2:

    # s "Artık değil."
    s "Not anymore."

# game/finaller.rpy:456
translate english final_armagan_epilog_58d7f55c:

    # s "Ee, içimdeki. Adlı şey."
    s "Well then, you inside. Named thing."

# game/finaller.rpy:458
translate english final_armagan_epilog_57b0600c:

    # s "Nereye?"
    s "Where to?"

# game/finaller.rpy:463
translate english final_armagan_epilog_92185b49:

    # s "Yürüyelim."
    s "Let's walk."

# game/finaller.rpy:472
translate english final_armagan_epilog_144e937c:

    # centered "{color=#f5e9d0}— ARMAĞAN —{/color}\n \n{color=#b8ac93}çalınamayan şey, verilendir.{/color}"
    centered "{color=#f5e9d0}— THE GIFT —{/color}\n \n{color=#b8ac93}what cannot be stolen is what is given.{/color}"

# game/finaller.rpy:487
translate english final_sonus_6ef836af:

    # si "Kafamın içinde sesin — ve avucum kapanıyor. Uyanıyorum."
    si "Your voice inside my head — and my palm closes. I wake."

# game/finaller.rpy:489
translate english final_sonus_df3ff054:

    # s "...ne dedin?"
    s "...what did you say?"

# game/finaller.rpy:493
translate english final_sonus_d911b0d6:

    # s "Hayır."
    s "No."

# game/finaller.rpy:495
translate english final_sonus_d679d07b:

    # s "Hayır, dur. Bunu konuşmadık."
    s "No, wait. We never talked about this."

# game/finaller.rpy:497
translate english final_sonus_3b54a62f:

    # ko "Duyduk."
    ko "We heard."

# game/finaller.rpy:499
translate english final_sonus_6f7a1978:

    # ko "Kalıntı kendini teklif ediyor. Nadirdir."
    ko "The remnant offers itself. That is rare."

# game/finaller.rpy:501
translate english final_sonus_7861cf04:

    # ko "Kabul."
    ko "Accepted."

# game/finaller.rpy:503
translate english final_sonus_5c0abd7c:

    # s "Bekle—"
    s "Wait—"

# game/finaller.rpy:505
translate english final_sonus_b78255d8:

    # si "Altın alev kazanın kenarından taşıyor. Bir kol gibi uzuyor. Acele etmeden."
    si "The golden flame spills over the cauldron's rim. It stretches out like an arm. Unhurried."

# game/finaller.rpy:507
translate english final_sonus_f68fb516:

    # s "İçimdeki. Neden?"
    s "You inside. Why?"

# game/finaller.rpy:511
translate english final_sonus_7375b361:

    # s "Bilmiyorsun."
    s "You don't know."

# game/finaller.rpy:513
translate english final_sonus_92dc1ca8:

    # s "Ya da biliyorsun ve söylemiyorsun. İkisini hiç ayıramadım zaten."
    s "Or you know and you're not saying. I never could tell those two apart."

# game/finaller.rpy:515
translate english final_sonus_6b60caf3:

    # s "Merdivende sormuştum: lanetler sever mi?"
    s "I asked on the stairs: do curses love?"

# game/finaller.rpy:517
translate english final_sonus_98bcb0df:

    # s "Cevabın bu mu?"
    s "Is this your answer?"

# game/finaller.rpy:521
translate english final_sonus_f2e6463e:

    # s "Söyle bir şey. Son kez."
    s "Say something. One last time."

# game/finaller.rpy:523
translate english final_sonus_6349b610:

    # s "Ne olursa."
    s "Anything."

# game/finaller.rpy:528
translate english final_sonus_e1554201:

    # s "..."
    s "..."

# game/finaller.rpy:530
translate english final_sonus_bcb89ee0:

    # s "Uyumam."
    s "I won't."

# game/finaller.rpy:537
translate english final_sonus_cekilis_b3e1c6ae:

    # si "Ve altın kol alnıma değiyor."
    si "And the golden arm touches my forehead."

# game/finaller.rpy:539
translate english final_sonus_cekilis_b339170e:

    # si "Soğuk değil. Acı değil. Daha kötüsü: nazik."
    si "Not cold. Not painful. Worse: gentle."

# game/finaller.rpy:543
translate english final_sonus_cekilis_83142e50:

    # si "Bir şey çekiliyor. Kafamın içindeki o yerden — adını hiç bilmediğim, hep dolu olan o yerden."
    si "Something is being drawn out. From that place inside my head — the place I never had a name for, that was always full."

# game/finaller.rpy:545
translate english final_sonus_cekilis_eae85a28:

    # si "Çekiliyor. Çekiliyor."
    si "Drawn out. Drawn out."

# game/finaller.rpy:547
translate english final_sonus_cekilis_04cbf73f:

    # si "Ve çıkıyor."
    si "And it comes free."

# game/finaller.rpy:549
translate english final_sonus_cekilis_ae6a3ecd:

    # si "İnce, kırmızı bir iplik. Işığa doğru."
    si "A thin, red thread. Rising toward the light."

# game/finaller.rpy:553
translate english final_sonus_cekilis_7c242a15:

    # si "Ve alevin içinde, beni çağıran o iplik... parlıyor. Uzanıyor."
    si "And inside the flame, that thread that called me... shines. Reaches."

# game/finaller.rpy:555
translate english final_sonus_cekilis_0749a842:

    # si "İkisi birbirine sarılıyor."
    si "The two of them wrap around each other."

# game/finaller.rpy:559
translate english final_sonus_cekilis_139c4c2f:

    # si "Alevin içinde bir iplik ona doğru eğiliyor. Sanki bekliyormuş."
    si "Inside the flame, a thread leans toward it. As if it had been waiting."

# game/finaller.rpy:561
translate english final_sonus_cekilis_3e3a44fd:

    # si "Ve yanarken—"
    si "And as it burns—"

# game/finaller.rpy:565
translate english final_sonus_cekilis_2bc18fe8:

    # s "Bir yüz."
    s "A face."

# game/finaller.rpy:567
translate english final_sonus_cekilis_c9af0a71:

    # s "Bir saniye. Yağmur altında bir yüz. Bana dönüyor. Gülüyor."
    s "One second. A face in the rain. Turning to me. Smiling."

# game/finaller.rpy:569
translate english final_sonus_cekilis_dad49cd0:

    # s "Adımı söylüyor—"
    s "She's saying my name—"

# game/finaller.rpy:571
translate english final_sonus_cekilis_cbb6dbc4:

    # si "Ve bitiyor."
    si "And it ends."

# game/finaller.rpy:573
translate english final_sonus_cekilis_e1554201:

    # s "..."
    s "..."

# game/finaller.rpy:575
translate english final_sonus_cekilis_e4c7d5ab:

    # s "Kimdi o?"
    s "Who was she?"

# game/finaller.rpy:577
translate english final_sonus_cekilis_d15f2e4c:

    # s "{b}Kimdi o?{/b}"
    s "{b}Who was she?{/b}"

# game/finaller.rpy:579
translate english final_sonus_cekilis_e4e15ec3:

    # ko "Ödendi."
    ko "It is paid."

# game/finaller.rpy:581
translate english final_sonus_cekilis_136913d7:

    # ko "Git, beden. Borcun yok artık."
    ko "Go, body. You owe nothing now."

# game/finaller.rpy:588
translate english final_sonus_sessizlik_070f028b:

    # s "İçimdeki?"
    s "You inside?"

# game/finaller.rpy:590
translate english final_sonus_sessizlik_e1554201:

    # s "..."
    s "..."

# game/finaller.rpy:592
translate english final_sonus_sessizlik_3a9c7725:

    # s "İçimde kimse yok."
    s "There is no one inside me."

# game/finaller.rpy:594
translate english final_sonus_sessizlik_4b2b5fac:

    # si "Kafamın içi geniş. Uçsuz. Boş bir salon gibi."
    si "The inside of my head is wide. Endless. Like an empty hall."

# game/finaller.rpy:596
translate english final_sonus_sessizlik_ebe13440:

    # si "İlk kez yalnızca kendi düşüncelerim var."
    si "For the first time, there are only my own thoughts."

# game/finaller.rpy:598
translate english final_sonus_sessizlik_fd0f08a4:

    # si "Ve ne kadar az varlarmış."
    si "And how few of them there turn out to be."

# game/finaller.rpy:600
translate english final_sonus_sessizlik_91ee2edb:

    # si "Lambamı alıyorum. Alev duruyor hâlâ. Küçücük."
    si "I pick up my lamp. The flame is still there. Tiny."

# game/finaller.rpy:602
translate english final_sonus_sessizlik_a3df8bd0:

    # s "Alevler kulede daha yavaş ölür."
    s "Flames die slower in the tower."

# game/finaller.rpy:604
translate english final_sonus_sessizlik_ac117473:

    # s "Ama ölür."
    s "But they die."

# game/finaller.rpy:606
translate english final_sonus_sessizlik_052ded18:

    # si "Cümlenin iki yarısını da ben söylüyorum artık."
    si "I say both halves of the sentence now."

# game/finaller.rpy:608
translate english final_sonus_sessizlik_75c4a666:

    # si "Tamamlayan yok."
    si "There is no one to complete it."

# game/finaller.rpy:626
translate english final_sonus_epilog_35126801:

    # si "Kuleden indim. Kaç basamak? Saymayı bırakalı çok oldu."
    si "I came down from the tower. How many steps? I stopped counting long ago."

# game/finaller.rpy:628
translate english final_sonus_epilog_79a0d3bc:

    # si "Zaman geçiyor. Ya da geçmiyor. Ölçecek bir şeyim kalmadı."
    si "Time passes. Or it doesn't. I have nothing left to measure it with."

# game/finaller.rpy:630
translate english final_sonus_epilog_4b21b7c9:

    # si "Bir yüzü hatırlamaya çalışıyorum. Bir saniyeliğine benimdi."
    si "I try to remember a face. For one second, it was mine."

# game/finaller.rpy:632
translate english final_sonus_epilog_343a9324:

    # si "Her gün — eğer bunlar günse — biraz daha siliniyor."
    si "Every day — if these are days — it fades a little more."

# game/finaller.rpy:634
translate english final_sonus_epilog_40ddbafa:

    # si "Ve bir gün, koridorun ucunda..."
    si "And one day, at the end of the corridor..."

# game/finaller.rpy:636
translate english final_sonus_epilog_2475622b:

    # si "...bir ışık."
    si "...a light."

# game/finaller.rpy:638
translate english final_sonus_epilog_10be5421:

    # si "Kırmızı bir ışık. Benimki gibi. Kısık, sıcak, yaklaşan."
    si "A red light. Like mine. Low, warm, approaching."

# game/finaller.rpy:640
translate english final_sonus_epilog_6d003a3e:

    # si "Ayağa kalkıyorum. Kelimeleri hatırlamaya çalışıyorum. Konuşmayalı çok oldu."
    si "I stand up. I try to remember words. It's been a long time since I spoke."

# game/finaller.rpy:642
translate english final_sonus_epilog_52024f78:

    # sk "Dur."
    sk "Stop."

# game/finaller.rpy:644
translate english final_sonus_epilog_c5e6d572:

    # sk "Işığını görüyorum. Gür alev."
    sk "I see your light. A full flame."

# game/finaller.rpy:646
translate english final_sonus_epilog_9955c202:

    # sk "Benim de alevim gürdü. Bir zamanlar."
    sk "My flame was full too. Once."

# game/finaller.rpy:648
translate english final_sonus_epilog_c25a8db9:

    # sk "Yaklaşma. Sadece dinle. Bir şey söyleyeceğim, aklında tut."
    sk "Don't come closer. Just listen. I'm going to say something, and you will keep it."

# game/finaller.rpy:650
translate english final_sonus_epilog_7720934d:

    # sk "Adını bulursan..."
    sk "If you find your name..."

# game/finaller.rpy:652
translate english final_sonus_epilog_5463f609:

    # sk "...{b}ona{/b} söyleme."
    sk "...don't tell {b}it{/b}."

# game/finaller.rpy:658
translate english final_sonus_epilog_1d880d4f:

    # centered "{color=#cc2222}— SÖNÜŞ —{/color}\n \n{color=#b8ac93}fısıltısız kafa geniştir. ve bomboş.{/color}"
    centered "{color=#cc2222}— THE FADING —{/color}\n \n{color=#b8ac93}a head without a whisper is wide. and hollow.{/color}"

# game/finaller.rpy:671
translate english final_gasp_79565599:

    # si "Sesin gelmiyor."
    si "Your voice doesn't come."

# game/finaller.rpy:673
translate english final_gasp_d912fde0:

    # si "Uykunun eşiğinde son bir düşünce: neden sesin gelmiyor?"
    si "One last thought on the threshold of sleep: why doesn't your voice come?"

# game/finaller.rpy:675
translate english final_gasp_9da8b31d:

    # si "Ve düşüyorum. Sıcak, altın, dipsiz bir kuyuya."
    si "And I fall. Into a warm, golden, bottomless well."

# game/finaller.rpy:677
translate english final_gasp_e4fb4f7c:

    # si "Rüyada biri bana sesleniyor. Tanıdık bir ses. Hep tanıdıktı."
    si "In the dream, someone calls to me. A familiar voice. It was always familiar."

# game/finaller.rpy:679
translate english final_gasp_d70ec4bb:

    # si "Adımla sesleniyor."
    si "It calls me by my name."

# game/finaller.rpy:681
translate english final_gasp_84b788cb:

    # si "Ve tek bir kelime söylüyor:"
    si "And it says a single word:"

# game/finaller.rpy:686
translate english final_gasp_117d0fac:

    # si "Uykuda herkes verir."
    si "In sleep, everyone gives."

# game/finaller.rpy:688
translate english final_gasp_2108d4cb:

    # si "Veriyorum."
    si "I give."

# game/finaller.rpy:704
translate english final_gasp_takas_c8c3f58b:

    # gasp_kalinti "..."
    gasp_kalinti "..."

# game/finaller.rpy:706
translate english final_gasp_takas_6402e5fa:

    # gasp_kalinti "Sesim."
    gasp_kalinti "My voice."

# game/finaller.rpy:708
translate english final_gasp_takas_d1a52848:

    # gasp_kalinti "Bir sesim var."
    gasp_kalinti "I have a voice."

# game/finaller.rpy:710
translate english final_gasp_takas_5afdcfdb:

    # gasp_sovalye "Ne oldu."
    gasp_sovalye "What happened."

# game/finaller.rpy:712
translate english final_gasp_takas_b277eb4b:

    # gasp_sovalye "Ne yaptın. {b}NE YAPTIN—{/b}"
    gasp_sovalye "What did you do. {b}WHAT DID YOU DO—{/b}"

# game/finaller.rpy:714
translate english final_gasp_takas_094b3bb9:

    # gasp_kalinti "Sus."
    gasp_kalinti "Quiet."

# game/finaller.rpy:716
translate english final_gasp_takas_4db21d2b:

    # gasp_kalinti "İçeride bağırma. Duvarları yeni."
    gasp_kalinti "Don't shout in there. The walls are new to me."

# game/finaller.rpy:718
translate english final_gasp_takas_92ebe826:

    # ko "..."
    ko "..."

# game/finaller.rpy:720
translate english final_gasp_takas_eb92fda1:

    # ko "Küçük fısıltı. Küçük hırsız."
    ko "Little whisper. Little thief."

# game/finaller.rpy:722
translate english final_gasp_takas_d539af92:

    # ko "Ne adı aldık ne kendini. Ama bin yılda bir izlenecek bir şey izledik."
    ko "We got neither the name nor you. But we watched something seen once in a thousand years."

# game/finaller.rpy:724
translate english final_gasp_takas_4a2111d7:

    # ko "Adlı şey. Git."
    ko "Named thing. Go."

# game/finaller.rpy:726
translate english final_gasp_takas_55b30bb7:

    # ko "Artık bizden değilsin. Ve bizden olmayanı kule beslemez."
    ko "You are no longer ours. And the tower does not feed what is not ours."

# game/finaller.rpy:728
translate english final_gasp_takas_cdf181a4:

    # ko "Kapı aşağıda. Son kez açık."
    ko "The door is below. Open for the last time."

# game/finaller.rpy:730
translate english final_gasp_takas_688b788a:

    # gasp_kalinti "Gidiyorum."
    gasp_kalinti "I'm leaving."

# game/finaller.rpy:732
translate english final_gasp_takas_711549f3:

    # gasp_sovalye "\"Gidiyorum\" mu?"
    gasp_sovalye "\"I\"?"

# game/finaller.rpy:734
translate english final_gasp_takas_e09ab280:

    # gasp_sovalye "Ya ben?"
    gasp_sovalye "What about me?"

# game/finaller.rpy:736
translate english final_gasp_takas_c4ed81a2:

    # gasp_kalinti "Sen fısıltısın."
    gasp_kalinti "You are a whisper."

# game/finaller.rpy:738
translate english final_gasp_takas_f8166c48:

    # gasp_kalinti "Fısıltılar taşınır."
    gasp_kalinti "Whispers get carried."

# game/finaller.rpy:753
translate english final_gasp_epilog_a8e162a4:

    # si "Oda. Taş duvarlar. Bir yatak. Bir ayna."
    si "The room. Stone walls. A bed. A mirror."

# game/finaller.rpy:758
translate english final_gasp_epilog_fa22b873:

    # gasp_kalinti "Aynadaki adam bana bakıyor."
    gasp_kalinti "The man in the mirror is looking at me."

# game/finaller.rpy:760
translate english final_gasp_epilog_0bc3d233:

    # gasp_kalinti "Yorgun. Sakallı. Şakağında kurumuş kan."
    gasp_kalinti "Tired. Bearded. Dried blood on his temple."

# game/finaller.rpy:762
translate english final_gasp_epilog_c405e595:

    # gasp_kalinti "Demek buyum."
    gasp_kalinti "So this is me."

# game/finaller.rpy:764
translate english final_gasp_epilog_2206b87d:

    # gasp_sovalye "Hayır."
    gasp_sovalye "No."

# game/finaller.rpy:766
translate english final_gasp_epilog_b8801021:

    # gasp_sovalye "O benim. O yüz benim. Aynadan çekil—"
    gasp_sovalye "That's me. That face is mine. Step away from the mirror—"

# game/finaller.rpy:768
translate english final_gasp_epilog_490040e4:

    # gasp_kalinti "...bir şey dedin mi?"
    gasp_kalinti "...did you say something?"

# game/finaller.rpy:770
translate english final_gasp_epilog_cee1a749:

    # gasp_sovalye "Duyuyorsun. {b}Duyuyorsun{/b}, biliyorum—"
    gasp_sovalye "You hear me. {b}You hear me{/b}, I know you do—"

# game/finaller.rpy:772
translate english final_gasp_epilog_fdee3bc2:

    # gasp_kalinti "Kafamın içinde bir cereyan var sanki. Eski evlerdeki gibi."
    gasp_kalinti "There's a draft inside my head, I think. Like in old houses."

# game/finaller.rpy:774
translate english final_gasp_epilog_d163caab:

    # gasp_kalinti "Alışırım."
    gasp_kalinti "I'll get used to it."

# game/finaller.rpy:776
translate english final_gasp_epilog_0f03c9a0:

    # gasp_sovalye "..."
    gasp_sovalye "..."

# game/finaller.rpy:778
translate english final_gasp_epilog_8e6ab37d:

    # gasp_kalinti "Bir adım var."
    gasp_kalinti "I have a name."

# game/finaller.rpy:780
translate english final_gasp_epilog_44912e48:

    # gasp_kalinti "Söylüyorum ve ağzıma oturuyor. Tam oturuyor."
    gasp_kalinti "I say it and it settles in my mouth. A perfect fit."

# game/finaller.rpy:782
translate english final_gasp_epilog_247f8c88:

    # si "İsim söyleniyor. Ve odada bir yankı: söylendiği anda... hafifçe... kayıyor."
