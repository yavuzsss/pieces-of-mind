# English translation — scene5_kule.rpy (Scene 5: The Tower / Hall of Lamps)

# game/scene5_kule.rpy:21
translate english sahne5_kule_f6c39ace:

    # si "Merdiven geniş. Basamakların ortaları çukur — aşınmış."
    si "The stairway is wide. The steps are hollowed in the middle — worn down."

# game/scene5_kule.rpy:23
translate english sahne5_kule_4947a7c9:

    # s "Kaç ayak eskitir taşı bu kadar?"
    s "How many feet does it take to wear stone down like this?"

# game/scene5_kule.rpy:25
translate english sahne5_kule_b7cdf65d:

    # si "Çıkıyorum. Yüz basamak. İki yüz. Saymayı bırakıyorum."
    si "I climb. A hundred steps. Two hundred. I stop counting."

# game/scene5_kule.rpy:27
translate english sahne5_kule_1c9062c2:

    # si "Lambanın ışığı hep önümde. Hep üç basamak yukarıda."
    si "The lamp's light stays ahead of me. Always three steps up."

# game/scene5_kule.rpy:29
translate english sahne5_kule_def6de11:

    # s "Sanki yol gösteriyor. Sanki acele ediyor."
    s "As if it's leading the way. As if it's in a hurry."

# game/scene5_kule.rpy:31
translate english sahne5_kule_00f3330f:

    # si "Ve aşağıda, derinlerde: bir basamak gıcırdıyor."
    si "And below, deep down: a step creaks."

# game/scene5_kule.rpy:33
translate english sahne5_kule_fb96bd0f:

    # s "Ben gıcırdatmadım."
    s "That wasn't me."

# game/scene5_kule.rpy:37
translate english sahne5_kule_da4262f8:

    # si "Elim kabzaya gidiyor. Pas, avucuma güven gibi oturuyor."
    si "My hand goes to the hilt. The rust settles into my palm like trust."

# game/scene5_kule.rpy:39
translate english sahne5_kule_64e114f5:

    # s "Gel o zaman. Işığın içine gel."
    s "Come on, then. Come into the light."

# game/scene5_kule.rpy:41
translate english sahne5_kule_200e2d5f:

    # si "Ses kesiliyor. Gelmiyor."
    si "The sound stops. It doesn't come."

# game/scene5_kule.rpy:43
translate english sahne5_kule_9fb6ca66:

    # s "İyi. Blöfümü görmedi."
    s "Good. It didn't call my bluff."

# game/scene5_kule.rpy:47
translate english sahne5_kule_c8e1f294:

    # si "Elim kalçamı yokluyor. Orada olmayan bir kılıcı arıyor."
    si "My hand pats my hip. Searching for a sword that isn't there."

# game/scene5_kule.rpy:49
translate english sahne5_kule_04dd09dc:

    # si "Adımlarımı hızlandırıyorum."
    si "I quicken my steps."

# game/scene5_kule.rpy:55
translate english sahne5_kule_d40f4888:

    # s "Ama beni tanıyor, öyle mi?"
    s "But it knows me, does it?"

# game/scene5_kule.rpy:70
translate english sahne5_salon_e1519472:

    # si "Merdiven bir salona açılıyor."
    si "The stairway opens into a hall."

# game/scene5_kule.rpy:72
translate english sahne5_salon_147b1a97:

    # si "Işığım duvarlara değiyor ve duvarlar... bitmiyor."
    si "My light touches the walls and the walls... don't end."

# game/scene5_kule.rpy:74
translate english sahne5_salon_8cc1fbb5:

    # si "Oyuklar. Duvarlar boydan boya oyuk dolu. Yüzlerce. Binlerce."
    si "Alcoves. The walls are full of them, top to bottom. Hundreds. Thousands."

# game/scene5_kule.rpy:76
translate english sahne5_salon_f4640478:

    # si "Her oyukta bir lamba."
    si "In every alcove, a lamp."

# game/scene5_kule.rpy:78
translate english sahne5_salon_c2ca4b09:

    # s "Hepsi sönmüş."
    s "All of them dead."

# game/scene5_kule.rpy:80
translate english sahne5_salon_7c4139f0:

    # si "Hayır — hepsi değil. Yukarıda, tek tük: kısık kırmızı alevler."
    si "No — not all. Up high, here and there: low red flames."

# game/scene5_kule.rpy:82
translate english sahne5_salon_6d67f047:

    # s "Benimki gibi."
    s "Like mine."

# game/scene5_kule.rpy:86
translate english sahne5_salon_28074762:

    # si "Lambam elimde titriyor. Sönmüşlere doğru eğilir gibi."
    si "My lamp trembles in my hand. Leaning toward the dead ones."

# game/scene5_kule.rpy:88
translate english sahne5_salon_1a59bfe7:

    # s "Sanki katılmak istiyor onlara."
    s "As if it wants to join them."

# game/scene5_kule.rpy:94
translate english sahne5_salon_93d2e469:

    # s "Bunlar... kim?"
    s "Who are... these?"

# game/scene5_kule.rpy:98
translate english sahne5_salon_390006b5:

    # s "Sönmüş de böyle diyordu kendine."
    s "That's what the Snuffed called himself too."

# game/scene5_kule.rpy:109
translate english sahne5_oyuk_797d00cf:

    # si "Sonra görüyorum. Görmemem imkânsız."
    si "Then I see it. It would be impossible not to."

# game/scene5_kule.rpy:111
translate english sahne5_oyuk_af0accf6:

    # si "Göz hizamda, boş bir oyuk. İçindeki halka... tanıdık."
    si "At eye level, an empty alcove. The ring inside it is... familiar."

# game/scene5_kule.rpy:113
translate english sahne5_oyuk_18a714c9:

    # si "Lambamı kaldırıyorum. Halkaya tutuyorum. Tam oturuyor."
    si "I lift my lamp. I hold it to the ring. A perfect fit."

# game/scene5_kule.rpy:115
translate english sahne5_oyuk_41333b15:

    # s "Bu oyuk benim."
    s "This alcove is mine."

# game/scene5_kule.rpy:117
translate english sahne5_oyuk_b98f4b45:

    # si "Lambayı geri alıyorum. Hemen. Halka bırakmak istemiyor gibi."
    si "I take the lamp back. Immediately. The ring seems reluctant to let go."

# game/scene5_kule.rpy:119
translate english sahne5_oyuk_a1a83d6b:

    # si "Oyuğun altında bir levha var. Üzerine bir isim kazınmıştı — bir zamanlar."
    si "Below the alcove there's a plaque. A name was carved on it — once."

# game/scene5_kule.rpy:121
translate english sahne5_oyuk_be75950a:

    # si "Şimdi üstü derin, kararlı çiziklerle örtülü. Okunmuyor."
    si "Now it's covered in deep, deliberate scratches. Unreadable."

# game/scene5_kule.rpy:123
translate english sahne5_oyuk_77b195ce:

    # s "Adım. Bu benim adımdı."
    s "My name. This was my name."

# game/scene5_kule.rpy:129
translate english sahne5_oyuk_626e65f1:

    # s "Okunmuyor. Biri kazımış."
    s "It's unreadable. Someone scratched it out."

# game/scene5_kule.rpy:159
translate english sahne5_kazi_9918c153:

    # si "Parmaklarım taşa gömülüyor. Tırnaklarım çiziklerin diplerini arıyor."
    si "My fingers dig into the stone. My nails search the bottoms of the scratches."

# game/scene5_kule.rpy:161
translate english sahne5_kazi_e15ad7af:

    # si "Taş sert. Tırnaklarım değil."
    si "The stone is hard. My nails are not."

# game/scene5_kule.rpy:163
translate english sahne5_kazi_c8fcc84c:

    # s "Bir şey yok. Altında da bir şey yok. Sadece—"
    s "There's nothing. Nothing underneath either. Just—"

# game/scene5_kule.rpy:165
translate english sahne5_kazi_47777a50:

    # si "Sıcak bir sızı. Tırnağımın biri kırılmış, etine kadar."
    si "A warm sting. One of my nails has broken, down to the quick."

# game/scene5_kule.rpy:167
translate english sahne5_kazi_364b64e6:

    # si "Ve bir damla kan, çiziklerin içine yürüyor. Taş, kanı içiyor."
    si "And a drop of blood runs into the scratches. The stone drinks it."

# game/scene5_kule.rpy:171
translate english sahne5_kazi_1257ad58:

    # si "Salondaki bütün lambalar — binlercesi — bir an için yanıyor."
    si "Every lamp in the hall — thousands of them — lights up for one moment."

# game/scene5_kule.rpy:173
translate english sahne5_kazi_e6825620:

    # si "Ve sönüyor. Hep birlikte. Bir iç çekiş gibi."
    si "And goes out. All together. Like a sigh."

# game/scene5_kule.rpy:175
translate english sahne5_kazi_6c7840ae:

    # s "Kule beni tattı."
    s "The tower tasted me."

# game/scene5_kule.rpy:177
translate english sahne5_kazi_a300738d:

    # s "Senin yüzünden. Sen kazımamı fısıldadın."
    s "Because of you. You whispered me into digging."

# game/scene5_kule.rpy:197
translate english sahne5_incele_c591e558:

    # s "Duydum."
    s "I heard you."

# game/scene5_kule.rpy:199
translate english sahne5_incele_b05eee38:

    # s "İncele, diyorsun. Parmaklarımla okuyayım."
    s "Examine it, you say. Read it with my fingers."

# game/scene5_kule.rpy:201
translate english sahne5_incele_ae48595f:

    # si "Ellerim iki yanımda asılı duruyor. Kalkmıyorlar."
    si "My hands hang at my sides. They don't rise."

# game/scene5_kule.rpy:203
translate english sahne5_incele_6a6c7091:

    # s "Ellerim sana güvenmiyor."
    s "My hands don't trust you."

# game/scene5_kule.rpy:205
translate english sahne5_incele_3a070820:

    # s "Ben de güvenmiyorum."
    s "Neither do I."

# game/scene5_kule.rpy:207
translate english sahne5_incele_198008ac:

    # si "Levhadan uzaklaşıyorum."
    si "I step away from the plaque."

# game/scene5_kule.rpy:216
translate english sahne5_incele_0e7cdc7a:

    # s "Sönmüşün sesi kulağımda: {i}Bulduğunda ona söyleme.{/i}"
    s "The Snuffed's voice is in my ear: {i}When you find it, don't tell it.{/i}"

# game/scene5_kule.rpy:218
translate english sahne5_incele_7455ca5b:

    # s "İçimden okuyacağım. Sadece içimden."
    s "I'll read it silently. Only silently."

# game/scene5_kule.rpy:220
translate english sahne5_incele_c0b1fe78:

    # si "Parmaklarımı levhaya koyuyorum. Çizikler soğuk."
    si "I place my fingers on the plaque. The scratches are cold."

# game/scene5_kule.rpy:239
translate english sahne5_incele_krit_basari_8b552f3d:

    # si "Parmaklarım çizikleri izliyor. Derinler. Aceleyle atılmamışlar."
    si "My fingers trace the scratches. They're deep. Not made in a hurry."

# game/scene5_kule.rpy:241
translate english sahne5_incele_krit_basari_d1b9a70f:

    # s "Tek tek. Bastıra bastıra. Sabırla kazınmış."
    s "One by one. Pressed hard. Carved with patience."

# game/scene5_kule.rpy:243
translate english sahne5_incele_krit_basari_19aeb8dc:

    # s "Ve bu izleri tanıyorum."
    s "And I know these marks."

# game/scene5_kule.rpy:245
translate english sahne5_incele_krit_basari_6bfa1746:

    # s "Bu el... {b}benim elim.{/b}"
    s "This hand... {b}is my hand.{/b}"

# game/scene5_kule.rpy:247
translate english sahne5_incele_krit_basari_673de14a:

    # s "Adımı kendimden ben sakladım."
    s "I hid my name from myself."

# game/scene5_kule.rpy:253
translate english sahne5_incele_krit_basari_b1cd5bc9:

    # s "\"Mışsın\"? Geçmiş zaman?"
    s "\"Were\"? Past tense?"

# game/scene5_kule.rpy:260
translate english sahne5_incele_krit_basari_2f85a2b2:

    # si "Levhanın bir köşesi çiziklerden kaçmış. Tek harf sağlam: E."
    si "One corner of the plaque escaped the scratches. A single letter intact: E."

# game/scene5_kule.rpy:270
translate english sahne5_incele_basari_135aac27:

    # si "Çizikler bıçakla atılmış. Düzenli. Bilinçli."
    si "The scratches were made with a knife. Orderly. Deliberate."

# game/scene5_kule.rpy:272
translate english sahne5_incele_basari_468969ec:

    # s "Kim kazıdıysa... yok etmek için değil. {i}Korumak{/i} için kazımış."
    s "Whoever carved them... wasn't destroying. They were {i}protecting{/i}."

# game/scene5_kule.rpy:274
translate english sahne5_incele_basari_35815e16:

    # si "Ve levhanın köşesinde, çiziklerin ıskaladığı tek harf: E."
    si "And in the corner of the plaque, one letter the scratches missed: E."

# game/scene5_kule.rpy:281
translate english sahne5_incele_basari_47d1e5e2:

    # s "Sakın."
    s "Don't."

# game/scene5_kule.rpy:285
translate english sahne5_incele_basari_ba375153:

    # s "Adımı ağzına alma."
    s "Don't put my name in your mouth."

# game/scene5_kule.rpy:297
translate english sahne5_incele_basarisiz_a63d8e6d:

    # si "Parmaklarım olukların içinde dolaşıyor. Bir şey aramıyorlar artık; kayboluyorlar."
    si "My fingers wander through the grooves. They're not searching anymore; they're getting lost."

# game/scene5_kule.rpy:299
translate english sahne5_incele_basarisiz_71cbb592:

    # s "Hiçbir şey. Sadece taş ve öfke."
    s "Nothing. Only stone and anger."

# game/scene5_kule.rpy:301
translate english sahne5_incele_basarisiz_cdb5368d:

    # si "Şakaklarım zonkluyor. Gözlerimin arkasında bir yerde."
    si "My temples throb. Somewhere behind my eyes."

# game/scene5_kule.rpy:305
translate english sahne5_incele_basarisiz_38819508:

    # s "Neden bu kadar acelecisin?"
    s "Why are you in such a hurry?"

# game/scene5_kule.rpy:319
translate english sahne5_incele_krit_fiyasko_e9f97394:

    # si "Levhanın keskin bir kıyısı parmağımı ısırıyor."
    si "A sharp edge of the plaque bites my finger."

# game/scene5_kule.rpy:321
translate english sahne5_incele_krit_fiyasko_fb731cf9:

    # s "Küçük bir kesik. Önemsiz."
    s "A small cut. Nothing."

# game/scene5_kule.rpy:323
translate english sahne5_incele_krit_fiyasko_bf63680f:

    # si "Bir damla kan, çiziklerin içine yürüyor. Taş, kanı içiyor."
    si "A drop of blood runs into the scratches. The stone drinks it."

# game/scene5_kule.rpy:327
translate english sahne5_incele_krit_fiyasko_1257ad58:

    # si "Salondaki bütün lambalar — binlercesi — bir an için yanıyor."
    si "Every lamp in the hall — thousands of them — lights up for one moment."

# game/scene5_kule.rpy:329
translate english sahne5_incele_krit_fiyasko_e6825620:

    # si "Ve sönüyor. Hep birlikte. Bir iç çekiş gibi."
    si "And goes out. All together. Like a sigh."

# game/scene5_kule.rpy:331
translate english sahne5_incele_krit_fiyasko_6c7840ae:

    # s "Kule beni tattı."
    s "The tower tasted me."

# game/scene5_kule.rpy:335
translate english sahne5_incele_krit_fiyasko_b63ed959:

    # s "Sesin... titriyor mu senin?"
    s "Is your voice... trembling?"

# game/scene5_kule.rpy:353
translate english sahne5_bakma_51a8abd1:

    # si "Dönüyorum. Uzaklaşıyorum."
    si "I turn. I walk away."

# game/scene5_kule.rpy:355
translate english sahne5_bakma_db7a7148:

    # s "Haklısın. Bilmek istemiyorum. Henüz."
    s "You're right. I don't want to know. Not yet."

# game/scene5_kule.rpy:357
translate english sahne5_bakma_67fe2878:

    # si "Üç adım. Dört."
    si "Three steps. Four."

# game/scene5_kule.rpy:359
translate english sahne5_bakma_097c4f89:

    # si "Ayaklarım duruyor."
    si "My feet stop."

# game/scene5_kule.rpy:361
translate english sahne5_bakma_2254fc23:

    # si "Ben durdurmadım."
    si "I didn't stop them."

# game/scene5_kule.rpy:363
translate english sahne5_bakma_371d3905:

    # s "Sen mi yaptın?"
    s "Did you do that?"

# game/scene5_kule.rpy:370
translate english sahne5_bakma_f70846b9:

    # s "O zaman kim?"
    s "Then who?"

# game/scene5_kule.rpy:372
translate english sahne5_bakma_3357ef19:

    # si "Cevap gelmiyor. Ayak bileklerimde görünmez eller."
    si "No answer comes. Invisible hands on my ankles."

# game/scene5_kule.rpy:376
translate english sahne5_bakma_98929b77:

    # s "Susman hoşuma gitmedi."
    s "I don't like your silence."

# game/scene5_kule.rpy:382
translate english sahne5_bakma_f95b06bb:

    # si "Bir nefes. İki. Ayaklarım yeniden benim."
    si "One breath. Two. My feet are mine again."

# game/scene5_kule.rpy:384
translate english sahne5_bakma_f0310535:

    # si "Yürüyorum."
    si "I walk."

# game/scene5_kule.rpy:386
translate english sahne5_bakma_b4ae23c1:

    # si "Ama kafamın içinde bir yerde, bir şey hâlâ levhaya dönük."
    si "But somewhere inside my head, something is still turned toward the plaque."

# game/scene5_kule.rpy:399
translate english sahne5_son_6a0808c6:

    # si "Salonun ortasından merdiven devam ediyor. Spiral. Yukarı."
    si "From the middle of the hall, the stairs continue. Spiraling. Up."

# game/scene5_kule.rpy:401
translate english sahne5_son_b69cdc78:

    # si "Ve çok yukarıda — bir ışık."
    si "And far above — a light."

# game/scene5_kule.rpy:403
translate english sahne5_son_6f1ebeb7:

    # s "Kırmızı değil."
    s "Not red."

# game/scene5_kule.rpy:405
translate english sahne5_son_6c497e4a:

    # s "Altın. Güneş gibi. Oyukların hiçbirine benzemiyor."
    s "Gold. Like the sun. Like none of the alcoves."

# game/scene5_kule.rpy:409
translate english sahne5_son_2826c35d:

    # s "İlk defa hevesli görünüyorsun."
    s "That's the first time you've sounded eager."

translate english strings:

    # game/scene5_kule.rpy:141
    old "«İncele. Çizikleri parmaklarınla oku.»"
    new "«Examine it. Read the scratches with your fingers.»"

    # game/scene5_kule.rpy:144
    old "«Bakma. Uzaklaş buradan.»"
    new "«Don't look. Walk away from here.»"

    # game/scene5_kule.rpy:147
    old "«Kazı. Çiziklerin altını tırnaklarınla aç.»"
    new "«Dig. Open the scratches with your nails.»"

    # game/scene5_kule.rpy:369
    old "«Hayır.»"
    new "«No.»"

    # game/scene5_kule.rpy:375
    old "«...»"
    new "«...»"
# TODO: Translation updated at 2026-09-03 13:52

# game/scene5_kule.rpy:124
translate english sahne5_oyuk_28704e9a:

    # si "Ve kazımanın altında bir kazıma daha var."
    si "And beneath the scoring there is more scoring."

# game/scene5_kule.rpy:126
translate english sahne5_oyuk_e65771d7:

    # si "Daha eski. Daha derin. Aynı el değil."
    si "Older. Deeper. Not the same hand."

# game/scene5_kule.rpy:128
translate english sahne5_oyuk_96e167b4:

    # s "Bu levha ilk kez kazınmıyor."
    s "This plate is not being scratched out for the first time."

# game/scene5_kule.rpy:130
translate english sahne5_oyuk_51ba1f42:

    # s "Kaç kere kazındı?"
    s "How many times has it been scratched out?"

