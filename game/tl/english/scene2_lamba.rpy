# English translation — scene2_lamba.rpy (Scene 2: The Lamp)

# game/scene2_lamba.rpy:16
translate english sahne2_lamba_f9cf5d61:

    # si "Lambaya doğru bir adım atıyorum."
    si "I take a step toward the lamp."

# game/scene2_lamba.rpy:18
translate english sahne2_lamba_efdca777:

    # si "Sonra bir adım daha. Attığımı fark etmeden."
    si "Then another. Without noticing I took it."

# game/scene2_lamba.rpy:20
translate english sahne2_lamba_04b77f0a:

    # s "Ne zaman yürümeye başladım?"
    s "When did I start walking?"

# game/scene2_lamba.rpy:24
translate english sahne2_lamba_28bda224:

    # si "Masa eski. Ahşabı çatlamış, boyası dökülmüş."
    si "The table is old. Cracked wood, peeling paint."

# game/scene2_lamba.rpy:26
translate english sahne2_lamba_7b462a1a:

    # si "Ama lambanın oturduğu halka tozsuz. Tertemiz."
    si "But the ring the lamp sits in is free of dust. Spotless."

# game/scene2_lamba.rpy:28
translate english sahne2_lamba_41add076:

    # s "Ya biri onu her gün kaldırıyor... ya da lamba toz tutmuyor."
    s "Either someone lifts it every day... or the lamp doesn't gather dust."

# game/scene2_lamba.rpy:30
translate english sahne2_lamba_80e98ba2:

    # si "Alev kısık. Ama sıcaklığını buradan hissediyorum."
    si "The flame is low. But I can feel its warmth from here."

# game/scene2_lamba.rpy:32
translate english sahne2_lamba_bba51c89:

    # si "Hayır. Sıcaklık değil bu. Başka bir şey."
    si "No. It isn't warmth. It's something else."

# game/scene2_lamba.rpy:34
translate english sahne2_lamba_7e270cea:

    # s "Nabız gibi."
    s "Like a pulse."

# game/scene2_lamba.rpy:54
translate english sahne2_secim_d1c727d3:

    # s "Sadece bir lamba."
    s "Just a lamp."

# game/scene2_lamba.rpy:56
translate english sahne2_secim_4362f343:

    # si "Cümleyi ağzımın içinde çeviriyorum. Tadı yanlış."
    si "I turn the sentence over in my mouth. It tastes wrong."

# game/scene2_lamba.rpy:58
translate english sahne2_secim_29debcea:

    # s "Sadece bir... hayır. Değil. Neden değil?"
    s "Just a... no. It isn't. Why isn't it?"

# game/scene2_lamba.rpy:60
translate english sahne2_secim_5db8cdd2:

    # si "Düşünce çengel gibi. Çektikçe derine giriyor."
    si "The thought is like a hook. The more I pull, the deeper it goes."

# game/scene2_lamba.rpy:62
translate english sahne2_secim_30c1cfb8:

    # s "Sen ektin bunu, değil mi? Yoksa ben mi?"
    s "You planted that, didn't you? Or did I?"

# game/scene2_lamba.rpy:78
translate english sahne2_dokun_7f51c21d:

    # s "Elim kendiliğinden uzanıyor."
    s "My hand reaches out on its own."

# game/scene2_lamba.rpy:80
translate english sahne2_dokun_fb5eaf4a:

    # si "Sanki karar benim değilmiş gibi. Sanki el başkasının."
    si "As if the decision weren't mine. As if the hand were someone else's."

# game/scene2_lamba.rpy:82
translate english sahne2_dokun_954ab2f2:

    # si "Parmaklarım kırmızı cama yaklaşıyor..."
    si "My fingers approach the red glass..."

# game/scene2_lamba.rpy:103
translate english sahne2_dokun_krit_basari_a8cf8838:

    # si "Parmaklarım sapı buluyor. Cam sıcak ama yakmıyor."
    si "My fingers find the handle. The glass is warm, but it doesn't burn."

# game/scene2_lamba.rpy:105
translate english sahne2_dokun_krit_basari_d2092284:

    # si "Lambayı kaldırıyorum. Ağırlığı avucuma oturuyor."
    si "I lift the lamp. Its weight settles into my palm."

# game/scene2_lamba.rpy:107
translate english sahne2_dokun_krit_basari_d99624fa:

    # s "Bu ağırlığı tanıyorum."
    s "I know this weight."

# game/scene2_lamba.rpy:109
translate english sahne2_dokun_krit_basari_f9839b70:

    # s "Bunu daha önce taşıdım. Uzun bir yol boyunca. Kilometrelerce."
    s "I have carried this before. Down a long road. For miles."

# game/scene2_lamba.rpy:111
translate english sahne2_dokun_krit_basari_07c43e24:

    # si "Tabanını çeviriyorum. Metale bir şey kazınmış."
    si "I turn its base over. Something is scratched into the metal."

# game/scene2_lamba.rpy:113
translate english sahne2_dokun_krit_basari_ac09e9f1:

    # s "Tek kelime: {b}UYUMA{/b}."
    s "Two words: {b}DON'T SLEEP{/b}."

# game/scene2_lamba.rpy:115
translate english sahne2_dokun_krit_basari_ac65b643:

    # s "El yazısı... benimki. Bunu ben kazımışım."
    s "The handwriting is... mine. I carved this."

# game/scene2_lamba.rpy:125
translate english sahne2_dokun_basari_fa6c603c:

    # si "Parmaklarım sapı buluyor. Yavaş. Dikkatli."
    si "My fingers find the handle. Slow. Careful."

# game/scene2_lamba.rpy:127
translate english sahne2_dokun_basari_c1f0b38c:

    # si "Lambayı kaldırıyorum. Beklediğimden ağır."
    si "I lift the lamp. Heavier than I expected."

# game/scene2_lamba.rpy:129
translate english sahne2_dokun_basari_fa23088f:

    # si "Tabanında bir şey var. Kazınmış harfler. Çoğu silinmiş."
    si "There's something on its base. Carved letters. Most of them worn away."

# game/scene2_lamba.rpy:131
translate english sahne2_dokun_basari_3d20b9b4:

    # s "...U... MA..."
    s "...N'T... EEP..."

# game/scene2_lamba.rpy:133
translate english sahne2_dokun_basari_88e1ea6a:

    # s "UYUMA mı? UNUTMA mı? DURMA mı?"
    s "DON'T SLEEP? DON'T WEEP? DON'T KEEP?"

# game/scene2_lamba.rpy:135
translate english sahne2_dokun_basari_1485579a:

    # s "Hangisi olursa olsun — biri bunu bir sebepten kazımış."
    s "Whichever it is — someone carved it for a reason."

# game/scene2_lamba.rpy:137
translate english sahne2_dokun_basari_b2405276:

    # si "Lambayı yerine koyuyorum. Halkasına. Tam oturuyor."
    si "I set the lamp back down. Into its ring. A perfect fit."

# game/scene2_lamba.rpy:145
translate english sahne2_dokun_basarisiz_11895d2c:

    # si "Parmaklarım cama değiyor ve—"
    si "My fingers touch the glass and—"

# game/scene2_lamba.rpy:147
translate english sahne2_dokun_basarisiz_e02a211f:

    # s "Yanıyor!"
    s "It burns!"

# game/scene2_lamba.rpy:149
translate english sahne2_dokun_basarisiz_c1525d01:

    # si "Elimi geri çekiyorum. Parmak uçlarım zonkluyor, kızarmış."
    si "I pull my hand back. My fingertips are throbbing, reddened."

# game/scene2_lamba.rpy:151
translate english sahne2_dokun_basarisiz_ec5c0422:

    # si "Ama asıl tuhafı bu değil."
    si "But that's not the strange part."

# game/scene2_lamba.rpy:153
translate english sahne2_dokun_basarisiz_6170af52:

    # s "Lamba kılını bile kıpırdatmadı."
    s "The lamp didn't so much as tremble."

# game/scene2_lamba.rpy:155
translate english sahne2_dokun_basarisiz_879ed9ea:

    # s "Çarptım ona. Sarsılması gerekirdi. Devrilmesi gerekirdi."
    s "I knocked into it. It should have shaken. It should have toppled."

# game/scene2_lamba.rpy:157
translate english sahne2_dokun_basarisiz_2b6ed16a:

    # s "Sanki masaya vidalanmış. Hayır..."
    s "As if it were bolted to the table. No..."

# game/scene2_lamba.rpy:159
translate english sahne2_dokun_basarisiz_ef820f1b:

    # s "Sanki dünya {i}ona{/i} vidalanmış."
    s "As if the world were bolted to {i}it{/i}."

# game/scene2_lamba.rpy:171
translate english sahne2_dokun_krit_fiyasko_f2cc2f3d:

    # si "Parmaklarım cama değiyor ve alev—"
    si "My fingers touch the glass and the flame—"

# game/scene2_lamba.rpy:173
translate english sahne2_dokun_krit_fiyasko_dd3247a9:

    # si "Sönüyor."
    si "Goes out."

# game/scene2_lamba.rpy:175
translate english sahne2_dokun_krit_fiyasko_454c353f:

    # s "Karanlık. Mutlak karanlık."
    s "Darkness. Absolute darkness."

# game/scene2_lamba.rpy:177
translate english sahne2_dokun_krit_fiyasko_e5acc9bb:

    # si "Kendi nefesimi duyuyorum. Hızlı. Sığ."
    si "I hear my own breathing. Fast. Shallow."

# game/scene2_lamba.rpy:179
translate english sahne2_dokun_krit_fiyasko_5813ca85:

    # si "Ve başka bir nefes daha. Yavaş. Derin. Odanın köşesinden."
    si "And another breath. Slow. Deep. From the corner of the room."

# game/scene2_lamba.rpy:181
translate english sahne2_dokun_krit_fiyasko_ce227a64:

    # s "Karanlıkta biri fısıldadı."
    s "Someone whispered in the dark."

# game/scene2_lamba.rpy:185
translate english sahne2_dokun_krit_fiyasko_7ff9c4cc:

    # s "Ama o... {b}sen değildin{/b}."
    s "But that... {b}wasn't you{/b}."

# game/scene2_lamba.rpy:187
translate english sahne2_dokun_krit_fiyasko_9ead3433:

    # si "Alev, hiçbir şey olmamış gibi yeniden yanıyor."
    si "The flame burns again, as if nothing had happened."

# game/scene2_lamba.rpy:189
translate english sahne2_dokun_krit_fiyasko_14cd4375:

    # si "Oda aynı. Köşe boş. Nefes yok."
    si "The room is the same. The corner is empty. No breathing."

# game/scene2_lamba.rpy:191
translate english sahne2_dokun_krit_fiyasko_e54dc8aa:

    # s "Bir daha dokunmayacağım."
    s "I'm not touching it again."

# game/scene2_lamba.rpy:202
translate english sahne2_izle_67c46add:

    # si "Ellerimi iki yanıma sabitliyorum. Sadece bakıyorum."
    si "I pin my hands to my sides. I only look."

# game/scene2_lamba.rpy:204
translate english sahne2_izle_2a0de910:

    # si "Alev hiç titremiyor."
    si "The flame doesn't flicker at all."

# game/scene2_lamba.rpy:206
translate english sahne2_izle_a4c3aa10:

    # s "Odada cereyan var — tozlar uçuşuyor. Ama alev dimdik."
    s "There's a draft in the room — dust is drifting. But the flame stands perfectly still."

# game/scene2_lamba.rpy:208
translate english sahne2_izle_148623ba:

    # si "Bakmaya devam ediyorum. Alev de bana bakıyor."
    si "I keep looking. The flame looks back."

# game/scene2_lamba.rpy:210
translate english sahne2_izle_268f91ef:

    # s "...alev de bana bakıyor?"
    s "...the flame looks back?"

# game/scene2_lamba.rpy:229
translate english sahne2_izle_krit_basari_1fe404e1:

    # si "Bakışımı koparıyorum. Zor oluyor — bataklıktan bacak çeker gibi."
    si "I tear my gaze away. It's hard — like pulling a leg out of a swamp."

# game/scene2_lamba.rpy:231
translate english sahne2_izle_krit_basari_06824a88:

    # si "Ve gözüm aynaya takılıyor."
    si "And my eye catches the mirror."

# game/scene2_lamba.rpy:233
translate english sahne2_izle_krit_basari_f2e5fe07:

    # s "Aynada oda var. Masa var. Ben varım."
    s "The room is in the mirror. The table is there. I am there."

# game/scene2_lamba.rpy:235
translate english sahne2_izle_krit_basari_6047d65f:

    # s "Lamba yok."
    s "The lamp is not."

# game/scene2_lamba.rpy:237
translate english sahne2_izle_krit_basari_e6195505:

    # si "Aynadaki masanın üstünde, lambanın olması gereken yerde..."
    si "On the mirrored table, where the lamp should be..."

# game/scene2_lamba.rpy:239
translate english sahne2_izle_krit_basari_ab66ddc2:

    # s "Bir anahtar deliği var. Havada asılı, kapkara bir anahtar deliği."
    s "There's a keyhole. A pitch-black keyhole, hanging in the air."

# game/scene2_lamba.rpy:243
translate english sahne2_izle_krit_basari_849b9dc7:

    # s "...ne?"
    s "...what?"

# game/scene2_lamba.rpy:256
translate english sahne2_izle_basari_34334ba3:

    # si "Bakışımı koparıyorum. Boynum tutulmuş — ne kadar süre baktım?"
    si "I tear my gaze away. My neck is stiff — how long was I looking?"

# game/scene2_lamba.rpy:258
translate english sahne2_izle_basari_5f820fa0:

    # si "Gözüm aynaya kayıyor. Ve o zaman fark ediyorum."
    si "My eye drifts to the mirror. And that's when I notice."

# game/scene2_lamba.rpy:260
translate english sahne2_izle_basari_f2e5fe07:

    # s "Aynada oda var. Masa var. Ben varım."
    s "The room is in the mirror. The table is there. I am there."

# game/scene2_lamba.rpy:262
translate english sahne2_izle_basari_6047d65f:

    # s "Lamba yok."
    s "The lamp is not."

# game/scene2_lamba.rpy:264
translate english sahne2_izle_basari_31ceddef:

    # s "Aynadaki masa boş. Alevin ışığı bile yansımıyor."
    s "The mirrored table is bare. Not even the flame's light reflects."

# game/scene2_lamba.rpy:266
translate english sahne2_izle_basari_b114b4ca:

    # si "Aynaya göre bu oda karanlık."
    si "According to the mirror, this room is dark."

# game/scene2_lamba.rpy:274
translate english sahne2_izle_basarisiz_f4bb8357:

    # si "Sadece bir dakika izleyeceğim. Sadece bir—"
    si "I'll watch for just a minute. Just one—"

# game/scene2_lamba.rpy:276
translate english sahne2_izle_basarisiz_456e5432:

    # si "Gözümü kırpıyorum."
    si "I blink."

# game/scene2_lamba.rpy:278
translate english sahne2_izle_basarisiz_a1af0624:

    # s "...diz üstündeyim."
    s "...I'm on my knees."

# game/scene2_lamba.rpy:280
translate english sahne2_izle_basarisiz_a53334fd:

    # si "Masanın önünde diz çökmüşüm. Elim lambanın camında. Cam sıcak."
    si "I'm kneeling before the table. My hand is on the lamp's glass. The glass is warm."

# game/scene2_lamba.rpy:282
translate english sahne2_izle_basarisiz_4ba561cc:

    # s "Ne zaman yürüdüm? Ne zaman diz çöktüm?"
    s "When did I walk? When did I kneel?"

# game/scene2_lamba.rpy:284
translate english sahne2_izle_basarisiz_701fcaf3:

    # si "Ayağa kalkıyorum. Bacaklarım uyuşmuş. Uzun süre öyle kalmışım."
    si "I stand up. My legs are numb. I stayed like that a long time."

# game/scene2_lamba.rpy:286
translate english sahne2_izle_basarisiz_3d975cfc:

    # s "Ve alev... az önce olduğundan bir parmak daha uzun."
    s "And the flame... is a finger taller than it was."

# game/scene2_lamba.rpy:299
translate english sahne2_izle_krit_fiyasko_e7880486:

    # si "İzliyorum. İzliyorum. İzli—"
    si "I watch. I watch. I wa—"

# game/scene2_lamba.rpy:301
translate english sahne2_izle_krit_fiyasko_c43be836:

    # s "Oda ters."
    s "The room is backwards."

# game/scene2_lamba.rpy:303
translate english sahne2_izle_krit_fiyasko_a6dc082e:

    # s "Hayır. Ters değil. {b}Dışarıdan{/b} bakıyorum."
    s "No. Not backwards. I'm looking at it {b}from outside{/b}."

# game/scene2_lamba.rpy:305
translate english sahne2_izle_krit_fiyasko_71138d60:

    # s "Alevin içinden. Kırmızı camın arkasından."
    s "From inside the flame. From behind the red glass."

# game/scene2_lamba.rpy:307
translate english sahne2_izle_krit_fiyasko_9e128e61:

    # s "Masanın önünde bir adam duruyor. Gözleri boş. Ağzı yarı açık."
    s "A man stands before the table. His eyes are empty. His mouth hangs half open."

# game/scene2_lamba.rpy:309
translate english sahne2_izle_krit_fiyasko_35013629:

    # s "O adam benim."
    s "That man is me."

# game/scene2_lamba.rpy:313
translate english sahne2_izle_krit_fiyasko_d083c523:

    # si "...duvara yaslanmışım. Kalbim kaburgalarımı dövüyor."
    si "...I'm leaning against the wall. My heart is hammering my ribs."

# game/scene2_lamba.rpy:315
translate english sahne2_izle_krit_fiyasko_2a6eb97c:

    # si "Lamba masasında. Alev kısık. Her şey normal."
    si "The lamp is on its table. The flame is low. Everything is normal."

# game/scene2_lamba.rpy:317
translate english sahne2_izle_krit_fiyasko_3069130e:

    # s "Hiçbir şey normal değil."
    s "Nothing is normal."

# game/scene2_lamba.rpy:330
translate english sahne2_kapi_5b97701b:

    # si "Geri çekiliyorum. Bir adım. İki."
    si "I step back. One step. Two."

# game/scene2_lamba.rpy:332
translate english sahne2_kapi_24e943bc:

    # si "İşte o zaman görüyorum."
    si "That's when I see it."

# game/scene2_lamba.rpy:334
translate english sahne2_kapi_02eed3bf:

    # s "Duvarda bir kapı var."
    s "There is a door in the wall."

# game/scene2_lamba.rpy:336
translate english sahne2_kapi_10853dc8:

    # s "Az önce orada değildi. Ya da hep oradaydı da... ben mi görmüyordum?"
    s "It wasn't there a moment ago. Or it was always there and... I just couldn't see it?"

# game/scene2_lamba.rpy:338
translate english sahne2_kapi_1f941e6c:

    # si "Ahşap, demir kuşaklı, sıradan bir kapı. Sıradanlığı rahatsız edici."
    si "A wooden door, iron-banded, ordinary. Its ordinariness is unsettling."

# game/scene2_lamba.rpy:342
translate english sahne2_kapi_3a65c556:

    # s "Dışarıda ne olduğunu bilmiyorum."
    s "I don't know what's out there."

# game/scene2_lamba.rpy:346
translate english sahne2_kapi_e1554201:

    # s "..."
    s "..."

# game/scene2_lamba.rpy:348
translate english sahne2_kapi_5112448b:

    # s "\"Gidemeyiz\"?"
    s "\"We\"?"

# game/scene2_lamba.rpy:352
translate english sahne2_kapi_3b6a8b35:

    # s "Biz... kaç kişiyiz?"
    s "How many... of us are there?"

# game/scene2_lamba.rpy:360
translate english sahne2_kapi_e6418b3f:

    # si "Sorumun cevabı gelmiyor. Sadece o iki kelime, kafamın içinde, kendi sesimden daha yüksek."
    si "No answer comes. Only those two words, inside my head, louder than my own voice."

# game/scene2_lamba.rpy:362
translate english sahne2_kapi_f0e5ef37:

    # si "Elim lambanın sapına uzanıyor."
    si "My hand reaches for the lamp's handle."

translate english strings:

    # game/scene2_lamba.rpy:44
    old "«Dokun. Kaldır onu.»"
    new "«Touch it. Lift it.»"

    # game/scene2_lamba.rpy:47
    old "«Dokunma. Sadece izle.»"
    new "«Don't touch it. Just watch.»"

    # game/scene2_lamba.rpy:51
    old "«Boş ver lambayı. O sadece bir lamba.»"
    new "«Forget the lamp. It's just a lamp.»"
