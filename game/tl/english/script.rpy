# English translation — script.rpy (Scene 1: Waking)

# game/script.rpy:43
translate english start_6da7caa0:

    # si "...soğuk."
    si "...cold."

# game/script.rpy:45
translate english start_dc5db9d5:

    # si "Taş. Sırtımın altında taş var."
    si "Stone. There is stone under my back."

# game/script.rpy:47
translate english start_8bb72fe9:

    # si "Ne kadar zamandır buradayım?"
    si "How long have I been here?"

# game/script.rpy:49
translate english start_e1554201:

    # s "..."
    s "..."

# game/script.rpy:51
translate english start_d374aff4:

    # s "Kalkmalıyım."
    s "I should get up."

# game/script.rpy:61
translate english start_b96ff2f7:

    # s "...?"
    s "...?"

# game/script.rpy:63
translate english start_b4f3b534:

    # s "Bu... benim sesim miydi?"
    s "Was that... my voice?"

# game/script.rpy:65
translate english start_8451eb2a:

    # si "Elbette benim sesimdi. Başka kimin olacak?"
    si "Of course it was my voice. Whose else would it be?"

# game/script.rpy:67
translate english start_96ca397d:

    # si "Ayağa kalkıyorum. Eklemlerim paslı menteşeler gibi gıcırdıyor."
    si "I stand up. My joints creak like rusted hinges."

# game/script.rpy:72
translate english start_88907752:

    # si "Oda küçük. Duvarlar taş. Pencere yok."
    si "The room is small. Stone walls. No window."

# game/script.rpy:74
translate english start_9ba9ef38:

    # si "Köşede bir yatak — az önce üstünde değildim. Yerde uyumuşum."
    si "A bed in the corner — I wasn't on it just now. I slept on the floor."

# game/script.rpy:76
translate english start_02160143:

    # si "Ve karşımda... bir ayna."
    si "And in front of me... a mirror."

# game/script.rpy:86
translate english sahne1_ayna_6622094f:

    # s "Aynadaki adam bana bakıyor."
    s "The man in the mirror is looking at me."

# game/script.rpy:88
translate english sahne1_ayna_34dd3513:

    # s "Yorgun. Sakallı. Şakağında kurumuş kan."
    s "Tired. Bearded. Dried blood on his temple."

# game/script.rpy:90
translate english sahne1_ayna_599a01da:

    # s "Demek buyum. Daha kötüsü olabilirdi."
    s "So this is me. Could have been worse."

# game/script.rpy:92
translate english sahne1_ayna_7e68ede5:

    # s "Nasıl olabilirdi bilmiyorum. Ama olabilirdi."
    s "I don't know how. But it could have."

# game/script.rpy:94
translate english sahne1_ayna_ca74d7b5:

    # s "Bu yüzü tanıyorum. Tanımam gerekiyor."
    s "I know this face. I'm supposed to know it."

# game/script.rpy:96
translate english sahne1_ayna_9fc2635d:

    # s "Ama... ismi yok. Yüzün ismi yok."
    s "But... there's no name. The face has no name."

# game/script.rpy:98
translate english sahne1_ayna_5a4fc308:

    # s "Kimim ben?"
    s "Who am I?"

# game/script.rpy:100
translate english sahne1_ayna_ebb00581:

    # s "Neden buradayım?"
    s "Why am I here?"

# game/script.rpy:103
translate english sahne1_ayna_8fd43c03:

    # si "Odaklanmalıyım. Kim olduğumu—"
    si "I need to focus. Who I am—"

# game/script.rpy:111
translate english sahne1_ayna_d11af1f7:

    # si "...masanın üstünde bir gaz lambası var."
    si "...there is a gas lamp on the table."

# game/script.rpy:113
translate english sahne1_ayna_1bf063b0:

    # si "Camı kırmızı. Alevi kısık ama sönmüyor."
    si "Its glass is red. The flame is low, but it does not die."

# game/script.rpy:115
translate english sahne1_ayna_5feddaa6:

    # s "Bu lamba... özel."
    s "This lamp is... special."

# game/script.rpy:117
translate english sahne1_ayna_6e8e13cd:

    # s "Neden özel olduğunu bilmiyorum ama özel. Bundan eminim."
    s "I don't know why it's special, but it is. I'm sure of that."

# game/script.rpy:119
translate english sahne1_ayna_9943fff3:

    # s "Bu odada önemli olan tek şey o. Belki de dünyada önemli olan tek şey."
    s "It's the only thing that matters in this room. Maybe the only thing that matters in the world."

# game/script.rpy:121
translate english sahne1_ayna_20e4c6d7:

    # si "...ne?"
    si "...what?"

# game/script.rpy:123
translate english sahne1_ayna_51eebe8f:

    # si "Bu düşünce nereden geldi? Ben... ben aynaya bakıyordum."
    si "Where did that thought come from? I... I was looking at the mirror."

# game/script.rpy:125
translate english sahne1_ayna_e5a59b05:

    # s "Kim olduğumu bulmaya çalışıyordum."
    s "I was trying to find out who I am."

# game/script.rpy:137
translate english sahne1_hatirlama_0f3d6f40:

    # s "Ellerim..."
    s "My hands..."

# game/script.rpy:139
translate english sahne1_hatirlama_dff7bfb9:

    # si "Avuçlarım nasır içinde. Parmaklarım bir şeyi kavramaya alışkın."
    si "My palms are covered in calluses. My fingers are used to gripping something."

# game/script.rpy:141
translate english sahne1_hatirlama_1ca7492c:

    # si "Bir şeyin... kabzasını."
    si "Something's... hilt."

# game/script.rpy:145
translate english sahne1_hatirlama_ee8eff91:

    # s "Kan..."
    s "Blood..."

# game/script.rpy:147
translate english sahne1_hatirlama_eab96807:

    # si "Şakağıma dokunuyorum. Kurumuş, pul pul."
    si "I touch my temple. Dried, flaking."

# game/script.rpy:149
translate english sahne1_hatirlama_9494d40e:

    # si "Bir darbe. Düşüş. Metalin metale çarptığı bir ses... uzakta."
    si "A blow. A fall. The sound of metal striking metal... far away."

# game/script.rpy:155
translate english sahne1_hatirlama_e1554201:

    # s "..."
    s "..."

# game/script.rpy:157
translate english sahne1_hatirlama_93b7c381:

    # s "Önemli değil mi?"
    s "It doesn't matter?"

# game/script.rpy:159
translate english sahne1_hatirlama_f6799786:

    # si "Cümle göğsümde bir yere oturuyor. Soğuk bir taş gibi."
    si "The sentence settles somewhere in my chest. Like a cold stone."

# game/script.rpy:161
translate english sahne1_hatirlama_72e8ff07:

    # s "Belki haklısın. Belki isimsiz de yürünür."
    s "Maybe you're right. Maybe a man can walk without a name."

# game/script.rpy:163
translate english sahne1_hatirlama_3ab8badc:

    # s "Ama yine de deneyeceğim. Sana rağmen."
    s "But I will try anyway. In spite of you."

# game/script.rpy:168
translate english sahne1_hatirlama_3153c890:

    # s "Hatırlamaya çalışıyorum."
    s "I try to remember."

# game/script.rpy:170
translate english sahne1_hatirlama_b3638d3a:

    # si "Zihnimin karanlık bir dehlizine uzanıyorum. Parmak uçlarımda bir şey var, kıpırdıyor..."
    si "I reach into a dark passage of my mind. There is something at my fingertips, stirring..."

# game/script.rpy:189
translate english sahne1_hatirlama_krit_basari_b6fed155:

    # si "Dehliz aydınlanıyor."
    si "The passage lights up."

# game/script.rpy:191
translate english sahne1_hatirlama_krit_basari_222e30c3:

    # s "Bir savaş alanı. Çamur. Yağmur."
    s "A battlefield. Mud. Rain."

# game/script.rpy:193
translate english sahne1_hatirlama_krit_basari_e98f93cf:

    # s "Sırtımda zırh var — ağırlığını hatırlıyorum, omuzlarımı nasıl çökerttiğini."
    s "There is armor on my back — I remember its weight, how it crushed my shoulders."

# game/script.rpy:195
translate english sahne1_hatirlama_krit_basari_ac5aeb78:

    # s "Biri bana bağırıyor. Bir isim. Benim ismim."
    s "Someone is shouting at me. A name. My name."

# game/script.rpy:197
translate english sahne1_hatirlama_krit_basari_6c0b97fe:

    # s "Duyamıyorum ama... bir yemin ettiğimi biliyorum. Birine. Bir şey için."
    s "I can't hear it, but... I know I swore an oath. To someone. For something."

# game/script.rpy:199
translate english sahne1_hatirlama_krit_basari_b34cde1d:

    # s "Ben bir şövalyeyim. Ya da... öyleydim."
    s "I am a knight. Or... I was."

# game/script.rpy:203
translate english sahne1_hatirlama_krit_basari_16ddf634:

    # s "Bu ses yine geldi. İçimden ama... içimden değil."
    s "That voice came again. From inside me, but... not from me."

# game/script.rpy:211
translate english sahne1_hatirlama_basari_11a99e80:

    # si "Karanlıkta bir şey parlıyor."
    si "Something glints in the dark."

# game/script.rpy:213
translate english sahne1_hatirlama_basari_8328d20c:

    # s "Metal. Soğuk metal, avucumun içinde."
    s "Metal. Cold metal, in my palm."

# game/script.rpy:215
translate english sahne1_hatirlama_basari_cbbe19bf:

    # s "Bir kılıç kabzası. Ona sarılmışım, saatlerce, günlerce."
    s "A sword's hilt. I held onto it for hours, for days."

# game/script.rpy:217
translate english sahne1_hatirlama_basari_4910e519:

    # s "Ben... savaşan biriydim. Bir asker? Bir şövalye?"
    s "I was... someone who fought. A soldier? A knight?"

# game/script.rpy:219
translate english sahne1_hatirlama_basari_2ceb010e:

    # s "Kesin değil. Ama ellerim kılıç tutmayı unutmamış."
    s "Not certain. But my hands haven't forgotten how to hold a sword."

# game/script.rpy:229
translate english sahne1_hatirlama_basarisiz_180747fe:

    # si "Uzanıyorum... uzanıyorum..."
    si "I reach... I reach..."

# game/script.rpy:231
translate english sahne1_hatirlama_basarisiz_6877b310:

    # s "Hiçbir şey."
    s "Nothing."

# game/script.rpy:233
translate english sahne1_hatirlama_basarisiz_4d8644e7:

    # s "Karanlık dehliz sadece uğultuyla dolu. Arı kovanı gibi."
    s "The dark passage is filled only with humming. Like a beehive."

# game/script.rpy:235
translate english sahne1_hatirlama_basarisiz_72c472a7:

    # s "Başım zonkluyor. Zorladıkça uğultu büyüyor."
    s "My head throbs. The harder I push, the louder the hum."

# game/script.rpy:237
translate english sahne1_hatirlama_basarisiz_265fbab6:

    # si "Bırakıyorum. Şimdilik."
    si "I let go. For now."

# game/script.rpy:249
translate english sahne1_hatirlama_krit_fiyasko_e64f5084:

    # si "Uzanıyorum ve—"
    si "I reach, and—"

# game/script.rpy:251
translate english sahne1_hatirlama_krit_fiyasko_32b0b27a:

    # s "Bir şey uzandığım yerden {b}geri{/b} uzanıyor."
    s "Something reaches {b}back{/b} from where I'm reaching."

# game/script.rpy:253
translate english sahne1_hatirlama_krit_fiyasko_e6184308:

    # s "Soğuk. Islak. Parmaklarımı sayıyor."
    s "Cold. Wet. It is counting my fingers."

# game/script.rpy:255
translate english sahne1_hatirlama_krit_fiyasko_b0fdf9a6:

    # s "GERİ ÇEK. GERİ ÇEK. GERİ—"
    s "PULL BACK. PULL BACK. PULL—"

# game/script.rpy:257
translate english sahne1_hatirlama_krit_fiyasko_53f89fdd:

    # si "...duvara yaslanmışım. Nefes nefeseyim."
    si "...I'm leaning against the wall. Out of breath."

# game/script.rpy:259
translate english sahne1_hatirlama_krit_fiyasko_bcedc2a8:

    # s "Bir daha oraya bakmayacağım."
    s "I am never looking in there again."

# game/script.rpy:261
translate english sahne1_hatirlama_krit_fiyasko_4ce69e1b:

    # si "Gözlerim kendiliğinden lambaya kayıyor. Kırmızı cam. Kısık alev."
    si "My eyes drift to the lamp on their own. Red glass. Low flame."

# game/script.rpy:263
translate english sahne1_hatirlama_krit_fiyasko_4faf2092:

    # s "Lamba güvenli. Lamba... özel."
    s "The lamp is safe. The lamp is... special."

# game/script.rpy:270
translate english sahne1_son_2515b7d6:

    # si "Oda hâlâ aynı. Taş duvarlar, yatak, ayna."
    si "The room is still the same. Stone walls, a bed, a mirror."

# game/script.rpy:272
translate english sahne1_son_526e48d4:

    # si "Ve masanın üstünde, kısık alevli kırmızı lamba."
    si "And on the table, the red lamp with its low flame."

# game/script.rpy:274
translate english sahne1_son_6d832cc0:

    # si "Sanki bekliyor."
    si "As if it's waiting."

translate english strings:

    # game/script.rpy:136
    old "«Hatırla. Ellerine bak. Ellerin bilir.»"
    new "«Remember. Look at your hands. Your hands know.»"

    # game/script.rpy:144
    old "«Hatırla. Kan. Şakağındaki kan nereden geldi?»"
    new "«Remember. The blood. Where did the blood on your temple come from?»"

    # game/script.rpy:154
    old "«Boş ver. Kim olduğun önemli değil.»"
    new "«Let it go. It doesn't matter who you are.»"
