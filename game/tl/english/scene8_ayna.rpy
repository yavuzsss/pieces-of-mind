# English translation — scene8_ayna.rpy (Scene 8: Sleep and the Mirror)

# game/scene8_ayna.rpy:28
translate english sahne8_oda_1e345f87:

    # s "Uyuma diyorsun."
    s "Don't sleep, you say."

# game/scene8_ayna.rpy:30
translate english sahne8_oda_cdf84b0c:

    # s "Neden?"
    s "Why?"

# game/scene8_ayna.rpy:34
translate english sahne8_oda_4d26da0e:

    # s "Kim arar?"
    s "Who searches?"

# game/scene8_ayna.rpy:38
translate english sahne8_oda_0cc45fff:

    # s "Tabii. Sustuğun yer, cevabın olduğu yer."
    s "Of course. Where you go silent is where the answer is."

# game/scene8_ayna.rpy:42
translate english sahne8_oda_f198dce8:

    # si "Yarım'ın sesi kulağımda: {i}Uykuda ellerini açarlar.{/i}"
    si "The Half's voice is in my ear: {i}In sleep, they open their hands.{/i}"

# game/scene8_ayna.rpy:44
translate english sahne8_oda_3a164db1:

    # s "Benimki de öyle mi gitti? Adım. Uyurken mi?"
    s "Is that how mine went too? My name. While I slept?"

# game/scene8_ayna.rpy:48
translate english sahne8_oda_e08f647c:

    # si "Tek kelime. Taş gibi düşüyor."
    si "A single word. It drops like a stone."

# game/scene8_ayna.rpy:52
translate english sahne8_oda_b7b6331f:

    # si "Lambanın tabanındaki kazıma. UYUMA. Kendi elimle."
    si "The carving on the lamp's base. DON'T SLEEP. In my own hand."

# game/scene8_ayna.rpy:54
translate english sahne8_oda_5057f49f:

    # s "Demek bunu bir kere öğrenmişim."
    s "So I learned this once before."

# game/scene8_ayna.rpy:56
translate english sahne8_oda_3c5bfdf4:

    # s "Ve unutacağımı da biliyormuşum."
    s "And I knew I would forget it."

# game/scene8_ayna.rpy:63
translate english sahne8_yatak_a3b9aee8:

    # si "Yatak köşeden bakıyor. Çökük, gri, sıradan."
    si "The bed watches from the corner. Sunken, gray, ordinary."

# game/scene8_ayna.rpy:65
translate english sahne8_yatak_0760afd4:

    # si "Bacaklarım ona doğru bir adım atmış bile. Ben atmadım."
    si "My legs have already taken a step toward it. I didn't take it."

# game/scene8_ayna.rpy:67
translate english sahne8_yatak_4da1abc5:

    # s "Dünyada tek yatak kaldı ve yasak."
    s "One bed left in the world, and it's forbidden."

# game/scene8_ayna.rpy:69
translate english sahne8_yatak_064f93e1:

    # s "Şansım hep böyleydi galiba. Hatırlamıyorum ama böyleydi."
    s "I think my luck was always like this. I don't remember, but it was."

# game/scene8_ayna.rpy:71
translate english sahne8_yatak_b221c6f3:

    # si "Gözkapaklarım... her kapanışta biraz daha geç açılıyor."
    si "My eyelids... open a little later with every blink."

# game/scene8_ayna.rpy:78
translate english sahne8_yatak_d9955605:

    # si "Yürüyorum. Duvardan duvara. Dört adım, dön. Dört adım, dön."
    si "I walk. Wall to wall. Four steps, turn. Four steps, turn."

# game/scene8_ayna.rpy:80
translate english sahne8_yatak_bf92d670:

    # si "Dizlerim her dönüşte biraz daha ağır."
    si "My knees grow heavier with every turn."

# game/scene8_ayna.rpy:82
translate english sahne8_yatak_f59bfc8d:

    # s "Kendi odamda devriye geziyorum. Neden kaçtığımı bilmeden."
    s "I'm patrolling my own room. Without knowing what I'm running from."

# game/scene8_ayna.rpy:88
translate english sahne8_yatak_29e24c1c:

    # si "Elim şakağıma gidiyor. Kurumuş kanın altı hâlâ hassas."
    si "My hand goes to my temple. Under the dried blood, it's still tender."

# game/scene8_ayna.rpy:90
translate english sahne8_yatak_e01acc9f:

    # si "Bastırıyorum."
    si "I press."

# game/scene8_ayna.rpy:92
translate english sahne8_yatak_e1554201:

    # s "..."
    s "..."

# game/scene8_ayna.rpy:94
translate english sahne8_yatak_02184821:

    # si "Oda keskinleşiyor. Acı, dünyayı yerine oturtuyor."
    si "The room sharpens. Pain sets the world back in its place."

# game/scene8_ayna.rpy:96
translate english sahne8_yatak_6695cb52:

    # s "Uyanığım. Bunu senden öğrendim: acıyla ödenen her şey işliyor."
    s "I'm awake. I learned this from you: anything paid for in pain works."

# game/scene8_ayna.rpy:102
translate english sahne8_yatak_8a499707:

    # si "Lambayı masadan alıyorum. Kısık, kırmızı alev."
    si "I take the lamp from the table. The low, red flame."

# game/scene8_ayna.rpy:104
translate english sahne8_yatak_e6377fe7:

    # si "Bakıyorum. Bakmak kolay. Bakmayı bırakmak zor."
    si "I look. Looking is easy. Stopping is hard."

# game/scene8_ayna.rpy:106
translate english sahne8_yatak_2a639c64:

    # s "Ne kadar baktım?"
    s "How long did I look?"

# game/scene8_ayna.rpy:108
translate english sahne8_yatak_468036a7:

    # si "Bilmiyorum. Alevin içinde zaman düz akmıyor."
    si "I don't know. Time doesn't flow straight inside the flame."

# game/scene8_ayna.rpy:112
translate english sahne8_yatak_4796922a:

    # si "Uyku geri çekiliyor. Köşesine. Beklemeye."
    si "Sleep retreats. To its corner. To wait."

# game/scene8_ayna.rpy:114
translate english sahne8_yatak_8cf24cef:

    # s "Peki. Uyumayacağım."
    s "Fine. I won't sleep."

# game/scene8_ayna.rpy:125
translate english sahne8_sonsuzluk_3ac2feba:

    # s "Konuş benimle, içimdeki."
    s "Talk to me, you inside."

# game/scene8_ayna.rpy:127
translate english sahne8_sonsuzluk_48d3b63e:

    # s "Susarsan dinlerim. Dinlersem uyurum."
    s "If you're silent, I'll listen. If I listen, I'll sleep."

# game/scene8_ayna.rpy:131
translate english sahne8_sonsuzluk_33861e77:

    # s "Fark etmez. Uyutmayacak bir şey olsun."
    s "Doesn't matter what. Something that won't let me sleep."

# game/scene8_ayna.rpy:136
translate english sahne8_sonsuzluk_e1554201:

    # s "..."
    s "..."

# game/scene8_ayna.rpy:138
translate english sahne8_sonsuzluk_073b3a52:

    # s "Peki. Sonsuzluk."
    s "All right. Eternity."

# game/scene8_ayna.rpy:142
translate english sahne8_sonsuzluk_ca25d30e:

    # s "Bu aralar başka bir şey düşündüğüm yok."
    s "It's all I think about these days."

# game/scene8_ayna.rpy:146
translate english sahne8_sonsuzluk_1f615f2d:

    # s "Ödül mü?"
    s "The reward?"

# game/scene8_ayna.rpy:148
translate english sahne8_sonsuzluk_90e442d7:

    # s "Ödül iyidir. Dinlenmek. Işık. Ne bileyim — bahçeler."
    s "Rewards are good. Rest. Light. I don't know — gardens."

# game/scene8_ayna.rpy:152
translate english sahne8_sonsuzluk_b5aba532:

    # s "Evet. Sonsuza kadar. Güzel kelime."
    s "Yes. Forever. It's a nice word."

# game/scene8_ayna.rpy:156
translate english sahne8_sonsuzluk_af1b19bb:

    # si "Kelimeyi ağzımda çeviriyorum. Sonsuz. Son-suz."
    si "I turn the word over in my mouth. Endless. End-less."

# game/scene8_ayna.rpy:158
translate english sahne8_sonsuzluk_ded0a963:

    # s "...dur."
    s "...wait."

# game/scene8_ayna.rpy:166
translate english sahne8_sonsuzluk_6f703d4e:

    # s "Tamam. Saydım. Uzun süre eğlendik."
    s "Fine. I counted. We had fun for a long time."

# game/scene8_ayna.rpy:170
translate english sahne8_sonsuzluk_e1554201_1:

    # s "..."
    s "..."

# game/scene8_ayna.rpy:172
translate english sahne8_sonsuzluk_2ff2fcb5:

    # s "Hâlâ sonsuz."
    s "Still infinite."

# game/scene8_ayna.rpy:174
translate english sahne8_sonsuzluk_f17125a1:

    # s "Bütün o sayılar... ve geriye kalan {b}hâlâ sonsuz{/b}."
    s "All those numbers... and what remains is {b}still infinite{/b}."

# game/scene8_ayna.rpy:176
translate english sahne8_sonsuzluk_67c17def:

    # si "Cümle midemin dibine oturuyor. Uçurumun kenarındaki his — ama dibi olmayan bir uçurum."
    si "The sentence settles in the pit of my stomach. The feeling at a cliff's edge — but a cliff with no bottom."

# game/scene8_ayna.rpy:178
translate english sahne8_sonsuzluk_a6d321d0:

    # s "Dileklerin biter. İsteklerin biter. Sen bitmezsin."
    s "Your wishes run out. Your wants run out. You don't."

# game/scene8_ayna.rpy:180
translate english sahne8_sonsuzluk_e20a111a:

    # s "Bahçeler kalır. Ve sen. Ve zaman."
    s "The gardens remain. And you. And time."

# game/scene8_ayna.rpy:186
translate english sahne8_sonsuzluk_849b9dc7:

    # s "...ne?"
    s "...what?"

# game/scene8_ayna.rpy:190
translate english sahne8_sonsuzluk_d1296e0f:

    # s "Mutlak mutluluk için... zaman algımızı mı alırlar elimizden?"
    s "For perfect happiness... they'd take our sense of time from us?"

# game/scene8_ayna.rpy:192
translate english sahne8_sonsuzluk_37bba6be:

    # s "Dur. Bu mutluluk mu peki?"
    s "Wait. Is that even happiness?"

# game/scene8_ayna.rpy:194
translate english sahne8_sonsuzluk_d763835d:

    # s "Bu bilmeyenin mutluluğu. Cahilin mutluluğu."
    s "That's the happiness of not knowing. The happiness of the ignorant."

# game/scene8_ayna.rpy:196
translate english sahne8_sonsuzluk_10d0538c:

    # s "Bir bahçede gülümseyen ve kaç gündür gülümsediğini sayamayan bir adam."
    s "A man smiling in a garden, unable to count how many days he's been smiling."

# game/scene8_ayna.rpy:198
translate english sahne8_sonsuzluk_21da7053:

    # si "Ve cümle biterken soğuk bir şey ensemden aşağı iniyor."
    si "And as the sentence ends, something cold runs down the back of my neck."

# game/scene8_ayna.rpy:200
translate english sahne8_sonsuzluk_2c833b92:

    # s "Kulenin tepesindeki alev geldi aklıma. İçinde yanan isimler."
    s "The flame at the top of the tower came to mind. The names burning inside it."

# game/scene8_ayna.rpy:202
translate english sahne8_sonsuzluk_8eacdf07:

    # s "Onlar da mı saymıyor?"
    s "Do they not count either?"

# game/scene8_ayna.rpy:206
translate english sahne8_sonsuzluk_2f0a0f7f:

    # si "Duvarların ardındaki uğultu bir an... yaklaşıyor gibi. Ilık. Davetkâr."
    si "For a moment the hum behind the walls seems... closer. Warm. Inviting."

# game/scene8_ayna.rpy:208
translate english sahne8_sonsuzluk_ccb5b7be:

    # s "Ben ne kadar zamandır buradayım, içimdeki?"
    s "How long have I been here, you inside?"

# game/scene8_ayna.rpy:210
translate english sahne8_sonsuzluk_fd80259c:

    # si "Bilmiyorum."
    si "I don't know."

# game/scene8_ayna.rpy:212
translate english sahne8_sonsuzluk_8c218a6b:

    # s "Sayamıyorum. Saymayı... bilmiyorum."
    s "I can't count it. I don't... know how to count."

# game/scene8_ayna.rpy:216
translate english sahne8_sonsuzluk_e8086197:

    # s "Sen biliyor musun?"
    s "Do you know?"

# game/scene8_ayna.rpy:220
translate english sahne8_sonsuzluk_a50192d1:

    # s "Sustuğun yer, cevabın olduğu yer."
    s "Where you go silent is where the answer is."

# game/scene8_ayna.rpy:224
translate english sahne8_sonsuzluk_b12e3462:

    # s "Uykum kaçtı."
    s "Well. I'm not sleepy anymore."

# game/scene8_ayna.rpy:226
translate english sahne8_sonsuzluk_1502b525:

    # s "Sanırım istediğin de buydu."
    s "I suppose that's what you wanted."

# game/scene8_ayna.rpy:228
translate english sahne8_sonsuzluk_e874a4e4:

    # s "Ama bir şey yapmam lazım. Bekleyen adam uyur."
    s "But I need to do something. A man who waits is a man who sleeps."

# game/scene8_ayna.rpy:241
translate english sahne8_ayna_5ab63932:

    # si "Aynanın karşısındayım."
    si "I stand before the mirror."

# game/scene8_ayna.rpy:243
translate english sahne8_ayna_a0a09b9c:

    # si "Cam yok gibi. Oda yok. Ben yokum."
    si "The glass might as well not exist. No room. No me."

# game/scene8_ayna.rpy:245
translate english sahne8_ayna_7a09bc2d:

    # si "Sadece delik: kapkara, göz hizasında, bekliyor."
    si "Only the hole: pitch black, at eye level, waiting."

# game/scene8_ayna.rpy:247
translate english sahne8_ayna_014ee5b6:

    # s "Anahtarım yok."
    s "I have no key."

# game/scene8_ayna.rpy:251
translate english sahne8_ayna_426e0101:

    # s "Ne istiyor?"
    s "What does it want?"

# game/scene8_ayna.rpy:255
translate english sahne8_ayna_16cb1427:

    # s "Elbette."
    s "Of course."

# game/scene8_ayna.rpy:257
translate english sahne8_ayna_e3ad8826:

    # s "Bu dünyada hiçbir kapı sadece açılmıyor. Hepsi önce bir şey alıyor."
    s "No door in this world simply opens. Every one of them takes something first."

# game/scene8_ayna.rpy:259
translate english sahne8_ayna_224ebd08:

    # si "Deliğe yaklaşıyorum. Etrafında hava... emiyor. Az az. Sabırla."
    si "I approach the hole. The air around it is... being drawn in. Little by little. Patiently."

# game/scene8_ayna.rpy:261
translate english sahne8_ayna_78f58423:

    # s "Ne vereyim?"
    s "What should I give?"

# game/scene8_ayna.rpy:280
translate english sahne8_bedel_alev_ae35cfb7:

    # si "Lambanın kapağını açıyorum."
    si "I open the lamp's hatch."

# game/scene8_ayna.rpy:282
translate english sahne8_bedel_alev_d8c033c4:

    # si "Alevden bir dil uzanıyor — ince, kırmızı, isteksiz — ve deliğe akıyor."
    si "A tongue of flame reaches out — thin, red, reluctant — and flows into the hole."

# game/scene8_ayna.rpy:284
translate english sahne8_bedel_alev_b1caec74:

    # si "Delik içiyor."
    si "The hole drinks."

# game/scene8_ayna.rpy:288
translate english sahne8_bedel_alev_fb1ad886:

    # si "Alev zaten küçüktü. Şimdi bir nefes daha küçük."
    si "The flame was already small. Now it's a breath smaller."

# game/scene8_ayna.rpy:290
translate english sahne8_bedel_alev_6abf23b1:

    # si "Işığımın çemberi duvarlardan geri çekiliyor. Oda büyümüyor — dünyam küçülüyor."
    si "My circle of light pulls back from the walls. The room isn't growing — my world is shrinking."

# game/scene8_ayna.rpy:296
translate english sahne8_bedel_alev_85d7edd4:

    # si "Kapağı kapatıyorum. Alev eski boyunda değil artık."
    si "I close the hatch. The flame is not its old height anymore."

# game/scene8_ayna.rpy:300
translate english sahne8_bedel_alev_dcb506cf:

    # centered "{color=#cc2222}ALEV KÜÇÜLDÜ{/color}"
    centered "{color=#cc2222}THE FLAME SHRANK{/color}"

# game/scene8_ayna.rpy:304
translate english sahne8_bedel_alev_73e15598:

    # s "Biliyorum."
    s "I know."

# game/scene8_ayna.rpy:306
translate english sahne8_bedel_alev_5264d3eb:

    # s "Artık daha kısa."
    s "It's shorter now."

# game/scene8_ayna.rpy:315
translate english sahne8_bedel_kan_935f7c92:

    # si "Başparmağımı deliğin kenarına bastırıyorum."
    si "I press my thumb against the edge of the hole."

# game/scene8_ayna.rpy:317
translate english sahne8_bedel_kan_d4f00832:

    # si "Kenar keskin değil. Yine de kesiyor."
    si "The edge isn't sharp. It cuts anyway."

# game/scene8_ayna.rpy:319
translate english sahne8_bedel_kan_c7b97da6:

    # si "Kan, deliğin karanlığına yürüyor. Damlamıyor — {b}çekiliyor{/b}."
    si "The blood travels into the hole's darkness. It doesn't drip — it is {b}drawn{/b}."

# game/scene8_ayna.rpy:323
translate english sahne8_bedel_kan_dca7b86d:

    # si "Ve delik... duruyor. Tadıyor."
    si "And the hole... pauses. Tasting."

# game/scene8_ayna.rpy:325
translate english sahne8_bedel_kan_69560a9c:

    # s "Beni tanıdı."
    s "It recognized me."

# game/scene8_ayna.rpy:327
translate english sahne8_bedel_kan_7f41cb08:

    # s "Kule tatmıştı. Ayna kulenin aynası."
    s "The tower had tasted me. The mirror is the tower's mirror."

# game/scene8_ayna.rpy:329
translate english sahne8_bedel_kan_64e76d0f:

    # si "İkinci yudum ilkinden derin. Üçüncüsü daha da."
    si "The second sip is deeper than the first. The third, deeper still."

# game/scene8_ayna.rpy:333
translate english sahne8_bedel_kan_21694248:

    # si "Elimi çektiğimde parmağım beyaz. Kolum ağır."
    si "When I pull my hand back, my thumb is white. My arm is heavy."

# game/scene8_ayna.rpy:335
translate english sahne8_bedel_kan_0215edff:

    # si "Aldığı sadece kan değildi."
    si "Blood wasn't all it took."

# game/scene8_ayna.rpy:339
translate english sahne8_bedel_kan_f2b06cb3:

    # s "Verdim işte. Aç."
    s "There, I gave. Now open."

# game/scene8_ayna.rpy:348
translate english sahne8_bedel_ani_5de6bb04:

    # si "Delik sıcak bir şey istiyor. Kan gibi ama daha eski."
    si "The hole wants something warm. Like blood, but older."

# game/scene8_ayna.rpy:350
translate english sahne8_bedel_ani_d1289de5:

    # si "Gözlerimi kapatıyorum ve en dipteki şeyi buluyorum:"
    si "I close my eyes and find the thing at the very bottom:"

# game/scene8_ayna.rpy:352
translate english sahne8_bedel_ani_b4b8a1f1:

    # si "Yağmur. Çamur. Omuzlarımı çökerten bir zırh. Ve bana bağıran bir ses—"
    si "Rain. Mud. Armor crushing my shoulders. And a voice shouting at me—"

# game/scene8_ayna.rpy:354
translate english sahne8_bedel_ani_dfc53ee1:

    # si "Deliğe uzatıyorum. Avucumda, kuş gibi."
    si "I hold it out to the hole. In my palm, like a bird."

# game/scene8_ayna.rpy:356
translate english sahne8_bedel_ani_34718042:

    # si "Ve gidiyor."
    si "And it goes."

# game/scene8_ayna.rpy:358
translate english sahne8_bedel_ani_e1554201:

    # s "..."
    s "..."

# game/scene8_ayna.rpy:360
translate english sahne8_bedel_ani_24334619:

    # s "Az önce bir şey biliyordum."
    s "I knew something just now."

# game/scene8_ayna.rpy:362
translate english sahne8_bedel_ani_a6ed5061:

    # s "Yağmurla ilgili bir şey. Önemliydi. Yemin gibi bir şeydi."
    s "Something about rain. It was important. It was something like an oath."

# game/scene8_ayna.rpy:364
translate english sahne8_bedel_ani_823b25d2:

    # s "Neydi?"
    s "What was it?"

# game/scene8_ayna.rpy:368
translate english sahne8_bedel_ani_c5ec024e:

    # s "Sen de mi bilmiyorsun? Yoksa söylemiyor musun?"
    s "Do you not know either? Or are you not telling?"

# game/scene8_ayna.rpy:370
translate english sahne8_bedel_ani_c5fa646c:

    # s "İkisi de aynı kapıya çıkıyor zaten."
    s "Both come to the same door anyway."

# game/scene8_ayna.rpy:386
translate english sahne8_acilis_f072568d:

    # si "Delik... genişliyor."
    si "The hole... widens."

# game/scene8_ayna.rpy:388
translate english sahne8_acilis_1b4d8a92:

    # si "Bir gözbebeği gibi. Karanlık, camın tamamına yayılıyor."
    si "Like a pupil. The darkness spreads across the whole glass."

# game/scene8_ayna.rpy:390
translate english sahne8_acilis_e3887453:

    # si "Ayna artık bir çerçeve içinde duran gece."
    si "The mirror is now night, standing in a frame."

# game/scene8_ayna.rpy:392
translate english sahne8_acilis_7970d4b1:

    # s "Aynadaki adam nerede?"
    s "Where is the man in the mirror?"

# game/scene8_ayna.rpy:396
translate english sahne8_acilis_0f430a0c:

    # s "İçeride ne var?"
    s "What's inside?"

# game/scene8_ayna.rpy:400
translate english sahne8_acilis_eb4ced77:

    # si "Kelime göğsümde bir yeri buluyor. Kilit dilinin yuvasını bulması gibi."
    si "The word finds a place in my chest. Like a bolt finding its socket."

# game/scene8_ayna.rpy:402
translate english sahne8_acilis_4c2cc2b6:

    # s "Adım."
    s "My name."

# game/scene8_ayna.rpy:404
translate english sahne8_acilis_ac72cb23:

    # s "Bunca yol. Bunca ölü lamba. Ve adım, başladığım odada, camın arkasındaymış."
    s "All that road. All those dead lamps. And my name was in the room where I started, behind the glass."

# game/scene8_ayna.rpy:406
translate english sahne8_acilis_762ce4c4:

    # s "En uzak yer hep en yakını."
    s "The farthest place is always the nearest one."

# game/scene8_ayna.rpy:413
translate english sahne8_uzanis_7e01a435:

    # si "Kolumu camın olduğu yere sokuyorum."
    si "I push my arm into where the glass used to be."

# game/scene8_ayna.rpy:415
translate english sahne8_uzanis_2bb083a6:

    # si "Direnç yok. Soğuk yok. Hiçlik var — kolumun olduğu yerde kolumun olmadığı hissi."
    si "No resistance. No cold. Only nothing — the feeling of my arm not being where my arm is."

# game/scene8_ayna.rpy:417
translate english sahne8_uzanis_c6645dd1:

    # si "Dirseğe kadar. Omza kadar."
    si "To the elbow. To the shoulder."

# game/scene8_ayna.rpy:419
translate english sahne8_uzanis_eb91c11c:

    # si "Parmaklarım karanlığı tarıyor. Bir şey var. Uzakta. Küçük ve sıcak."
    si "My fingers comb the darkness. There is something. Far away. Small and warm."

# game/scene8_ayna.rpy:421
translate english sahne8_uzanis_c438fb43:

    # si "Ve tam o anda—"
    si "And at that exact moment—"

# game/scene8_ayna.rpy:423
translate english sahne8_uzanis_9941031b:

    # si "Taşların ardından bir uğultu. Altın. Ilık. Tanıdık."
    si "A hum from behind the stones. Golden. Warm. Familiar."

# game/scene8_ayna.rpy:425
translate english sahne8_uzanis_c1fbea93:

    # si "Bir ninni gibi. Kimse söylemiyor ama bir ninni."
    si "Like a lullaby. No one is singing it, but it's a lullaby."

# game/scene8_ayna.rpy:427
translate english sahne8_uzanis_00e71ffd:

    # s "Gözkapaklarım..."
    s "My eyelids..."

# game/scene8_ayna.rpy:429
translate english sahne8_uzanis_6dfb3e12:

    # si "Uğultu ağırlaşıyor. Uyku, sıcak bir el gibi enseme yerleşiyor."
    si "The hum grows heavy. Sleep settles on the back of my neck like a warm hand."

# game/scene8_ayna.rpy:438
translate english sahne8_uzanis_e7773364:

    # s "Sesini duyuyorum."
    s "I hear your voice."

# game/scene8_ayna.rpy:440
translate english sahne8_uzanis_98487f30:

    # s "Ama ya uyku senden kurtulmanın tek yoluysa?"
    s "But what if sleep is the only way to be rid of you?"

# game/scene8_ayna.rpy:442
translate english sahne8_uzanis_55c07c49:

    # si "Bir an — sadece bir an — bırakıyorum. Altın uğultu gözkapaklarımın altına sızıyor."
    si "For a moment — just a moment — I let go. The golden hum seeps under my eyelids."

# game/scene8_ayna.rpy:444
translate english sahne8_uzanis_ca3ffce1:

    # si "Sıcak. Nazik. {b}Aç.{/b}"
    si "Warm. Gentle. {b}Hungry.{/b}"

# game/scene8_ayna.rpy:446
translate english sahne8_uzanis_abbcd44e:

    # si "Ve açlığı hissettiğim anda kendim geri çekiliyorum. Sana itaatten değil. Korkudan."
    si "And the instant I feel the hunger, I pull back on my own. Not out of obedience to you. Out of fear."

# game/scene8_ayna.rpy:448
translate english sahne8_uzanis_d6ed8740:

    # s "Senden kurtulmak için onlara uyuyacak değilim."
    s "I'm not going to sleep into their hands just to be rid of you."

# game/scene8_ayna.rpy:454
translate english sahne8_uzanis_4fa71598:

    # si "Silkiniyorum. Ense kökümdeki sıcak el bir an gevşiyor."
    si "I shake myself. The warm hand at the back of my neck loosens for a moment."

# game/scene8_ayna.rpy:456
translate english sahne8_uzanis_ac64854f:

    # s "Uyanığım. Uyanığım."
    s "I'm awake. I'm awake."

# game/scene8_ayna.rpy:458
translate english sahne8_uzanis_d8d3756a:

    # si "Ama uğultu durmuyor. Ve parmaklarım hâlâ boş."
    si "But the hum doesn't stop. And my fingers are still empty."

# game/scene8_ayna.rpy:460
translate english sahne8_uzanis_5451e7ef:

    # si "Zihnimi iki yerde birden tutmam gerekiyor: avucumda ve gözkapaklarımda."
    si "I have to hold my mind in two places at once: in my palm and in my eyelids."

# game/scene8_ayna.rpy:481
translate english sahne8_uzanis_krit_basari_cedd537b:

    # si "Uğultu bir an... duruyor. Sanki nefes alıyor."
    si "The hum... pauses for a moment. As if drawing breath."

# game/scene8_ayna.rpy:483
translate english sahne8_uzanis_krit_basari_2931d05e:

    # si "Ve o boşlukta parmaklarım kapanıyor. Küçük, sıcak, kıpır kıpır bir şeyin üstüne."
    si "And in that gap my fingers close. Over something small, warm, fluttering."

# game/scene8_ayna.rpy:485
translate english sahne8_uzanis_krit_basari_096fafdd:

    # si "Ve görüyorum—"
    si "And I see—"

# game/scene8_ayna.rpy:487
translate english sahne8_uzanis_krit_basari_e0d5bd88:

    # si "Camın öte yüzünde bir adam. Ben. Uyanık, kararlı, daha az yorgun bir ben."
    si "On the far side of the glass, a man. Me. An awake, resolute, less tired me."

# game/scene8_ayna.rpy:489
translate english sahne8_uzanis_krit_basari_47387e75:

    # si "Avucundakini karanlığa bırakıyor. Ve dudakları kıpırdıyor:"
    si "He sets what's in his palm down into the darkness. And his lips move:"

# game/scene8_ayna.rpy:491
translate english sahne8_uzanis_krit_basari_fc110c50:

    # s "{i}Duymasın.{/i}"
    s "{i}So it won't hear.{/i}"

# game/scene8_ayna.rpy:493
translate english sahne8_uzanis_krit_basari_e1554201:

    # s "..."
    s "..."

# game/scene8_ayna.rpy:495
translate english sahne8_uzanis_krit_basari_aa4f2f0d:

    # s "Adımı buraya ben koydum. Duymasın diye."
    s "I put my name here myself. So it wouldn't hear."

# game/scene8_ayna.rpy:497
translate english sahne8_uzanis_krit_basari_0cec45e5:

    # s "Kim duymasın?"
    s "So who wouldn't hear?"

# game/scene8_ayna.rpy:499
translate english sahne8_uzanis_krit_basari_e12d34cb:

    # si "Sorunun cevabı, sorudan önce gelmişti zaten."
    si "The answer had arrived before the question."

# game/scene8_ayna.rpy:509
translate english sahne8_uzanis_basari_cb53d716:

    # si "Uğultuyu bir kapı gibi kapatıyorum. Hâlâ orada — ama artık dışarıda."
    si "I shut the hum out like a door. It's still there — but outside now."

# game/scene8_ayna.rpy:511
translate english sahne8_uzanis_basari_f110c4ee:

    # si "Ve parmaklarım buluyor."
    si "And my fingers find it."

# game/scene8_ayna.rpy:513
translate english sahne8_uzanis_basari_660ff43e:

    # si "Küçük. Sıcak. Kıpır kıpır. Avucumda bir kuş yavrusu gibi."
    si "Small. Warm. Fluttering. Like a baby bird in my palm."

# game/scene8_ayna.rpy:515
translate english sahne8_uzanis_basari_f4ea6b9e:

    # s "Seni tanıyorum."
    s "I know you."

# game/scene8_ayna.rpy:517
translate english sahne8_uzanis_basari_61126176:

    # si "Tanımıyorum. Ama avucum tanıyor."
    si "I don't. But my palm does."

# game/scene8_ayna.rpy:525
translate english sahne8_uzanis_bedel_e728ae7d:

    # si "Uğultu ağır basıyor. Bir saniyelik bir dalış—"
    si "The hum wins out. A one-second slip under—"

# game/scene8_ayna.rpy:527
translate english sahne8_uzanis_bedel_f58b59d4:

    # si "Ve parmaklarımın ucundaki sıcaklık kayıyor. Derine."
    si "And the warmth at my fingertips slides away. Deeper."

# game/scene8_ayna.rpy:529
translate english sahne8_uzanis_bedel_51a84e0e:

    # s "Hayır. HAYIR."
    s "No. NO."

# game/scene8_ayna.rpy:531
translate english sahne8_uzanis_bedel_d4ef6a5c:

    # si "Omzumu boşluğa gömüyorum. Yanağım camın olduğu yerde. Karanlık kulağıma dolu."
    si "I bury my shoulder in the void. My cheek is where the glass used to be. Darkness fills my ear."

# game/scene8_ayna.rpy:533
translate english sahne8_uzanis_bedel_2fd01bc0:

    # si "Uzanıyorum. Zihnimin dikişleri atıyor."
    si "I reach. The seams of my mind are tearing."

# game/scene8_ayna.rpy:537
translate english sahne8_uzanis_bedel_297e0f8f:

    # si "Ve buluyorum. Avucum kapanıyor."
    si "And I find it. My palm closes."

# game/scene8_ayna.rpy:539
translate english sahne8_uzanis_bedel_022b7344:

    # si "Ama çekilirken... bir şey elimin üstünden geçiyor."
    si "But as I withdraw... something passes over my hand."

# game/scene8_ayna.rpy:541
translate english sahne8_uzanis_bedel_c0f0d675:

    # si "Parmak gibi. Sayar gibi."
    si "Like a finger. Like it's counting."

# game/scene8_ayna.rpy:543
translate english sahne8_uzanis_bedel_71b09b84:

    # s "Orada bir şey daha var. İsimden başka."
    s "There's something else in there. Besides the name."

# game/scene8_ayna.rpy:555
translate english sahne8_uzanis_krit_fiyasko_1e704417:

    # si "Uğultu bir el oluyor. El, bir kucak."
    si "The hum becomes a hand. The hand, an embrace."

# game/scene8_ayna.rpy:557
translate english sahne8_uzanis_krit_fiyasko_a29aaa2b:

    # si "Ve sıcak. Her şey sıcak."
    si "And warm. Everything is warm."

# game/scene8_ayna.rpy:559
translate english sahne8_uzanis_krit_fiyasko_7adf2e92:

    # si "Biri adımı söylüyor. Sevgiyle. Sabırla. Uzun zamandır ilk kez—"
    si "Someone says my name. With love. With patience. For the first time in so long—"

# game/scene8_ayna.rpy:561
translate english sahne8_uzanis_krit_fiyasko_b610f5ea:

    # s "...buradayım."
    s "...I'm here."

# game/scene8_ayna.rpy:563
translate english sahne8_uzanis_krit_fiyasko_0f722ac5:

    # si "Cevap verdim."
    si "I answered."

# game/scene8_ayna.rpy:565
translate english sahne8_uzanis_krit_fiyasko_7eed8516:

    # si "Cevap vermemeliydim."
    si "I should not have answered."

# game/scene8_ayna.rpy:567
translate english sahne8_uzanis_krit_fiyasko_9d6fe346:

    # si "Altın ışık gözkapaklarımın altında. Avucum... avucum açılıyor. Kendi kendine."
    si "Golden light under my eyelids. My palm... my palm is opening. All by itself."

# game/scene8_ayna.rpy:581
translate english sahne8_cekis_fc37aeb1:

    # si "Kolumu çekiyorum. Karanlık bırakmak istemiyor; bırakıyor."
    si "I pull my arm back. The darkness doesn't want to let go; it lets go."

# game/scene8_ayna.rpy:585
translate english sahne8_cekis_effe8d05:

    # si "Ayna yeniden ayna. Delik yok. Gece yok."
    si "The mirror is a mirror again. No hole. No night."

# game/scene8_ayna.rpy:587
translate english sahne8_cekis_3edfe05b:

    # si "Ve aynada yine bir adam var. Yorgun. Sakallı. Şakağında kurumuş kan."
    si "And there is a man in the mirror again. Tired. Bearded. Dried blood on his temple."

# game/scene8_ayna.rpy:589
translate english sahne8_cekis_e63a2774:

    # si "Avucum göğsümde. Kapalı."
    si "My palm is at my chest. Closed."

# game/scene8_ayna.rpy:591
translate english sahne8_cekis_3a2d563a:

    # s "Açmama gerek yok."
    s "I don't need to open it."

# game/scene8_ayna.rpy:593
translate english sahne8_cekis_0652f564:

    # si "İsim avuçtan girmez. Nefesle girer."
    si "A name doesn't enter through the palm. It enters with the breath."

# game/scene8_ayna.rpy:595
translate english sahne8_cekis_15e6308c:

    # si "Nefes alıyorum."
    si "I breathe in."

# game/scene8_ayna.rpy:599
translate english sahne8_cekis_e1554201:

    # s "..."
    s "..."

# game/scene8_ayna.rpy:601
translate english sahne8_cekis_e9008ee6:

    # si "Ve biliyorum."
    si "And I know."

# game/scene8_ayna.rpy:603
translate english sahne8_cekis_ebe2fbb1:

    # si "Adımı biliyorum."
    si "I know my name."

# game/scene8_ayna.rpy:607
translate english sahne8_cekis_6aeecac4:

    # si "Aynadaki yüz aynı yüz. Ama artık üstüne oturan bir şey var."
    si "The face in the mirror is the same face. But now something rests upon it."

# game/scene8_ayna.rpy:609
translate english sahne8_cekis_76b12c7c:

    # si "İsimsiz bir yüz bir oda gibidir. Şimdi odada biri oturuyor."
    si "A nameless face is like a room. Now someone lives in the room."

# game/scene8_ayna.rpy:616
translate english sahne8_isim_6f45de5f:

    # s "Duydun mu?"
    s "Did you hear it?"

# game/scene8_ayna.rpy:618
translate english sahne8_isim_359de554:

    # si "Soruyu ben sordum. Cevabı duymaktan korkarak."
    si "I asked the question myself. Afraid of hearing the answer."

# game/scene8_ayna.rpy:625
translate english sahne8_isim_d911b0d6:

    # s "Hayır."
    s "No."

# game/scene8_ayna.rpy:629
translate english sahne8_isim_65c8c125:

    # s "Sönmüş ne demişti? {i}Bulduğunda ona söyleme.{/i}"
    s "What did the Snuffed say? {i}When you find it, don't tell it.{/i}"

# game/scene8_ayna.rpy:631
translate english sahne8_isim_cb0f7a1e:

    # s "O uyarıyı, onu bulan herkes ödeyerek öğrenmiş."
    s "Everyone who found that warning paid to learn it."

# game/scene8_ayna.rpy:633
translate english sahne8_isim_9679ad4b:

    # s "İsim fısıltıya verilmez."
    s "A name is not given to a whisper."

# game/scene8_ayna.rpy:635
translate english sahne8_isim_a31f4dd5:

    # s "Bunu neden bildiğimi bilmiyorum. Ama kanım biliyor."
    s "I don't know why I know that. But my blood knows."

# game/scene8_ayna.rpy:641
translate english sahne8_isim_ff466454:

    # s "Sessizsin."
    s "You're silent."

# game/scene8_ayna.rpy:643
translate english sahne8_isim_e1be5bbf:

    # s "Sessizliğin aç ama."
    s "But your silence is hungry."

# game/scene8_ayna.rpy:645
translate english sahne8_isim_8acc8b28:

    # si "Kafamın içindeki boşluk, bir ağız gibi. Kibarca kapalı. Ama ağız."
    si "The emptiness inside my head is like a mouth. Politely closed. But a mouth."

# game/scene8_ayna.rpy:651
translate english sahne8_isim_0beca692:

    # s "\"Bana bile.\""
    s "\"Not even you.\""

# game/scene8_ayna.rpy:653
translate english sahne8_isim_4854da5c:

    # s "\"Bile\"nin içinde ne çok şey var."
    s "How much lives inside that \"even.\""

# game/scene8_ayna.rpy:655
translate english sahne8_isim_b60b1a75:

    # si "Kelimeyi evirip çeviriyorum. İçinde bir yakınlık iddiası. İçinde bir feragat."
    si "I turn the word over. There's a claim of closeness in it. There's a renunciation in it."

# game/scene8_ayna.rpy:657
translate english sahne8_isim_ec70cb85:

    # s "Saklayacağım. Senden de."
    s "I will keep it. From you too."

# game/scene8_ayna.rpy:659
translate english sahne8_isim_43b71f44:

    # s "Ama bunu sen istedin. Bunu unutmayacağım."
    s "But you asked for that. I won't forget it."

# game/scene8_ayna.rpy:666
translate english sahne8_isim_65b15017:

    # s "Bir şey daha var, içimdeki."
    s "There's one more thing, you inside."

# game/scene8_ayna.rpy:668
translate english sahne8_isim_f29f166f:

    # s "Adımı oraya ben koymuşum. \"Duymasın\" diye."
    s "I put my name there myself. \"So it won't hear.\""

# game/scene8_ayna.rpy:670
translate english sahne8_isim_9ab775a9:

    # s "O cümleyi kurarken kimi düşünüyordum, biliyor musun?"
    s "Do you know who I was thinking of when I said that?"

# game/scene8_ayna.rpy:674
translate english sahne8_isim_b54138cd:

    # s "Ben de öyle düşünmüştüm."
    s "That's what I thought."

# game/scene8_ayna.rpy:689
translate english sahne8_son_0974ba68:

    # si "Lamba masada. Alev..."
    si "The lamp is on the table. The flame..."

# game/scene8_ayna.rpy:693
translate english sahne8_son_f3ed9883:

    # si "Alev artık bir alev değil. Bir közün anısı."
    si "The flame is no longer a flame. It's the memory of an ember."

# game/scene8_ayna.rpy:695
translate english sahne8_son_fcf4dd48:

    # s "Süre \"bir alev boyu\"ydu."
    s "The time was \"one flame's length.\""

# game/scene8_ayna.rpy:697
translate english sahne8_son_e9f45f96:

    # s "Ve ben alevi harcadım. Kapı için."
    s "And I spent the flame. For a door."

# game/scene8_ayna.rpy:699
translate english sahne8_son_914587d2:

    # s "Pazarlıkta hep aynı taraf kazanıyor. Ve o taraf hiç ben olmuyorum."
    s "The same side always wins the bargain. And that side is never me."

# game/scene8_ayna.rpy:703
translate english sahne8_son_132408d8:

    # si "Alev kısık. Her nefeste bir kum tanesi düşüyor sanki."
    si "The flame is low. As if a grain of sand falls with every breath."

# game/scene8_ayna.rpy:705
translate english sahne8_son_fcf4dd48_1:

    # s "Süre \"bir alev boyu\"ydu."
    s "The time was \"one flame's length.\""

# game/scene8_ayna.rpy:707
translate english sahne8_son_aa930f72:

    # s "Ve alev kimseyi beklemiyor."
    s "And the flame waits for no one."

# game/scene8_ayna.rpy:709
translate english sahne8_son_e54109b7:

    # si "Duvarların ardında uğultu sürüyor. Altın, ılık, sabırlı."
    si "Behind the walls, the hum continues. Golden, warm, patient."

# game/scene8_ayna.rpy:711
translate english sahne8_son_587d2fed:

    # si "Kızgın değiller. Aceleleri yok."
    si "They're not angry. They're in no hurry."

# game/scene8_ayna.rpy:713
translate english sahne8_son_32285517:

    # s "Uyumamı bekliyorlar. Herkes uyur."
    s "They're waiting for me to sleep. Everyone sleeps."

# game/scene8_ayna.rpy:715
translate english sahne8_son_60a78b76:

    # s "Ben uyumayacağım."
    s "I will not sleep."

# game/scene8_ayna.rpy:719
translate english sahne8_son_4ede9940:

    # s "Ya adı... ya kendini. Öyle demişti."
    s "The name... or yourself. That's what it said."

# game/scene8_ayna.rpy:721
translate english sahne8_son_8cd05dd7:

    # s "Yarım üçüncü yolun yalanını söyledi. Belki Koro da ikinin."
    s "The Half told the lie of the third way. Maybe the Choir told the lie of the two."

# game/scene8_ayna.rpy:723
translate english sahne8_son_e7c28496:

    # s "Öğrenmenin tek yolu var."
    s "There's only one way to find out."

# game/scene8_ayna.rpy:727
translate english sahne8_son_59704563:

    # s "Hep aynı kelime."
    s "Always the same word."

# game/scene8_ayna.rpy:729
translate english sahne8_son_61fc9492:

    # s "Ama ilk kez ben de aynı yöne yürümek istiyorum."
    s "But for the first time, I want to walk the same way."

# game/scene8_ayna.rpy:731
translate english sahne8_son_57d49c4f:

    # si "Kapıyı açıyorum. Koridor. Işığımın değdiği kadar dünya."
    si "I open the door. The corridor. As much world as my light touches."

# game/scene8_ayna.rpy:733
translate english sahne8_son_f702dc31:

    # si "Kule bekliyor. Alev sayıyor."
    si "The tower waits. The flame counts."

# game/scene8_ayna.rpy:735
translate english sahne8_son_02538f8a:

    # s "Kuleye dönüyoruz, içimdeki."
    s "We're going back to the tower, you inside."

# game/scene8_ayna.rpy:737
translate english sahne8_son_e0fd975d:

    # s "Ve ikimizden biri orada kalacak."
    s "And one of us is going to stay there."

translate english strings:

    # game/scene8_ayna.rpy:77
    old "«Yürü. Dur ve düşersin.»"
    new "«Walk. Stop and you fall.»"

    # game/scene8_ayna.rpy:87
    old "«Yaraya bas. Acı uyanıktır.»"
    new "«Press the wound. Pain stays awake.»"

    # game/scene8_ayna.rpy:101
    old "«Aleve bak. Alev uyumaz.»"
    new "«Look at the flame. The flame doesn't sleep.»"

    # game/scene8_ayna.rpy:266
    old "«Alevden ver. Bir nefes.»"
    new "«Give from the flame. One breath.»"

    # game/scene8_ayna.rpy:269
