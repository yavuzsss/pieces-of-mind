# English translation — scene7_inis.rpy (Scene 7: The Descent and the Half)

# game/scene7_inis.rpy:34
translate english sahne7_inis_99ad5259:

    # si "İniyoruz."
    si "We descend."

# game/scene7_inis.rpy:36
translate english sahne7_inis_71209da4:

    # si "Çıkarken saymayı bırakmıştım. İnerken de bırakıyorum."
    si "I gave up counting on the way up. I give up on the way down too."

# game/scene7_inis.rpy:38
translate english sahne7_inis_1c2389fa:

    # s "Tutarlılık iyidir."
    s "Consistency is good."

# game/scene7_inis.rpy:40
translate english sahne7_inis_c135c88e:

    # si "Basamaklar aynı değil. Çıkarken düzdüler. Şimdi... eğik."
    si "The steps aren't the same. They were level on the way up. Now they're... tilted."

# game/scene7_inis.rpy:42
translate english sahne7_inis_6f8d6a9a:

    # s "Kule bizi aynı yoldan bırakmıyor."
    s "The tower won't let us leave the way we came."

# game/scene7_inis.rpy:46
translate english sahne7_inis_d7340aff:

    # si "Ve basamaklar ayaklarıma yapışıyor sanki. Bir saniyelik bir isteksizlikle."
    si "And the steps seem to cling to my feet. With a second's reluctance."

# game/scene7_inis.rpy:48
translate english sahne7_inis_c4a0104f:

    # s "Kule tadımı biliyor. Bırakmak istemiyor."
    s "The tower knows my taste. It doesn't want to let go."

# game/scene7_inis.rpy:52
translate english sahne7_inis_83353ac3:

    # si "Kafamın içinde, altın parmağın gezdiği raflar... kaşınıyor."
    si "Inside my head, the shelves where the golden finger wandered... itch."

# game/scene7_inis.rpy:54
translate english sahne7_inis_e1b85f26:

    # s "Gitti. Ama parmak izi kaldı. Hâlâ orada."
    s "It's gone. But the fingerprint stayed. It's still there."

# game/scene7_inis.rpy:56
translate english sahne7_inis_d5cfd8d3:

    # s "Ya adı... ya kendini. Öyle dedi."
    s "The name... or yourself. That's what it said."

# game/scene7_inis.rpy:58
translate english sahne7_inis_b9f9ece1:

    # s "Kendini verirsen bana ne olur?"
    s "If you give yourself, what happens to me?"

# game/scene7_inis.rpy:62
translate english sahne7_inis_48fc7ee1:

    # s "Sönmüş'e ne olduysa o. Değil mi?"
    s "The same thing that happened to the Snuffed. Isn't it?"

# game/scene7_inis.rpy:69
translate english sahne7_inis_5e8d3f7b:

    # s "Bir şey daha var."
    s "There's one more thing."

# game/scene7_inis.rpy:71
translate english sahne7_inis_90921df2:

    # s "Alevin içinde biri vardı. Bir kadın. Beni çağırıyordu."
    s "There was someone in the flame. A woman. She was calling me."

# game/scene7_inis.rpy:73
translate english sahne7_inis_837ff209:

    # s "Sen de duydun mu?"
    s "Did you hear her too?"

# game/scene7_inis.rpy:80
translate english sahne7_inis_d9eab616:

    # si "Cevap hızlı geldi. Yine."
    si "The answer came fast. Again."

# game/scene7_inis.rpy:82
translate english sahne7_inis_cc95b57c:

    # s "Duymadın demek."
    s "You didn't hear her, then."

# game/scene7_inis.rpy:88
translate english sahne7_inis_8185b22e:

    # s "Susuyorsun."
    s "You're silent."

# game/scene7_inis.rpy:90
translate english sahne7_inis_c8a77715:

    # s "Son zamanlarda hep yanlış yerlerde susuyorsun."
    s "Lately you keep going silent in all the wrong places."

# game/scene7_inis.rpy:105
translate english sahne7_salon_donus_943f774c:

    # si "Salon. Binlerce oyuk, binlerce sönmüş lamba."
    si "The hall. Thousands of alcoves, thousands of dead lamps."

# game/scene7_inis.rpy:107
translate english sahne7_salon_donus_473742d7:

    # si "Ama bir şey değişmiş."
    si "But something has changed."

# game/scene7_inis.rpy:109
translate english sahne7_salon_donus_b85ceb52:

    # si "Alt sırada, daha önce boş olan bir oyukta: yeni bir lamba."
    si "In the bottom row, in an alcove that was empty before: a new lamp."

# game/scene7_inis.rpy:111
translate english sahne7_salon_donus_56dbc578:

    # si "Camı çatlak. İçi karanlık. Dokunuyorum — taşı hâlâ sıcak."
    si "Its glass is cracked. Its inside is dark. I touch it — the stone is still warm."

# game/scene7_inis.rpy:113
translate english sahne7_salon_donus_0a40b282:

    # s "Bunu tanıyorum. Bu onun lambası."
    s "I know this one. This is his lamp."

# game/scene7_inis.rpy:115
translate english sahne7_salon_donus_2dbd6e01:

    # s "Sönmüş'ün."
    s "The Snuffed's."

# game/scene7_inis.rpy:120
translate english sahne7_salon_donus_4c3cfee7:

    # s "Kule onu topladı. İzini verdiğin gece."
    s "The tower collected him. The night you gave away his trace."

# game/scene7_inis.rpy:122
translate english sahne7_salon_donus_d57405c7:

    # s "Onu sen verdin."
    s "You gave him up."

# game/scene7_inis.rpy:124
translate english sahne7_salon_donus_437abef2:

    # s "Ve ben seyrettim."
    s "And I watched."

# game/scene7_inis.rpy:128
translate english sahne7_salon_donus_9d77c274:

    # s "Sus. Artık susman daha iyi."
    s "Quiet. It's better when you're quiet now."

# game/scene7_inis.rpy:135
translate english sahne7_salon_donus_40e225bd:

    # s "Buraya kendi mi geldi? Yoksa kule mi getirdi?"
    s "Did he come here himself? Or did the tower bring him?"

# game/scene7_inis.rpy:139
translate english sahne7_salon_donus_ac117473:

    # s "Ama ölür."
    s "But they die."

# game/scene7_inis.rpy:145
translate english sahne7_salon_donus_28a5cd61:

    # si "Kendi oyuğumun önünden geçiyorum. Levha. Çizikler."
    si "I pass my own alcove. The plaque. The scratches."

# game/scene7_inis.rpy:147
translate english sahne7_salon_donus_d021dc2b:

    # si "Ve halka... parlatılmış. Yeni cilalanmış gibi."
    si "And the ring is... polished. As if freshly buffed."

# game/scene7_inis.rpy:149
translate english sahne7_salon_donus_b5d63a6e:

    # s "Beni bekliyorlar."
    s "They're expecting me."

# game/scene7_inis.rpy:164
translate english sahne7_kapi_esik_b73610ff:

    # si "Merdivenin dibi. Kulenin ağzı: ağır, demir kuşaklı bir kapı."
    si "The bottom of the stairs. The tower's mouth: a heavy, iron-banded door."

# game/scene7_inis.rpy:166
translate english sahne7_kapi_esik_0e3140e0:

    # si "Koro'nun dediği kapı bu olmalı."
    si "This must be the door the Choir spoke of."

# game/scene7_inis.rpy:168
translate english sahne7_kapi_esik_9b78166d:

    # s "Ve önünde biri var."
    s "And there is someone in front of it."

# game/scene7_inis.rpy:170
translate english sahne7_kapi_esik_1c974166:

    # si "Işığımın çemberinin tam sınırında. Bir adım içeride, bir adım dışarıda."
    si "Right at the edge of my circle of light. One step inside, one step out."

# game/scene7_inis.rpy:172
translate english sahne7_kapi_esik_8a8dc3a7:

    # si "Bir adam. Neredeyse."
    si "A man. Almost."

# game/scene7_inis.rpy:174
translate english sahne7_kapi_esik_b1f45958:

    # si "Duruşu yanlış. Eklemler doğru yerde ama... sonradan öğrenilmiş gibi."
    si "His posture is wrong. The joints are in the right places, but... like they were learned later."

# game/scene7_inis.rpy:176
translate english sahne7_kapi_esik_e34caabc:

    # s "Koridordaki. Takipçi. Sen misin?"
    s "The one from the corridor. The follower. Is that you?"

# game/scene7_inis.rpy:178
translate english sahne7_kapi_esik_4be6f116:

    # yr "Işık."
    yr "The light."

# game/scene7_inis.rpy:180
translate english sahne7_kapi_esik_c4b2fd71:

    # yr "Işığı indir. Konuşalım."
    yr "Lower the light. Let's talk."

# game/scene7_inis.rpy:184
translate english sahne7_kapi_esik_ae4a2dc9:

    # si "İndirmiyorum."
    si "I don't lower it."

# game/scene7_inis.rpy:186
translate english sahne7_kapi_esik_45ae6203:

    # yr "Peki. Peki. Işıklı konuşuruz."
    yr "Fine. Fine. We'll talk with the light on."

# game/scene7_inis.rpy:188
translate english sahne7_kapi_esik_e4982061:

    # si "Gülümsüyor. Dişleri doğru sayıda. Yine de yanlış."
    si "He smiles. The right number of teeth. Still wrong."

# game/scene7_inis.rpy:197
translate english sahne7_tanisma_f46cbabe:

    # si "Başını yana eğiyor. Bana değil — içime bakıyor."
    si "He tilts his head. He's not looking at me — he's looking into me."

# game/scene7_inis.rpy:199
translate english sahne7_tanisma_19c9419f:

    # yr "Sen. İçindeki."
    yr "You. The one inside."

# game/scene7_inis.rpy:201
translate english sahne7_tanisma_3d418a34:

    # yr "Seni tanıyorum. Türünü tanıyorum."
    yr "I know you. I know your kind."

# game/scene7_inis.rpy:203
translate english sahne7_tanisma_9f68ffb7:

    # yr "Ben de senin gibiydim. Fısıltıydım. Kiracıydım."
    yr "I was like you once. A whisper. A tenant."

# game/scene7_inis.rpy:205
translate english sahne7_tanisma_f2306b1f:

    # yr "Artık değilim."
    yr "Not anymore."

# game/scene7_inis.rpy:207
translate english sahne7_tanisma_039d5e5a:

    # s "Nesin peki?"
    s "Then what are you?"

# game/scene7_inis.rpy:209
translate english sahne7_tanisma_45dd9219:

    # yr "Ev sahibi."
    yr "The landlord."

# game/scene7_inis.rpy:211
translate english sahne7_tanisma_9f07afc6:

    # si "Kendi göğsünü gösteriyor. Gururla. Çalınmış bir ceket gösterir gibi."
    si "He gestures at his own chest. With pride. Like showing off a stolen coat."

# game/scene7_inis.rpy:213
translate english sahne7_tanisma_34c2728c:

    # yr "Adım var. Adım. VAR."
    yr "I have a name. A name. I HAVE one."

# game/scene7_inis.rpy:215
translate english sahne7_tanisma_f92ba0ab:

    # si "Ve söylüyor."
    si "And he says it."

# game/scene7_inis.rpy:217
translate english sahne7_tanisma_e384280d:

    # si "Bir isim söylüyor. Duyuyorum — ve aynı anda unutuyorum."
    si "He says a name. I hear it — and forget it in the same instant."

# game/scene7_inis.rpy:219
translate english sahne7_tanisma_96b5698c:

    # si "İsim ağzında durmuyor. Çünkü ona ait değil."
    si "The name won't stay in his mouth. Because it doesn't belong to him."

# game/scene7_inis.rpy:221
translate english sahne7_tanisma_3fa73f8f:

    # s "Adını taşıyamıyorsun bile."
    s "You can't even carry your own name."

# game/scene7_inis.rpy:223
translate english sahne7_tanisma_237a51bc:

    # yr "Taşıyorum. TAŞIYORUM."
    yr "I carry it. I CARRY IT."

# game/scene7_inis.rpy:225
translate english sahne7_tanisma_cf57384e:

    # si "Sesi bir an çatallanıyor: altında başka bir ses, çok derinden. Ağlıyor olabilir."
    si "His voice forks for a moment: another voice underneath, from very deep. It might be weeping."

# game/scene7_inis.rpy:234
translate english sahne7_teklif_8c9c05db:

    # si "Bir adım yaklaşıyor. Işığın sınırı derisinde cızırdıyor. Aldırmıyor."
    si "He steps closer. The light's edge sizzles on his skin. He doesn't care."

# game/scene7_inis.rpy:236
translate english sahne7_teklif_6c3c9c00:

    # yr "Dinle, içindeki. Kardeşim. Dinle."
    yr "Listen, you inside. My sibling. Listen."

# game/scene7_inis.rpy:238
translate english sahne7_teklif_52cf498a:

    # yr "Koro sana ne dedi? Ya adı... ya kendini. Değil mi? Hep aynı şarkı."
    yr "What did the Choir tell you? The name... or yourself. Right? Always the same song."

# game/scene7_inis.rpy:240
translate english sahne7_teklif_71b29c9c:

    # yr "Üçüncü yol var."
    yr "There is a third way."

# game/scene7_inis.rpy:242
translate english sahne7_teklif_83de5ea9:

    # yr "Adı Koro'ya verme. {b}Kendine al.{/b}"
    yr "Don't give the name to the Choir. {b}Take it for yourself.{/b}"

# game/scene7_inis.rpy:244
translate english sahne7_teklif_895bcff8:

    # yr "Beden zaten senin. Hep senindi. Ben aldım — özgürüm."
    yr "The body is already yours. It always was. I took mine — I'm free."

# game/scene7_inis.rpy:246
translate english sahne7_teklif_5792cdd5:

    # si "Özgür diyor. Kulenin kapısında bekleyen, ışığın almadığı, adı ağzından dökülen şey."
    si "Free, he says. The thing waiting at the tower's door, that the light rejects, whose name spills from his mouth."

# game/scene7_inis.rpy:248
translate english sahne7_teklif_2a6b82bc:

    # s "İçimdeki... onu dinliyor musun?"
    s "You inside me... are you listening to him?"

# game/scene7_inis.rpy:255
translate english sahne7_teklif_21a8484e:

    # si "Kafamın içi kararlı bir sessizlik."
    si "Inside my head, a resolute silence."

# game/scene7_inis.rpy:257
translate english sahne7_teklif_e75afc3f:

    # s "Güzel."
    s "Good."

# game/scene7_inis.rpy:259
translate english sahne7_teklif_b614d17f:

    # yr "Yalan söylüyor. Hepimiz yalan söyleriz. İşimiz bu."
    yr "It's lying. We all lie. It's what we do."

# game/scene7_inis.rpy:263
translate english sahne7_teklif_860ffb72:

    # s "Cevap vermiyorsun."
    s "You're not answering."

# game/scene7_inis.rpy:265
translate english sahne7_teklif_bc582548:

    # s "Cevap vermeni isterdim."
    s "I wish you would."

# game/scene7_inis.rpy:267
translate english sahne7_teklif_cf8108e1:

    # yr "Susuyor, bak. Düşünüyor demek."
    yr "It's quiet, see. That means it's thinking."

# game/scene7_inis.rpy:273
translate english sahne7_teklif_d49245b9:

    # si "Kafamın içinde tek kelime. Merakla, sessizce:"
    si "A single word inside my head. Curious, quiet:"

# game/scene7_inis.rpy:275
translate english sahne7_teklif_e1554201:

    # s "..."
    s "..."

# game/scene7_inis.rpy:277
translate english sahne7_teklif_c109e1f5:

    # s "\"Nasıl\" mı?"
    s "\"How\"?"

# game/scene7_inis.rpy:279
translate english sahne7_teklif_47202a41:

    # s "Bunu mu soruyorsun? {b}Nasıl mı?{/b}"
    s "That's your question? {b}How?{/b}"

# game/scene7_inis.rpy:281
translate english sahne7_teklif_6a519915:

    # yr "İşte. İşte bu."
    yr "There. There it is."

# game/scene7_inis.rpy:283
translate english sahne7_teklif_a5655c16:

    # si "Yarım'ın gülümsemesi genişliyor. Fazla genişliyor."
    si "The Half's smile widens. Too wide."

# game/scene7_inis.rpy:293
translate english sahne7_yuzlesme_secim_8a224e31:

    # si "Yarım bir adım daha atıyor. Işık derisini yakıyor; umursamıyor."
    si "The Half takes another step. The light burns his skin; he doesn't care."

# game/scene7_inis.rpy:295
translate english sahne7_yuzlesme_secim_560f1fe1:

    # yr "Kapı açılmayacak, ben burada durdukça."
    yr "The door won't open while I stand here."

# game/scene7_inis.rpy:297
translate english sahne7_yuzlesme_secim_8be1f1ba:

    # yr "Konuşalım. Uzun uzun konuşalım."
    yr "Let's talk. Let's talk for a long, long time."

# game/scene7_inis.rpy:322
translate english sahne7_sor_6e600984:

    # s "Adı nasıl aldın?"
    s "How did you take the name?"

# game/scene7_inis.rpy:324
translate english sahne7_sor_b04aeefe:

    # si "Yarım'ın yüzü yumuşuyor. Anı güzelmiş gibi."
    si "The Half's face softens. As if the memory were sweet."

# game/scene7_inis.rpy:326
translate english sahne7_sor_9b963533:

    # yr "Kolayca."
    yr "Easily."

# game/scene7_inis.rpy:328
translate english sahne7_sor_70a3aa3b:

    # yr "O uyuyordu."
    yr "He was asleep."

# game/scene7_inis.rpy:330
translate english sahne7_sor_718986da:

    # yr "Hepsi uyurken verir. Uyanıkken sıkı tutarlar. Ama uykuda..."
    yr "They all give it up in their sleep. Awake, they hold on tight. But in sleep..."

# game/scene7_inis.rpy:332
translate english sahne7_sor_cfab69f6:

    # yr "Uykuda ellerini açarlar."
    yr "In sleep, they open their hands."

# game/scene7_inis.rpy:334
translate english sahne7_sor_34d10297:

    # si "Lambamın tabanındaki kazıma. UYUMA."
    si "The carving on the base of my lamp. DON'T SLEEP."

# game/scene7_inis.rpy:336
translate english sahne7_sor_084db714:

    # s "Bunu bilen biri yazmış demek."
    s "So it was written by someone who knew."

# game/scene7_inis.rpy:338
translate english sahne7_sor_ecb89002:

    # yr "Bilen biri. Evet. Bilenler yazar."
    yr "Someone who knew. Yes. The ones who know, write."

# game/scene7_inis.rpy:340
translate english sahne7_sor_d3fbc2b7:

    # si "Konuşurken iki adım daha yaklaşmış. Fark etmemişim."
    si "While talking, he's come two steps closer. I didn't notice."

# game/scene7_inis.rpy:353
translate english sahne7_isik_8c0fcfe0:

    # si "Lambayı kaldırıyorum. Göz hizasına. Onun gözlerinin hizasına."
    si "I raise the lamp. To eye level. To the level of his eyes."

# game/scene7_inis.rpy:355
translate english sahne7_isik_50ef5611:

    # si "Ve camın küçük kapağını açıyorum."
    si "And I open the little hatch in the glass."

# game/scene7_inis.rpy:357
translate english sahne7_isik_e2259338:

    # s "Işık istedin. Al."
    s "You wanted light. Take it."

# game/scene7_inis.rpy:359
translate english sahne7_isik_cbfbfe69:

    # si "Alev, çıplak, kırmızı, dosdoğru yüzüne vuruyor."
    si "The flame, naked, red, strikes him full in the face."

# game/scene7_inis.rpy:361
translate english sahne7_isik_af646ba5:

    # yr "HAYIR—"
    yr "NO—"

# game/scene7_inis.rpy:363
translate english sahne7_isik_6ea8a07d:

    # si "Derisi ışığın altında kâğıt gibi. Bedenin gerçek sahibi neredeyse görünüyor — bir an, altında, hâlâ orada."
    si "His skin is like paper under the light. The body's true owner is almost visible — for a moment, underneath, still there."

# game/scene7_inis.rpy:365
translate english sahne7_isik_57297fab:

    # si "Yarım çığlık atıyor. İki ses birden: çalan ve çalınan."
    si "The Half screams. Two voices at once: the thief and the stolen."

# game/scene7_inis.rpy:369
translate english sahne7_isik_06ebc22c:

    # si "Ve karanlığa savruluyor. Kapının önü boş."
    si "And he is flung into the dark. The door stands clear."

# game/scene7_inis.rpy:371
translate english sahne7_isik_caa7cd08:

    # si "Kapağı kapatıyorum. Alev..."
    si "I close the hatch. The flame..."

# game/scene7_inis.rpy:375
translate english sahne7_isik_fb1ad886:

    # si "Alev zaten küçüktü. Şimdi bir nefes daha küçük."
    si "The flame was already small. Now it's a breath smaller."

# game/scene7_inis.rpy:377
translate english sahne7_isik_e3442295:

    # s "Dünya bir nefes daha dar."
    s "The world is a breath narrower."

# game/scene7_inis.rpy:383
translate english sahne7_isik_9ae410c6:

    # si "Alev eski boyunda değil artık."
    si "The flame is not its old height anymore."

# game/scene7_inis.rpy:387
translate english sahne7_isik_dcb506cf:

    # centered "{color=#cc2222}ALEV KÜÇÜLDÜ{/color}"
    centered "{color=#cc2222}THE FLAME SHRANK{/color}"

# game/scene7_inis.rpy:391
translate english sahne7_isik_ba0aa065:

    # s "Kurtardım. Farklı şeyler."
    s "I saved us. Not the same thing."

# game/scene7_inis.rpy:404
translate english sahne7_dovus_07c7d446:

    # si "Kılıç kınsız, pas içinde, kör."
    si "The sword is sheathless, rusted, blunt."

# game/scene7_inis.rpy:406
translate english sahne7_dovus_6979a616:

    # si "Ama elimde doğru duruyor. Yıllardır ilk kez bir şey doğru duruyor."
    si "But it sits right in my hand. For the first time in years, something sits right."

# game/scene7_inis.rpy:408
translate english sahne7_dovus_edea7e19:

    # s "Çekil. Son söz."
    s "Move. Last warning."

# game/scene7_inis.rpy:410
translate english sahne7_dovus_73657d53:

    # yr "Sözler. Hep sözler. Bedenler daha dürüst."
    yr "Words. Always words. Bodies are more honest."

# game/scene7_inis.rpy:412
translate english sahne7_dovus_60f26c3d:

    # si "Üstüme geliyor."
    si "He comes at me."

# game/scene7_inis.rpy:416
translate english sahne7_dovus_3aa5bbbb:

    # si "Elim boş. Yumruklarımı sıkıyorum."
    si "My hands are empty. I clench my fists."

# game/scene7_inis.rpy:418
translate english sahne7_dovus_edea7e19_1:

    # s "Çekil. Son söz."
    s "Move. Last warning."

# game/scene7_inis.rpy:420
translate english sahne7_dovus_9dfa4bca:

    # yr "Silahsız. Fısıltın sana kılıç bile bulamadı mı?"
    yr "Unarmed. Couldn't your whisper even find you a sword?"

# game/scene7_inis.rpy:422
translate english sahne7_dovus_60f26c3d_1:

    # si "Üstüme geliyor."
    si "He comes at me."

# game/scene7_inis.rpy:438
translate english sahne7_dovus_tur_48804c79:

    # si "Yarım toparlanıyor. Yeniden geliyor — daha alçak, daha hızlı."
    si "The Half recovers. He comes again — lower, faster."

# game/scene7_inis.rpy:442
translate english sahne7_dovus_tur_331f526c:

    # si "Dönüyor. Gülümseme gitti; geriye sadece açlık kaldı."
    si "He circles. The smile is gone; only the hunger remains."

# game/scene7_inis.rpy:469
translate english sahne7_dovus_tur_ff29c930:

    # si "Hamlem değiyor — ama sıyırıyor. Derisinden kâğıt gibi bir parça, o kadar."
    si "My strike lands — but grazes. A paper-thin piece of his skin, nothing more."

# game/scene7_inis.rpy:473
translate english sahne7_dovus_tur_cf9c64cc:

    # si "Kör kılıç etine gömülüyor. İçinden kan yerine toz dökülüyor."
    si "The blunt sword sinks into his flesh. Dust pours out instead of blood."

# game/scene7_inis.rpy:477
translate english sahne7_dovus_tur_dbe963a3:

    # si "Yumruğum göğsüne oturuyor. İçinde bir şey çatırdıyor. Boş bir şey."
    si "My fist lands square in his chest. Something cracks inside. Something hollow."

# game/scene7_inis.rpy:479
translate english sahne7_dovus_tur_07520054:

    # si "Yarım sendeliyor. Ama düşmüyor."
    si "The Half staggers. But doesn't fall."

# game/scene7_inis.rpy:481
translate english sahne7_dovus_tur_b0148e30:

    # yr "Daha. DAHA."
    yr "More. MORE."

# game/scene7_inis.rpy:488
translate english sahne7_dovus_tur_7e30aecd:

    # si "Hamlem boşa gidiyor. Ve pençe gibi parmaklar açığımı buluyor."
    si "My strike misses. And claw-like fingers find my opening."

# game/scene7_inis.rpy:490
translate english sahne7_dovus_tur_0dfba3ce:

    # si "Et yırtılıyor. Sıcak bir çizgi, omzumdan dirseğime."
    si "Flesh tears. A hot line, from my shoulder to my elbow."

# game/scene7_inis.rpy:504
translate english sahne7_dovus_krit_basari_5c034fc0:

    # si "Kör kılıç, doğru elde keskinleşiyor."
    si "A blunt sword grows sharp in the right hand."

# game/scene7_inis.rpy:506
translate english sahne7_dovus_krit_basari_69033cf5:

    # si "Tek hamle. Omuzdan göğse."
    si "One stroke. From shoulder to chest."

# game/scene7_inis.rpy:510
translate english sahne7_dovus_krit_basari_8a25b1c9:

    # si "İlk hamlesini yakalıyorum. Bileğini büküyorum, dizimi göğsüne."
    si "I catch his first lunge. I twist his wrist, drive my knee into his chest."

# game/scene7_inis.rpy:512
translate english sahne7_dovus_krit_basari_f028b3fc:

    # si "Yarım taşa yığılıyor."
    si "The Half collapses onto the stone."

# game/scene7_inis.rpy:514
translate english sahne7_dovus_krit_basari_d33e8f45:

    # si "İçinden hiçbir şey dökülmüyor. İçi yok."
    si "Nothing spills out of him. There is no inside."

# game/scene7_inis.rpy:516
translate english sahne7_dovus_krit_basari_8a28cf21:

    # yr "Adım..."
    yr "My name..."

# game/scene7_inis.rpy:518
translate english sahne7_dovus_krit_basari_eb7db023:

    # yr "Adımı... düşürdüm..."
    yr "I've... dropped my name..."

# game/scene7_inis.rpy:520
translate english sahne7_dovus_krit_basari_39f97604:

    # si "Ve isim onu bırakıyor. Nasıl olduğunu göremiyorum ama hissediyorum: oda bir an hafifliyor."
    si "And the name lets go of him. I can't see how, but I feel it: for a moment, the room grows lighter."

# game/scene7_inis.rpy:522
translate english sahne7_dovus_krit_basari_354625c4:

    # si "Yerde artık bir adam yatıyor. Sadece bir adam. Yüzü... rahat."
    si "Now a man lies on the ground. Just a man. His face is... at peace."

# game/scene7_inis.rpy:526
translate english sahne7_dovus_krit_basari_ff77cf1b:

    # s "Sonunda uyuyabildi."
    s "He finally got to sleep."

# game/scene7_inis.rpy:534
translate english sahne7_dovus_basari_7b0ba098:

    # si "Son vuruş. İçindeki boşluk, dışındaki bedeni artık taşıyamıyor."
    si "The last blow. The emptiness inside can no longer carry the body outside."

# game/scene7_inis.rpy:536
translate english sahne7_dovus_basari_baea855e:

    # si "Yarım geriliyor, iki büklüm, karanlığa doğru."
    si "The Half recoils, doubled over, toward the dark."

# game/scene7_inis.rpy:538
translate english sahne7_dovus_basari_2d76f3ed:

    # yr "Peki. Peki."
    yr "Fine. Fine."

# game/scene7_inis.rpy:540
translate english sahne7_dovus_basari_9b3d1cff:

    # yr "Ben beklerim. Beklemekte iyiyim."
    yr "I will wait. I am good at waiting."

# game/scene7_inis.rpy:542
translate english sahne7_dovus_basari_5d9e0e16:

    # yr "Seni önceki yüzünle de görmüştüm. Sonrakiyle de görürüm."
    yr "I saw you with your previous face. I will see you with the next."

# game/scene7_inis.rpy:544
translate english sahne7_dovus_basari_970c53ee:

    # si "Karanlık onu alıyor."
    si "The dark takes him."

# game/scene7_inis.rpy:546
translate english sahne7_dovus_basari_e4b5caab:

    # s "\"Önceki yüzüm\"?"
    s "\"My previous face\"?"

# game/scene7_inis.rpy:548
translate english sahne7_dovus_basari_e016cceb:

    # s "Ne demek istedi?"
    s "What did he mean?"

# game/scene7_inis.rpy:560
translate english sahne7_dovus_krit_fiyasko_ed212032:

    # si "Hamlem boşa düşüyor. Taş kaygan — hayır. Taş kaygan değil."
    si "My strike misses. The stone is slick — no. The stone isn't slick."

# game/scene7_inis.rpy:562
translate english sahne7_dovus_krit_fiyasko_886ecbbe:

    # si "Ayaklarım. Ayaklarım yine benim değil."
    si "My feet. My feet aren't mine again."

# game/scene7_inis.rpy:564
translate english sahne7_dovus_krit_fiyasko_9c1bfb76:

    # yr "İşte."
    yr "There."

# game/scene7_inis.rpy:566
translate english sahne7_dovus_krit_fiyasko_8ba6f44c:

    # si "Kollarını açıyor. Ve sarılıyor."
    si "He opens his arms. And embraces me."

# game/scene7_inis.rpy:568
translate english sahne7_dovus_krit_fiyasko_0417b627:

    # si "Soğuk değil. Daha kötüsü: eksik. Yarım bir şeyin içine çekiliyorum."
    si "Not cold. Worse: incomplete. I am being pulled into something half."

# game/scene7_inis.rpy:570
translate english sahne7_dovus_krit_fiyasko_0d9b315c:

    # yr "Tamamla beni."
    yr "Complete me."

# game/scene7_inis.rpy:584
translate english sahne7_kapi_acilis_1eed3141:

    # si "Kapının önü boş. Ayaktayım. İkisi de mucize."
    si "The door stands clear. I'm still standing. Both are miracles."

# game/scene7_inis.rpy:589
translate english sahne7_kapi_acilis_f158b20e:

    # si "Kapıya dönüyorum. Demir kuşaklar, ağır ahşap."
    si "I turn to the door. Iron bands, heavy wood."

# game/scene7_inis.rpy:591
translate english sahne7_kapi_acilis_b310d6a8:

    # si "Omuzluyorum. Direnmiyor. Sanki bekliyormuş."
    si "I shoulder it open. It doesn't resist. As if it had been waiting."

# game/scene7_inis.rpy:593
translate english sahne7_kapi_acilis_153c4242:

    # s "Dışarısı. Sonunda dışarısı."
    s "Outside. Finally, outside."

# game/scene7_inis.rpy:595
translate english sahne7_kapi_acilis_5175b3de:

    # si "Ve öteki taraf..."
    si "And the other side..."

# game/scene7_inis.rpy:599
translate english sahne7_kapi_acilis_4509bae4:

    # si "Taş duvarlar."
    si "Stone walls."

# game/scene7_inis.rpy:601
translate english sahne7_kapi_acilis_defdc698:

    # si "Bir yatak."
    si "A bed."

# game/scene7_inis.rpy:603
translate english sahne7_kapi_acilis_64f43f80:

    # si "Bir masa — üstünde boş, tozsuz bir halka."
    si "A table — with an empty, dustless ring on it."

# game/scene7_inis.rpy:605
translate english sahne7_kapi_acilis_d911b0d6:

    # s "Hayır."
    s "No."

# game/scene7_inis.rpy:607
translate english sahne7_kapi_acilis_44e91a85:

    # s "Hayır, hayır, hayır."
    s "No, no, no."

# game/scene7_inis.rpy:609
translate english sahne7_kapi_acilis_a51f4c16:

    # s "Burası başladığımız oda."
    s "This is the room where we started."

# game/scene7_inis.rpy:613
translate english sahne7_kapi_acilis_f9502565:

    # s "Baştan beri biliyordun. Kapının buraya çıktığını."
    s "You knew all along. That the door led here."

# game/scene7_inis.rpy:617
translate english sahne7_kapi_acilis_ae8cad3b:

    # s "Başka çıkış var mı?"
    s "Is there another way out?"

# game/scene7_inis.rpy:621
translate english sahne7_kapi_acilis_79377a77:

    # si "Aynı iki kelime. Kulenin dibinde de böyle konuşmuştuk."
    si "The same two words. We spoke like this at the foot of the tower too."

# game/scene7_inis.rpy:623
translate english sahne7_kapi_acilis_4316ed12:

    # si "Dünya küçük. Oda, koridor, kule. Işığımın değdiği kadar."
    si "The world is small. A room, a corridor, a tower. As far as my light reaches."

# game/scene7_inis.rpy:630
translate english sahne7_son_6486b1d3:

    # si "Ve ayna."
    si "And the mirror."

# game/scene7_inis.rpy:632
translate english sahne7_son_31bb011a:

    # si "Aynaya bakıyorum ve ayna artık odayı göstermiyor."
    si "I look at the mirror, and the mirror no longer shows the room."

# game/scene7_inis.rpy:634
translate english sahne7_son_95488b53:

    # si "Sadece bir anahtar deliği. Kapkara, göz hizasında, havada asılı."
    si "Only a keyhole. Pitch black, at eye level, hanging in the air."

# game/scene7_inis.rpy:636
translate english sahne7_son_900b9dfd:

    # s "Bacaklarım ağır. Gözkapaklarım daha ağır."
    s "My legs are heavy. My eyelids heavier."

# game/scene7_inis.rpy:638
translate english sahne7_son_de3c75eb:

    # s "Ne kadar zamandır uyumadım ben?"
    s "How long have I been awake?"

# game/scene7_inis.rpy:640
translate english sahne7_son_6828bf43:

    # si "Yatak köşede. Sıradan, çökük, gri bir yatak."
    si "The bed is in the corner. An ordinary, sunken, gray bed."

# game/scene7_inis.rpy:642
translate english sahne7_son_6631f56a:

    # si "Hayatımda hiçbir şeyi bu kadar istememiştim."
    si "I have never wanted anything this much in my life."

# game/scene7_inis.rpy:646
translate english sahne7_son_849b9dc7:

    # s "...ne?"
    s "...what?"

translate english strings:

    # game/scene7_inis.rpy:79
    old "«Duymadım.»"
    new "«I heard nothing.»"

    # game/scene7_inis.rpy:272
    old "«Nasıl?»"
    new "«How?»"

    # game/scene7_inis.rpy:301
    old "«Kılıcı çek.»"
    new "«Draw the sword.»"

    # game/scene7_inis.rpy:304
    old "«Üstüne yürü. Çıplak elle.»"
    new "«Go at him. Bare-handed.»"

    # game/scene7_inis.rpy:307
    old "«Lambayı kaldır. Işığı gözlerine tut.»"
    new "«Raise the lamp. Hold the light to his eyes.»"

    # game/scene7_inis.rpy:310
    old "«Sor: adı nasıl aldın?»"
    new "«Ask him: how did you take the name?»"

# game/scene7_inis.rpy:261
translate english sahne7_teklif_321df846:

    # s "Olabilir."
    s "Maybe."

# game/scene7_inis.rpy:263
translate english sahne7_teklif_1f027a04:

    # s "Ama benimki senin önünde \"hayır\" dedi. Sen diyemedin."
    s "But mine said \"no\" to your face. Yours never did."

# game/scene7_inis.rpy:400
translate english sahne7_isik_55fff1c0:

    # s "Hem sen fısıldadın. Işığı tut, dedin. Kendi hazineni bana harcadın."
    s "Besides, you were the one whispering. Hold up the light, you said. You spent your own treasure on me."

# game/scene7_inis.rpy:402
translate english sahne7_isik_219ff99f:

    # si "Cevap yok. Kafamın içinde, kendi sözüne kızan bir sessizlik."
    si "No answer. Inside my head, a silence angry at its own words."

# game/scene7_inis.rpy:404
translate english sahne7_isik_0509f0f8:

    # s "Beni alevden pahalı tuttun demek. Bunu bir yere yazıyorum, içimdeki."
    s "So you priced me above the flame. I'm writing that down somewhere, you inside."

# game/scene7_inis.rpy:670
translate english sahne7_son_adca9ad0:

    # s "Sebep söylemeyeceksin. Biliyorum."
    s "You won't give a reason. I know."

# game/scene7_inis.rpy:672
translate english sahne7_son_15f1e47a:

    # s "Ama sesin... benim için korkan bir ses bu. İlk defa duyuyorum."
    s "But your voice... this is a voice afraid for me. I'm hearing it for the first time."

# game/scene7_inis.rpy:674
translate english sahne7_son_f5df690a:

    # s "Peki, içimdeki. Uyumam."
    s "All right, you inside. I won't sleep."

# game/scene7_inis.rpy:678
translate english sahne7_son_f8b9199e:

    # s "Yine emir. Yine sebepsiz."
    s "Another order. Again, no reason."

# game/scene7_inis.rpy:680
translate english sahne7_son_bf317d44:

    # s "Ne sakladığını bilmiyorum. Ama bir şey sakladığını biliyorum."
    s "I don't know what you're hiding. But I know you're hiding something."

# game/scene7_inis.rpy:682
translate english sahne7_son_7e89c45a:

    # s "Uyumayacağım. Senin için değil. Sırf ne saklıyorsun diye."
    s "I won't sleep. Not for you. Just to see what you're hiding."

# game/scene7_inis.rpy:688
translate english sahne7_son_6296519c:

    # s "Sebep yok, değil mi? Senden hiç sebep gelmez."
    s "No reason, is there? Reasons never come from you."

# game/scene7_inis.rpy:690
translate english sahne7_son_47ae881f:

    # s "Peki. Şimdilik peki."
    s "Fine. For now, fine."

# TODO: Translation updated at 2026-09-03 12:50

# game/scene7_inis.rpy:522
translate english sahne7_dovus_tur_571a2b5b:

    # si "Bedenim benden önce davranıyor."
    si "My body moves before I do."

# game/scene7_inis.rpy:524
translate english sahne7_dovus_tur_f25285d4:

    # si "Omzum geriye kaçıyor — ben istemeden, o istemiş gibi."
    si "My shoulder pulls back — not because I wanted it to. Because it did."

# game/scene7_inis.rpy:526
translate english sahne7_dovus_tur_d8ed28e6:

    # si "Parmaklar havayı tırmalıyor. Bir tanesi yanağımı sıyırıyor, o kadar."
    si "The fingers rake the air. One grazes my cheek, and that is all."

# game/scene7_inis.rpy:528
translate english sahne7_dovus_tur_6d0b05fe:

    # yr "Kıvraksın. Bu beden bunu nereden biliyor?"
    yr "Nimble. Where did this body learn that?"

# game/scene7_inis.rpy:530
translate english sahne7_dovus_tur_73e5741f:

    # s "Bilmiyorum. Ama biliyor."
    s "I don't know. But it does."

