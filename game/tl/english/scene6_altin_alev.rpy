# English translation — scene6_altin_alev.rpy (Scene 6: The Golden Flame / The Choir)

# game/scene6_altin_alev.rpy:33
translate english sahne6_tepe_2a04f6e7:

    # si "Spiral daralıyor. Basamaklar küçülüyor."
    si "The spiral tightens. The steps grow smaller."

# game/scene6_altin_alev.rpy:35
translate english sahne6_tepe_100f1b68:

    # si "Ve ışık büyüyor. Altın, sıcak, ağır."
    si "And the light grows. Golden, warm, heavy."

# game/scene6_altin_alev.rpy:37
translate english sahne6_tepe_3344654e:

    # s "Bu sıcaklık yanlış. Ateş gibi değil. Öğle güneşi gibi. Kımıldamayan bir öğle."
    s "This warmth is wrong. Not like fire. Like a noon sun. A noon that never moves."

# game/scene6_altin_alev.rpy:41
translate english sahne6_tepe_ad93b4dd:

    # si "Lambamın alevi cama yapışmış. Saklanıyor."
    si "My lamp's flame is pressed against the glass. Hiding."

# game/scene6_altin_alev.rpy:45
translate english sahne6_tepe_cb32b810:

    # si "Lambamın alevi dimdik. Ama titriyor. İlk defa titriyor."
    si "My lamp's flame stands upright. But it trembles. For the first time, it trembles."

# game/scene6_altin_alev.rpy:49
translate english sahne6_tepe_9c467231:

    # si "Ve lamba elimde ağırlaşıyor."
    si "And the lamp grows heavy in my hand."

# game/scene6_altin_alev.rpy:51
translate english sahne6_tepe_b4939b15:

    # s "Sanki yukarı çıkmak istemiyor. Sanki biliyor."
    s "As if it doesn't want to go up. As if it knows."

# game/scene6_altin_alev.rpy:55
translate english sahne6_tepe_20948325:

    # s "Heves. Hâlâ heves var sesinde."
    s "Eagerness. There's still eagerness in your voice."

# game/scene6_altin_alev.rpy:70
translate english sahne6_koro_e17a6957:

    # si "Son basamak."
    si "The last step."

# game/scene6_altin_alev.rpy:72
translate english sahne6_koro_0909f0b4:

    # si "Yuvarlak bir oda. Penceresiz. Tavansız — yukarısı sadece karanlık."
    si "A round chamber. Windowless. Roofless — above, only darkness."

# game/scene6_altin_alev.rpy:74
translate english sahne6_koro_2b42f64e:

    # si "Ortada taş bir kazan. İçinde altın bir alev. Sessiz. Dumansız."
    si "In the center, a stone cauldron. Inside it, a golden flame. Silent. Smokeless."

# game/scene6_altin_alev.rpy:76
translate english sahne6_koro_6c3d55ab:

    # s "Güzel. Korkunç ve güzel."
    s "Beautiful. Terrible and beautiful."

# game/scene6_altin_alev.rpy:78
translate english sahne6_koro_5da176ae:

    # si "Aleve bakıyorum ve alev..."
    si "I look at the flame, and the flame..."

# game/scene6_altin_alev.rpy:80
translate english sahne6_koro_cad86689:

    # s "Alev de bana bakıyor. Yine. Ama bu sefer farklı."
    s "The flame looks back. Again. But this time it's different."

# game/scene6_altin_alev.rpy:82
translate english sahne6_koro_92ebe826:

    # ko "..."
    ko "..."

# game/scene6_altin_alev.rpy:84
translate english sahne6_koro_648426b8:

    # ko "Kardeş."
    ko "Sibling."

# game/scene6_altin_alev.rpy:86
translate english sahne6_koro_b253ce69:

    # s "...konuştu mu o?"
    s "...did that thing just speak?"

# game/scene6_altin_alev.rpy:88
translate english sahne6_koro_72cc1708:

    # ko "Eli boş mu geldin, kardeş?"
    ko "Have you come empty-handed, sibling?"

# game/scene6_altin_alev.rpy:90
translate english sahne6_koro_18c87bb6:

    # s "Benimle değil. {b}Seninle{/b} konuşuyor."
    s "It's not talking to me. It's talking to {b}you{/b}."

# game/scene6_altin_alev.rpy:96
translate english sahne6_koro_35c189ff:

    # ko "Suskun. Suskunsun. Yorgun musun, küçüldün mü?"
    ko "Quiet. You are quiet. Are you tired, or have you grown small?"

# game/scene6_altin_alev.rpy:98
translate english sahne6_koro_8af440bb:

    # si "Sesler. Bir ses değil — yüzlerce. Aynı kelimeler, ayrı ağızlar, tek nefes."
    si "Voices. Not one — hundreds. The same words, separate mouths, a single breath."

# game/scene6_altin_alev.rpy:100
translate english sahne6_koro_87bfdc11:

    # s "Koro gibi."
    s "Like a choir."

# game/scene6_altin_alev.rpy:104
translate english sahne6_koro_b09c1cbd:

    # ko "Bu beden... tanıdık. Tattık onu. Taze kan, eski borç."
    ko "This body is... familiar. We have tasted it. Fresh blood, old debt."

# game/scene6_altin_alev.rpy:106
translate english sahne6_koro_30e6708e:

    # s "Kule. Kulenin dili buymuş."
    s "The tower. So this is the tower's tongue."

# game/scene6_altin_alev.rpy:110
translate english sahne6_koro_c75e291a:

    # ko "Bir kırıntı kokuyor. Bir harf. Tek harf mi getirdin, kardeş?"
    ko "We smell a crumb. A letter. Did you bring a single letter, sibling?"

# game/scene6_altin_alev.rpy:114
translate english sahne6_koro_1cb625c5:

    # ko "Henüz. Henüz. {i}Henüz.{/i}"
    ko "Not yet. Not yet. {i}Not yet.{/i}"

# game/scene6_altin_alev.rpy:116
translate english sahne6_koro_3769f760:

    # si "Koro gülüyor. Yüzlerce ağızla, tek bir soğuk kahkaha."
    si "The Choir laughs. Hundreds of mouths, a single cold laugh."

# game/scene6_altin_alev.rpy:120
translate english sahne6_koro_85c80493:

    # ko "Ad kokusu yok. Boş mu geldin, kardeş?"
    ko "There is no smell of a name. Have you come empty, sibling?"

# game/scene6_altin_alev.rpy:133
translate english sahne6_pazarlik_46b74427:

    # s "Biri bana ne olduğunu anlatacak mı?"
    s "Is anyone going to tell me what's happening?"

# game/scene6_altin_alev.rpy:135
translate english sahne6_pazarlik_0de638a9:

    # ko "Beden konuşuyor."
    ko "The body speaks."

# game/scene6_altin_alev.rpy:137
translate english sahne6_pazarlik_2b7bf913:

    # ko "Beden hâlâ konuşuyor. Fısıltın yavaş, kardeş."
    ko "The body still speaks. Your whisper is slow, sibling."

# game/scene6_altin_alev.rpy:141
translate english sahne6_pazarlik_e0ece0dc:

    # ko "Dikkat."
    ko "Careful."

# game/scene6_altin_alev.rpy:143
translate english sahne6_pazarlik_5a0e4009:

    # ko "Ya da... {i}şefkat?{/i}"
    ko "Or is it... {i}tenderness?{/i}"

# game/scene6_altin_alev.rpy:147
translate english sahne6_pazarlik_c29a4d73:

    # si "Cevap çok hızlı geldi."
    si "The answer came too fast."

# game/scene6_altin_alev.rpy:151
translate english sahne6_pazarlik_f8bbbfbc:

    # ko "Kaç beden oldu, kardeş? Bu kaçıncı?"
    ko "How many bodies has it been, sibling? Which one is this?"

# game/scene6_altin_alev.rpy:155
translate english sahne6_pazarlik_f292f262:

    # ko "[persistent.olum_sayisi] kez düştü bu et. Saydık."
    ko "This flesh has fallen [persistent.olum_sayisi] times. We counted."

# game/scene6_altin_alev.rpy:157
translate english sahne6_pazarlik_601f3493:

    # s "Sen... düşüşlerimi mi sayıyorsun?"
    s "You... count my falls?"

# game/scene6_altin_alev.rpy:159
translate english sahne6_pazarlik_9fbd6fe0:

    # ko "Biz her şeyi sayarız."
    ko "We count everything."

# game/scene6_altin_alev.rpy:164
translate english sahne6_pazarlik_47370483:

    # s "\"Hep\"?"
    s "\"Always\"?"

# game/scene6_altin_alev.rpy:166
translate english sahne6_pazarlik_3b91d823:

    # s "Daha önce de mi? Benden önce... başkaları mı vardı?"
    s "Before, too? Before me... were there others?"

# game/scene6_altin_alev.rpy:170
translate english sahne6_pazarlik_063e8528:

    # ko "Sor ona, beden."
    ko "Ask it, body."

# game/scene6_altin_alev.rpy:172
translate english sahne6_pazarlik_7be8e4b3:

    # ko "Sor fısıltına: seni kaç kez sevdi?"
    ko "Ask your whisper: how many times has it loved you?"

# game/scene6_altin_alev.rpy:180
translate english sahne6_pazarlik_f1765be7:

    # si "Alev dalgalanıyor. Koro, fısıltının öfkesine gülümsüyor sanki."
    si "The flame ripples. The Choir seems to smile at the whisper's anger."

# game/scene6_altin_alev.rpy:182
translate english sahne6_pazarlik_ec22b33c:

    # ko "Bekleme bitti, kardeş."
    ko "The waiting is over, sibling."

# game/scene6_altin_alev.rpy:184
translate english sahne6_pazarlik_d923cbde:

    # ko "Ad burada. Bu odada. Bedenin içinde bir yerde."
    ko "The name is here. In this chamber. Somewhere inside the body."

# game/scene6_altin_alev.rpy:186
translate english sahne6_pazarlik_a42397fe:

    # ko "Biz bakarız."
    ko "We will look."

# game/scene6_altin_alev.rpy:188
translate english sahne6_pazarlik_a3577d7c:

    # si "Alev yükseliyor. Kazandan taşmadan — ama yükseliyor."
    si "The flame rises. Not spilling from the cauldron — but rising."

# game/scene6_altin_alev.rpy:190
translate english sahne6_pazarlik_ed187d55:

    # si "Ve sıcaklık alnıma bir parmak gibi dayanıyor."
    si "And the warmth presses against my forehead like a finger."

# game/scene6_altin_alev.rpy:192
translate english sahne6_pazarlik_fc57ce7a:

    # s "Kafama. Kafama girmek istiyor."
    s "My head. It wants into my head."

# game/scene6_altin_alev.rpy:220
translate english sahne6_ihanet_yolu_8d66b6f5:

    # si "Kafamın içinde bir şey kıpırdıyor."
    si "Something stirs inside my head."

# game/scene6_altin_alev.rpy:222
translate english sahne6_ihanet_yolu_2fb0219a:

    # si "Bir anı — benim anım — dışarı süzülüyor: kör kuyular, kavruk parmaklar, kuru bir ses."
    si "A memory — my memory — slips out: blind wells, scorched fingers, a dry voice."

# game/scene6_altin_alev.rpy:224
translate english sahne6_ihanet_yolu_6b171280:

    # s "Ne yapıyorsun? O anı benim."
    s "What are you doing? That memory is mine."

# game/scene6_altin_alev.rpy:228
translate english sahne6_ihanet_yolu_19136843:

    # s "O bize yardım etti. Kılıcını verdi."
    s "He helped us. He gave us his sword."

# game/scene6_altin_alev.rpy:232
translate english sahne6_ihanet_yolu_f9f0baec:

    # s "O bize yolu gösterdi."
    s "He showed us the way."

# game/scene6_altin_alev.rpy:234
translate english sahne6_ihanet_yolu_efb6fe01:

    # ko "Adsızın izi. Kırıntı. Bayat."
    ko "The trace of a nameless one. A crumb. Stale."

# game/scene6_altin_alev.rpy:236
translate english sahne6_ihanet_yolu_d422fc86:

    # ko "Yine de... alırız. Meze."
    ko "Still... we'll take it. An appetizer."

# game/scene6_altin_alev.rpy:238
translate english sahne6_ihanet_yolu_5e9c8179:

    # si "Alevin bir dili kazandan uzanıyor, süzüleni yalıyor, geri dönüyor."
    si "A tongue of flame reaches from the cauldron, licks up what slipped out, returns."

# game/scene6_altin_alev.rpy:240
translate english sahne6_ihanet_yolu_612a2904:

    # ko "Ama borç ad, kardeş. İz değil."
    ko "But the debt is a name, sibling. Not a trace."

# game/scene6_altin_alev.rpy:242
translate english sahne6_ihanet_yolu_d62f5797:

    # ko "Biz yine de bakarız."
    ko "We will look anyway."

# game/scene6_altin_alev.rpy:244
translate english sahne6_ihanet_yolu_72080e1a:

    # s "Ona Sönmüş'ü verdin."
    s "You gave it the Snuffed."

# game/scene6_altin_alev.rpy:246
translate english sahne6_ihanet_yolu_65c778f2:

    # s "Bir gün beni de böyle mi vereceksin?"
    s "Will you give me away like that too, one day?"

# game/scene6_altin_alev.rpy:263
translate english sahne6_izin_c591e558:

    # s "Duydum."
    s "I heard you."

# game/scene6_altin_alev.rpy:265
translate english sahne6_izin_67dc65ec:

    # s "Kapıları açmamı fısıldıyorsun."
    s "You're whispering me to open the doors."

# game/scene6_altin_alev.rpy:267
translate english sahne6_izin_b89ce790:

    # s "Hayır. Kapılarım {b}benim{/b}."
    s "No. My doors are {b}mine{/b}."

# game/scene6_altin_alev.rpy:269
translate english sahne6_izin_9989e2fd:

    # si "Sürgüler kendiliğinden iniyor. Benim indirdiğim sürgüler."
    si "The bolts slide down on their own. Bolts that I set."

# game/scene6_altin_alev.rpy:275
translate english sahne6_izin_3fbaf7d7:

    # s "Bırakıyorum."
    s "I let go."

# game/scene6_altin_alev.rpy:277
translate english sahne6_izin_b18175eb:

    # si "Kapı yok. Kilit yok. Açık bir avlu gibi duruyorum."
    si "No doors. No locks. I stand like an open courtyard."

# game/scene6_altin_alev.rpy:279
translate english sahne6_izin_0ceed558:

    # si "Altın parmak giriyor."
    si "The golden finger enters."

# game/scene6_altin_alev.rpy:281
translate english sahne6_izin_bbe1a690:

    # si "Raflarımı karıştırıyor. Boş rafları. Kazınmış rafları."
    si "It rifles through my shelves. The empty shelves. The scraped-out shelves."

# game/scene6_altin_alev.rpy:283
translate english sahne6_izin_fbc3ab20:

    # ko "Oyulmuş."
    ko "Hollowed."

# game/scene6_altin_alev.rpy:285
translate english sahne6_izin_a131d679:

    # ko "Biri burayı önceden boşaltmış. Usta işi."
    ko "Someone emptied this place beforehand. A master's work."

# game/scene6_altin_alev.rpy:292
translate english sahne6_izin_4cf65c03:

    # si "Parmak bir kıvılcım buluyor. Küçük. Tek harf."
    si "The finger finds a spark. Small. A single letter."

# game/scene6_altin_alev.rpy:294
translate english sahne6_izin_764ced02:

    # s "Hayır—"
    s "No—"

# game/scene6_altin_alev.rpy:296
translate english sahne6_izin_18bc992c:

    # si "Ve söndürüyor."
    si "And snuffs it out."

# game/scene6_altin_alev.rpy:300
translate english sahne6_izin_b6b3477f:

    # centered "{color=#cc2222}HARF GİTTİ{/color}"
    centered "{color=#cc2222}THE LETTER IS GONE{/color}"

# game/scene6_altin_alev.rpy:302
translate english sahne6_izin_5e39c09e:

    # s "E. E neydi? Neyin başıydı?"
    s "E. What was E? The beginning of what?"

# game/scene6_altin_alev.rpy:304
translate english sahne6_izin_4f0adecc:

    # s "Tek bildiğimdi. Artık onu da bilmiyorum."
    s "It was all I knew. Now I don't even know that."

# game/scene6_altin_alev.rpy:309
translate english sahne6_izin_14f49148:

    # si "Parmak köşeleri yokluyor. Bir şey bulamıyor."
    si "The finger probes the corners. It finds nothing."

# game/scene6_altin_alev.rpy:311
translate english sahne6_izin_addf6bcc:

    # si "Ama geçtiği raflara bir iz bırakıyor. Altın ve yapışkan."
    si "But it leaves a residue on the shelves it touches. Golden and sticky."

# game/scene6_altin_alev.rpy:315
translate english sahne6_izin_ee35f873:

    # s "Gitti. Ama gittiğinden emin değilim."
    s "It's gone. But I'm not sure it's gone."

# game/scene6_altin_alev.rpy:318
translate english sahne6_izin_e55e41bb:

    # si "Ve parmak çekilirken, bir an — bağlantı iki yönlü."
    si "And as the finger withdraws, for a moment — the connection runs both ways."

# game/scene6_altin_alev.rpy:320
translate english sahne6_izin_c9f55533:

    # s "Alevin içini görüyorum."
    s "I see inside the flame."

# game/scene6_altin_alev.rpy:322
translate english sahne6_izin_3cab42ad:

    # s "İsimler. Binlerce isim, altın iplikler gibi yanıyor."
    s "Names. Thousands of names, burning like golden threads."

# game/scene6_altin_alev.rpy:324
translate english sahne6_izin_10a2d288:

    # s "Alev isimlerden yapılmış."
    s "The flame is made of names."

# game/scene6_altin_alev.rpy:326
translate english sahne6_izin_acbf58fd:

    # ko "Gördü. Beden gördü."
    ko "It saw. The body saw."

# game/scene6_altin_alev.rpy:328
translate english sahne6_izin_1381dbd2:

    # ko "Önemi yok. Bedenler unutur."
    ko "It doesn't matter. Bodies forget."

# game/scene6_altin_alev.rpy:330
translate english sahne6_izin_84ad1c59:

    # s "Unutmayacağım."
    s "I won't forget."

# game/scene6_altin_alev.rpy:332
translate english sahne6_izin_c5dedf1b:

    # ko "Hepsi öyle der."
    ko "They all say that."

# game/scene6_altin_alev.rpy:343
translate english sahne6_direnis_d911b0d6:

    # s "Hayır."
    s "No."

# game/scene6_altin_alev.rpy:345
translate english sahne6_direnis_8b358da3:

    # si "Gözlerimi kapatıyorum. Kafamın içinde kapılar kuruyorum. Ağır, demir kapılar."
    si "I close my eyes. I build doors inside my head. Heavy, iron doors."

# game/scene6_altin_alev.rpy:347
translate english sahne6_direnis_e2a09aaa:

    # si "Ve hepsini kapatıyorum."
    si "And I shut them all."

# game/scene6_altin_alev.rpy:366
translate english sahne6_direnis_krit_basari_af7689b9:

    # si "Kapılar tutuyor. Altın parmak kapıları yokluyor — kilitli."
    si "The doors hold. The golden finger tests them — locked."

# game/scene6_altin_alev.rpy:368
translate english sahne6_direnis_krit_basari_0e055201:

    # ko "Sıkı. Sıkı beden."
    ko "Tight. A tight body."

# game/scene6_altin_alev.rpy:370
translate english sahne6_direnis_krit_basari_39b44739:

    # si "Ve parmak çekilirken sendeler gibi oluyor. Bir an — kapı aralığından —"
    si "And as the finger withdraws it seems to stumble. For a moment — through the crack of a door —"

# game/scene6_altin_alev.rpy:372
translate english sahne6_direnis_krit_basari_d30552d1:

    # s "{b}Ben onun içine bakıyorum.{/b}"
    s "{b}I am looking inside it.{/b}"

# game/scene6_altin_alev.rpy:374
translate english sahne6_direnis_krit_basari_c41ffdb9:

    # s "İsimler. Alev isimlerden örülü. Binlerce isim, altın iplikler."
    s "Names. The flame is woven from names. Thousands of names, golden threads."

# game/scene6_altin_alev.rpy:376
translate english sahne6_direnis_krit_basari_3801ec48:

    # s "Ve bir tanesi... bir tanesi bana dönüyor."
    s "And one of them... one of them turns toward me."

# game/scene6_altin_alev.rpy:378
translate english sahne6_direnis_krit_basari_b5869341:

    # s "Bir kadın sesi. Beni çağırıyor."
    s "A woman's voice. Calling me."

# game/scene6_altin_alev.rpy:380
translate english sahne6_direnis_krit_basari_dcdaa58d:

    # s "Adımla çağırıyor — duyamıyorum ama biliyorum: {i}adımla{/i} çağırıyor."
    s "Calling me by my name — I can't hear it, but I know: she's calling me {i}by my name{/i}."

# game/scene6_altin_alev.rpy:382
translate english sahne6_direnis_krit_basari_322dca46:

    # s "Onu tanıyorum. Tanıyordum."
    s "I know her. I knew her."

# game/scene6_altin_alev.rpy:384
translate english sahne6_direnis_krit_basari_92ebe826:

    # ko "..."
    ko "..."

# game/scene6_altin_alev.rpy:386
translate english sahne6_direnis_krit_basari_90d46dfd:

    # ko "Kapat kapıyı, beden."
    ko "Close the door, body."

# game/scene6_altin_alev.rpy:388
translate english sahne6_direnis_krit_basari_c4ad8d67:

    # si "Koro'nun sesinde ilk defa... telaş."
    si "For the first time, in the Choir's voice... alarm."

# game/scene6_altin_alev.rpy:398
translate english sahne6_direnis_basari_c1f49690:

    # si "Parmak kapılara dayanıyor. Kapılar inliyor."
    si "The finger presses against the doors. The doors groan."

# game/scene6_altin_alev.rpy:400
translate english sahne6_direnis_basari_b06f2de8:

    # si "Ama tutuyor."
    si "But they hold."

# game/scene6_altin_alev.rpy:402
translate english sahne6_direnis_basari_1b552b58:

    # ko "Sıkı. İyi saklanmış."
    ko "Tight. Well hidden."

# game/scene6_altin_alev.rpy:407
translate english sahne6_direnis_basari_da1bcdeb:

    # s "\"Benimki.\""
    s "\"Mine.\""

# game/scene6_altin_alev.rpy:409
translate english sahne6_direnis_basari_5d8ebd37:

    # si "Kimse fark etmemiş gibi yapıyor. Ben dahil."
    si "Everyone pretends not to have noticed. Including me."

# game/scene6_altin_alev.rpy:419
translate english sahne6_direnis_basarisiz_298a58c5:

    # si "Kapılardan biri içeri çöküyor."
    si "One of the doors caves in."

# game/scene6_altin_alev.rpy:421
translate english sahne6_direnis_basarisiz_74d425f8:

    # si "Altın parmak raflarımda. Karıştırıyor. Okuduğunu yakıyor."
    si "The golden finger is in my shelves. Rifling. Burning what it reads."

# game/scene6_altin_alev.rpy:423
translate english sahne6_direnis_basarisiz_f1061be3:

    # si "Çekildiğinde, dokunduğu her yer kavrulmuş."
    si "When it withdraws, everything it touched is scorched."

# game/scene6_altin_alev.rpy:425
translate english sahne6_direnis_basarisiz_b6ad1db2:

    # s "Bir şeyler eksik. Ne olduğunu bilmiyorum."
    s "Something is missing. I don't know what."

# game/scene6_altin_alev.rpy:427
translate english sahne6_direnis_basarisiz_547939a6:

    # s "Sadece eksikliğin kendisi kalmış."
    s "Only the missing itself remains."

# game/scene6_altin_alev.rpy:435
translate english sahne6_direnis_basarisiz_e4baa9b0:

    # ko "E."
    ko "E."

# game/scene6_altin_alev.rpy:437
translate english sahne6_direnis_basarisiz_2f91da3e:

    # ko "Küçük bir başlangıç. Getir gerisini, kardeş."
    ko "A small beginning. Bring the rest, sibling."

# game/scene6_altin_alev.rpy:439
translate english sahne6_direnis_basarisiz_c52e2c88:

    # s "Harfimi. Harfimi okudu."
    s "My letter. It read my letter."

# game/scene6_altin_alev.rpy:447
translate english sahne6_direnis_krit_fiyasko_ce1982f6:

    # si "Kapılar deviriliyor. Hepsi. Aynı anda."
    si "The doors are thrown down. All of them. At once."

# game/scene6_altin_alev.rpy:449
translate english sahne6_direnis_krit_fiyasko_c2ba2863:

    # si "Altın, kafamın içine öğle güneşi gibi doluyor."
    si "Gold floods into my head like a noon sun."

# game/scene6_altin_alev.rpy:451
translate english sahne6_direnis_krit_fiyasko_671f6a74:

    # s "Her raf. Her köşe. Her karanlık — aydınlanıyor."
    s "Every shelf. Every corner. Every darkness — lit."

# game/scene6_altin_alev.rpy:453
translate english sahne6_direnis_krit_fiyasko_8f6fb942:

    # s "İçimde saklanacak yer kal—"
    s "There's nowhere left in me to hi—"

# game/scene6_altin_alev.rpy:467
translate english sahne6_ultimatom_17f0f969:

    # si "Alev kazanına geri çekiliyor. Doymuş... ya da sabırlı."
    si "The flame withdraws into its cauldron. Sated... or patient."

# game/scene6_altin_alev.rpy:469
translate english sahne6_ultimatom_862c2824:

    # ko "Küçük fısıltı."
    ko "Little whisper."

# game/scene6_altin_alev.rpy:471
translate english sahne6_ultimatom_c95e56c4:

    # ko "Bir dahaki kavuşmada: ya adı getirirsin..."
    ko "At our next meeting: you bring the name..."

# game/scene6_altin_alev.rpy:473
translate english sahne6_ultimatom_606998f5:

    # ko "...ya kendini."
    ko "...or you bring yourself."

# game/scene6_altin_alev.rpy:477
translate english sahne6_ultimatom_e07b2eae:

    # ko "Gidin şimdi. İkiniz de. Aşağıda kapı sizi bekliyor."
    ko "Go now. Both of you. The door waits for you below."

# game/scene6_altin_alev.rpy:479
translate english sahne6_ultimatom_6c09768d:

    # s "Hangi kapı?"
    s "What door?"

# game/scene6_altin_alev.rpy:481
translate english sahne6_ultimatom_f32e2038:

    # ko "Beden soru soruyor. Fısıltın cevaplasın."
    ko "The body asks questions. Let your whisper answer."

# game/scene6_altin_alev.rpy:483
translate english sahne6_ultimatom_70abc20c:

    # ko "Vakti var. Bir alev boyu."
    ko "There is time. One flame's length."

# game/scene6_altin_alev.rpy:485
translate english sahne6_ultimatom_36288929:

    # si "Merdivene dönüyoruz. Altın ışık sırtımızda küçülüyor."
    si "We turn back to the stairs. The golden light shrinks at our backs."

# game/scene6_altin_alev.rpy:487
translate english sahne6_ultimatom_a54d6645:

    # si "Koro zihnime dokundu ve ben hâlâ benim. Bir şey söktüyse bile... bir şey de bıraktı."
    si "The Choir touched my mind and I am still me. Even if it tore something out... it left something too."

# game/scene6_altin_alev.rpy:492
translate english sahne6_ultimatom_c5a4f1a1:

    # s "Ya adı... ya kendini."
    s "The name... or yourself."

# game/scene6_altin_alev.rpy:494
translate english sahne6_ultimatom_6a4e8dc1:

    # s "Ne yapacaksın?"
    s "What are you going to do?"

# game/scene6_altin_alev.rpy:498
translate english sahne6_ultimatom_e60c6f6b:

    # s "İlk defa cevabını bilmediğin bir soru sordum."
    s "For the first time, I've asked you a question you don't know the answer to."

translate english strings:

    # game/scene6_altin_alev.rpy:202
    old "«Diren. Bütün kapıları kapat.»"
    new "«Resist. Shut every door.»"

    # game/scene6_altin_alev.rpy:205
    old "«Direnme. Saklı bir şey yok — bırak, görsün.»"
    new "«Don't resist. There's nothing hidden — let it look.»"

    # game/scene6_altin_alev.rpy:208
    old "«Ona başka bir şey ver. Sönmüş'ün izini ver.»"
    new "«Give it something else. Give it the Snuffed's trace.»"

# game/scene6_altin_alev.rpy:500
translate english sahne6_ultimatom_a93f1a70:

    # s "Ve uydurmadın."
    s "And you didn't make one up."

# game/scene6_altin_alev.rpy:502
translate english sahne6_ultimatom_eab38f99:

    # si "Bilmiyorum, diyen bir sessizlik bu. Emir veren sessizliklerinden değil."
    si "This is a silence that says: I don't know. Not one of your commanding silences."

# game/scene6_altin_alev.rpy:504
translate english sahne6_ultimatom_a9b703dc:

    # s "Böylesi daha iyi. Böylesine katlanabilirim."
    s "This kind is better. This kind I can bear."

# TODO: Translation updated at 2026-09-02 19:11

# game/scene6_altin_alev.rpy:335
translate english sahne6_izin_1402ed93:

    # si "Ve ipliklerden biri ötekiler gibi durmuyor."
    si "And one of the threads doesn't hang like the others."

# game/scene6_altin_alev.rpy:337
translate english sahne6_izin_02b546d5:

    # si "Ötekiler yukarı yanıyor. Bu sarkıyor."
    si "The others burn upward. This one droops."

# game/scene6_altin_alev.rpy:339
translate english sahne6_izin_c014688f:

    # s "Bana doğru sarkıyor."
    s "It droops toward me."

# game/scene6_altin_alev.rpy:341
translate english sahne6_izin_92ebe826:

    # ko "..."
    ko "..."

# game/scene6_altin_alev.rpy:348
translate english sahne6_izin_0d2101c6:

    # s "Uzanıyorum."
    s "I reach."

# game/scene6_altin_alev.rpy:350
translate english sahne6_izin_5fdc9cfd:

    # si "Elim alevin içinde. Acı yok. Daha kötüsü var: tanıdık."
    si "My hand is inside the flame. No pain. Something worse: it's familiar."

# game/scene6_altin_alev.rpy:352
translate english sahne6_izin_06af1dbd:

    # s "İplik parmağıma dolanıyor."
    s "The thread winds around my finger."

# game/scene6_altin_alev.rpy:354
translate english sahne6_izin_1cbf2280:

    # s "Bir ses. Kadın sesi."
    s "A voice. A woman's voice."

# game/scene6_altin_alev.rpy:356
translate english sahne6_izin_6fed8ecd:

    # s "Beni çağırıyor — ve çağırdığı şeyi duyamıyorum."
    s "She's calling me — and I can't hear the thing she's calling."

# game/scene6_altin_alev.rpy:358
translate english sahne6_izin_142644da:

    # s "Duymama gerek de yok. Bu ses bana hep böyle seslendi."
    s "I don't need to hear it. This voice always called me that way."

# game/scene6_altin_alev.rpy:362
translate english sahne6_izin_6342dcc0:

    # ko "Çek. Elini. Çek."
    ko "Pull. Your hand. Pull it back."

# game/scene6_altin_alev.rpy:364
translate english sahne6_izin_00428c64:

    # si "Koro'nun sesi ilk defa emir değil. Rica gibi."
    si "For the first time the Choir's voice isn't an order. It's closer to asking."

# game/scene6_altin_alev.rpy:370
translate english sahne6_izin_717b6cde:

    # s "Elimi çektim. İplik hâlâ orada."
    s "I pulled my hand back. The thread is still there."

# game/scene6_altin_alev.rpy:372
translate english sahne6_izin_f8a0760c:

    # s "Bende de bir yeri kaldı."
    s "It kept a place in me too."

# game/scene6_altin_alev.rpy:378
translate english sahne6_izin_739be705:

    # s "Bakma, diyorsun."
    s "Don't look, you say."

# game/scene6_altin_alev.rpy:380
translate english sahne6_izin_020801cc:

    # si "Sesin aceleci. Daha önce hiç aceleci olmamıştın."
    si "Your voice is hurried. You have never been hurried before."

# game/scene6_altin_alev.rpy:382
translate english sahne6_izin_50467ce4:

    # s "Peki."
    s "All right."

# game/scene6_altin_alev.rpy:384
translate english sahne6_izin_b68652fc:

    # si "Gözlerimi çeviriyorum. İplik sarkmaya devam ediyor. Sarkarken kalıyor."
    si "I turn my eyes away. The thread goes on drooping. It stays there, drooping."

# game/scene6_altin_alev.rpy:386
translate english sahne6_izin_b8975517:

    # s "Beni bir şeyden korudun galiba."
    s "I think you protected me from something."

# game/scene6_altin_alev.rpy:388
translate english sahne6_izin_19861ef2:

    # s "Neyden korudun bilmiyorum. Ama korkun gerçekti. Onu duydum."
    s "I don't know from what. But your fear was real. That much I heard."

# game/scene6_altin_alev.rpy:394
translate english sahne6_izin_577d5aea:

    # ko "Ses korktu."
    ko "The voice was afraid."

# game/scene6_altin_alev.rpy:396
translate english sahne6_izin_20e8c730:

    # ko "İlginç."
    ko "Interesting."

# game/scene6_altin_alev.rpy:401
translate english sahne6_izin_da3c1268:

    # s "Senin mi?"
    s "Yours?"

# game/scene6_altin_alev.rpy:403
translate english sahne6_izin_53547200:

    # si "Sesin değişti. İlk defa aç bir şey gibi çıktı."
    si "Your voice changed. For the first time it came out like something hungry."

# game/scene6_altin_alev.rpy:405
translate english sahne6_izin_d4b6e212:

    # s "Alevdeki bir ipliğe 'benim' dedin."
    s "You called a thread in the flame 'mine'."

# game/scene6_altin_alev.rpy:407
translate english sahne6_izin_b936e283:

    # s "Bunu nereden biliyorsun?"
    s "How do you know that?"

# game/scene6_altin_alev.rpy:411
translate english sahne6_izin_6bbe5334:

    # s "Bilmiyorsun. Ama istedin."
    s "You don't know. But you wanted it."

# game/scene6_altin_alev.rpy:413
translate english sahne6_izin_eb0d5495:

    # si "İçimde bir kapı kapandı. Ben kapatmadım."
    si "A door closed inside me. I didn't close it."

# game/scene6_altin_alev.rpy:417
translate english sahne6_izin_78bad8ba:

    # ko "Duydunuz mu? Ses sahip çıkıyor."
    ko "Did you hear? The voice is laying claim."

# game/scene6_altin_alev.rpy:419
translate english sahne6_izin_b32cda58:

    # ko "Sahip çıkan ses, teslim etmeyen sestir."
    ko "A voice that lays claim is a voice that does not deliver."

# game/scene6_altin_alev.rpy:421
translate english sahne6_izin_dc51f70c:

    # si "Koro'nun ilgisi ilk defa bana değil — içimdekine döndü."
    si "For the first time the Choir's attention turned not to me — but to the you inside me."

translate english strings:

    # game/scene6_altin_alev.rpy:347
    old "«Uzan.»"
    new "«Reach.»"

    # game/scene6_altin_alev.rpy:377
    old "«Bakma.»"
    new "«Don't look.»"

    # game/scene6_altin_alev.rpy:400
    old "«O benim.»"
    new "«That's mine.»"

