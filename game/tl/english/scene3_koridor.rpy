# English translation — scene3_koridor.rpy (Scene 3: The Corridor)

# game/scene3_koridor.rpy:21
translate english sahne3_koridor_79af592c:

    # si "Parmaklarım sapın etrafında kapanıyor."
    si "My fingers close around the handle."

# game/scene3_koridor.rpy:25
translate english sahne3_koridor_63d1b89d:

    # s "Sap avucuma oturuyor. Eksik bir uzvum yerine takılmış gibi."
    s "The handle settles into my palm. Like a missing limb screwed back on."

# game/scene3_koridor.rpy:27
translate english sahne3_koridor_02707cd9:

    # s "Bu his yanlış. Ama iyi."
    s "The feeling is wrong. But good."

# game/scene3_koridor.rpy:31
translate english sahne3_koridor_e065834b:

    # s "Sap sıcak. Metal, avucumda kalp gibi atıyor."
    s "The handle is warm. The metal beats in my palm like a heart."

# game/scene3_koridor.rpy:33
translate english sahne3_koridor_6f506c60:

    # si "Lambayı halkasından kaldırıyorum."
    si "I lift the lamp from its ring."

# game/scene3_koridor.rpy:35
translate english sahne3_koridor_51a17557:

    # si "Ve oda... nefesini bırakıyor."
    si "And the room... lets out its breath."

# game/scene3_koridor.rpy:37
translate english sahne3_koridor_8b3210a0:

    # s "Duvarlar uzaklaşmış gibi. Ayna kapkara."
    s "The walls seem farther away. The mirror is pitch black."

# game/scene3_koridor.rpy:39
translate english sahne3_koridor_62389fa6:

    # si "Lambanın ışığı çevremde bir çember çiziyor. Kırmızı, sıcak bir çember."
    si "The lamp's light draws a circle around me. A red, warm circle."

# game/scene3_koridor.rpy:41
translate english sahne3_koridor_b589faf6:

    # s "Çemberin dışında hiçbir şey yok."
    s "Outside the circle there is nothing."

# game/scene3_koridor.rpy:57
translate english sahne3_esik_b0a98a45:

    # si "Kapının kolu soğuk."
    si "The door handle is cold."

# game/scene3_koridor.rpy:59
translate english sahne3_esik_08c83a0c:

    # si "Çeviriyorum. Kapı sessizce açılıyor. Gıcırdamıyor bile."
    si "I turn it. The door opens silently. It doesn't even creak."

# game/scene3_koridor.rpy:61
translate english sahne3_esik_e652203b:

    # s "Menteşeler yağlı. Biri bu kapıyı kullanıyor."
    s "The hinges are oiled. Someone uses this door."

# game/scene3_koridor.rpy:66
translate english sahne3_esik_ab826de8:

    # si "Ötesi: koridor. Taş. Uzun."
    si "Beyond it: a corridor. Stone. Long."

# game/scene3_koridor.rpy:68
translate english sahne3_esik_9dc20b4f:

    # si "Işığımın çemberi üç adım öteye ulaşıyor. Sonrası siyah."
    si "My circle of light reaches three steps ahead. After that, black."

# game/scene3_koridor.rpy:72
translate english sahne3_esik_1cdc6798:

    # si "Eşikten geçiyorum."
    si "I cross the threshold."

# game/scene3_koridor.rpy:74
translate english sahne3_esik_8f6ba212:

    # si "Arkamda bir şey kapanıyor. Kapı değil. Daha büyük bir şey."
    si "Something closes behind me. Not the door. Something bigger."

# game/scene3_koridor.rpy:76
translate english sahne3_esik_d35545fb:

    # si "Dönüp bakıyorum: oda yok. Kapı yok. Duvar bile yok."
    si "I turn to look: no room. No door. Not even a wall."

# game/scene3_koridor.rpy:78
translate english sahne3_esik_d54bc8b9:

    # s "Sadece ışığımın ulaşmadığı yer var."
    s "There is only the place my light doesn't reach."

# game/scene3_koridor.rpy:93
translate english sahne3_yuruyus_e4728570:

    # si "Yürüyorum. Adımlarım taşta yankılanıyor."
    si "I walk. My steps echo on the stone."

# game/scene3_koridor.rpy:95
translate english sahne3_yuruyus_b50556a5:

    # si "Damla sesleri. Uzakta. Düzenli."
    si "The sound of dripping. Far away. Regular."

# game/scene3_koridor.rpy:97
translate english sahne3_yuruyus_657c6fe0:

    # s "Ve... başka bir şey."
    s "And... something else."

# game/scene3_koridor.rpy:99
translate english sahne3_yuruyus_7aa03fed:

    # si "Duruyorum."
    si "I stop."

# game/scene3_koridor.rpy:101
translate english sahne3_yuruyus_f7a0deb6:

    # si "Yankım bir adım daha atıyor. Sonra susuyor."
    si "My echo takes one more step. Then falls silent."

# game/scene3_koridor.rpy:103
translate english sahne3_yuruyus_d32cca53:

    # s "Yankılar gecikmez."
    s "Echoes don't lag behind."

# game/scene3_koridor.rpy:109
translate english sahne3_yuruyus_7fa8eac4:

    # si "Nefesimi tutuyorum."
    si "I hold my breath."

# game/scene3_koridor.rpy:111
translate english sahne3_yuruyus_c3b449b6:

    # si "Çemberin hemen dışında: bir sürtünme sesi. Kumaş gibi. Ya da deri."
    si "Just outside the circle: a scraping sound. Like cloth. Or skin."

# game/scene3_koridor.rpy:113
translate english sahne3_yuruyus_473b7e2b:

    # s "Işığın kenarında duruyor. İçeri giremiyor."
    s "It stands at the edge of the light. It can't come in."

# game/scene3_koridor.rpy:115
translate english sahne3_yuruyus_201891a9:

    # s "Giremiyor... değil mi?"
    s "It can't... can it?"

# game/scene3_koridor.rpy:121
translate english sahne3_yuruyus_20aa9209:

    # si "Yürüyorum. Daha hızlı."
    si "I walk. Faster."

# game/scene3_koridor.rpy:123
translate english sahne3_yuruyus_b70884d9:

    # si "Arkamdaki adımlar da hızlanıyor."
    si "The steps behind me speed up too."

# game/scene3_koridor.rpy:125
translate english sahne3_yuruyus_43a0859c:

    # s "Bakmıyorum. Bakmayacağım."
    s "I'm not looking. I will not look."

# game/scene3_koridor.rpy:127
translate english sahne3_yuruyus_50a7cdbb:

    # si "Ense köküm karıncalanıyor. Bakış gibi. Parmak gibi."
    si "The back of my neck prickles. Like a stare. Like a finger."

# game/scene3_koridor.rpy:143
translate english sahne3_ucurum_e0c4dff8:

    # si "Koridor birden bitiyor."
    si "The corridor ends abruptly."

# game/scene3_koridor.rpy:145
translate english sahne3_ucurum_3b9db3dd:

    # s "Zemin yok."
    s "There is no floor."

# game/scene3_koridor.rpy:147
translate english sahne3_ucurum_edefc61a:

    # si "Lambayı kenardan aşağı tutuyorum: hiçbir şey. Işık dibe ulaşmıyor."
    si "I hold the lamp out over the edge: nothing. The light doesn't reach the bottom."

# game/scene3_koridor.rpy:149
translate english sahne3_ucurum_95e069d3:

    # s "Işık her yere ulaşır. Buraya ulaşmıyor."
    s "Light reaches everywhere. It doesn't reach here."

# game/scene3_koridor.rpy:151
translate english sahne3_ucurum_8820c577:

    # si "Karşı kenar dört-beş adım ötede."
    si "The far edge is four or five steps away."

# game/scene3_koridor.rpy:153
translate english sahne3_ucurum_9b5bea8f:

    # si "Arada, duvar boyunca, bir karış genişliğinde bir çıkıntı."
    si "Between them, along the wall, a ledge one hand-span wide."

# game/scene3_koridor.rpy:155
translate english sahne3_ucurum_7a24551c:

    # s "Geçilebilir. Tek yol bu."
    s "It can be crossed. It's the only way."

# game/scene3_koridor.rpy:157
translate english sahne3_ucurum_bb0d0f93:

    # s "Ama iki elim de lazım olacak. Ve lamba..."
    s "But I'll need both hands. And the lamp..."

# game/scene3_koridor.rpy:177
translate english sahne3_ucurum_secim_5d3d0204:

    # si "Dönüyorum. Geldiğim yöne yürüyorum."
    si "I turn around. I walk back the way I came."

# game/scene3_koridor.rpy:179
translate english sahne3_ucurum_secim_654072fa:

    # si "Bir dakika. Beş dakika. Işığın çemberi taş yutuyor."
    si "One minute. Five. The circle of light swallows stone."

# game/scene3_koridor.rpy:181
translate english sahne3_ucurum_secim_af0491e8:

    # si "Ve sonra zemin yeniden bitiyor."
    si "And then the floor ends again."

# game/scene3_koridor.rpy:183
translate english sahne3_ucurum_secim_26cc2333:

    # s "Aynı uçurum."
    s "The same chasm."

# game/scene3_koridor.rpy:185
translate english sahne3_ucurum_secim_f6f7f01e:

    # s "Geriye yürüdüm. İleriye çıktım."
    s "I walked backward. I arrived forward."

# game/scene3_koridor.rpy:187
translate english sahne3_ucurum_secim_3e782648:

    # si "Ve karanlıkta bir yerde, bir şey kıkırdıyor gibi."
    si "And somewhere in the dark, something seems to giggle."

# game/scene3_koridor.rpy:199
translate english sahne3_gecis_kemer_fa4cec50:

    # si "Lambanın sapını kemerime geçiriyorum."
    si "I hook the lamp's handle onto my belt."

# game/scene3_koridor.rpy:201
translate english sahne3_gecis_kemer_d921ed12:

    # si "Kalçamda sallanıyor; ışık çemberi ayaklarımın dibinde titriyor."
    si "It swings at my hip; the circle of light trembles at my feet."

# game/scene3_koridor.rpy:203
translate english sahne3_gecis_kemer_8c5f4a3b:

    # s "İki elim serbest. Tamam."
    s "Both hands free. All right."

# game/scene3_koridor.rpy:205
translate english sahne3_gecis_kemer_8ec72b3e:

    # si "Sırtımı duvara veriyorum. Çıkıntıya adım atıyorum."
    si "I press my back to the wall. I step onto the ledge."

# game/scene3_koridor.rpy:219
translate english sahne3_gecis_tekel_d9c544ea:

    # si "Lambayı sol elime alıyorum. Parmaklarım sapa kilitleniyor."
    si "I take the lamp in my left hand. My fingers lock around the handle."

# game/scene3_koridor.rpy:221
translate english sahne3_gecis_tekel_d45d6716:

    # s "Alev sönmemeli. Bu her şeyden önemli."
    s "The flame must not go out. That matters more than anything."

# game/scene3_koridor.rpy:223
translate english sahne3_gecis_tekel_373eb6ea:

    # s "...neden her şeyden önemli?"
    s "...why does it matter more than anything?"

# game/scene3_koridor.rpy:227
translate english sahne3_gecis_tekel_b0f7d7c9:

    # si "Tek elimle duvardaki çatlakları yokluyorum. Çıkıntıya adım atıyorum."
    si "With one hand I feel for cracks in the wall. I step onto the ledge."

# game/scene3_koridor.rpy:255
translate english sahne3_gecis_krit_basari_60312794:

    # si "Ayaklarım çıkıntıyı kendiliğinden buluyor."
    si "My feet find the ledge on their own."

# game/scene3_koridor.rpy:257
translate english sahne3_gecis_krit_basari_ed532589:

    # s "Beden hatırlıyor. Bunu daha önce yaptım."
    s "The body remembers. I have done this before."

# game/scene3_koridor.rpy:259
translate english sahne3_gecis_krit_basari_a5c79109:

    # s "Bu duvarı biliyorum. Bu boşluğu biliyorum."
    s "I know this wall. I know this drop."

# game/scene3_koridor.rpy:261
translate english sahne3_gecis_krit_basari_6fc53a17:

    # si "Karşıya adım atıyorum. Kolay. Fazla kolay."
    si "I step across. Easy. Too easy."

# game/scene3_koridor.rpy:263
translate english sahne3_gecis_krit_basari_03f8e06c:

    # si "Ve kenarın dibinde, taşa kazınmış: çentikler."
    si "And at the base of the edge, carved into the stone: notches."

# game/scene3_koridor.rpy:265
translate english sahne3_gecis_krit_basari_f87369d6:

    # s "Onlarca çentik. Biri burayı geçmiş. Tekrar. Tekrar. Tekrar."
    s "Dozens of notches. Someone crossed here. Again. Again. Again."

# game/scene3_koridor.rpy:267
translate english sahne3_gecis_krit_basari_7a04a34a:

    # s "En yenisi... taze. Tozu bile oturmamış."
    s "The newest one is... fresh. The dust hasn't even settled on it."

# game/scene3_koridor.rpy:273
translate english sahne3_gecis_krit_basari_7e82c9a3:

    # s "Neden saymamı istemiyorsun?"
    s "Why don't you want me to count them?"

# game/scene3_koridor.rpy:285
translate english sahne3_gecis_basari_83cdd104:

    # si "Sırtım duvarda, santim santim ilerliyorum."
    si "Back against the wall, I inch forward."

# game/scene3_koridor.rpy:287
translate english sahne3_gecis_basari_2d141f92:

    # si "Taş bir kez ufalanıyor; topuğum boşluğu yalıyor."
    si "The stone crumbles once; my heel licks the void."

# game/scene3_koridor.rpy:289
translate english sahne3_gecis_basari_386b2ca3:

    # s "Aşağı bakma. Aşağı diye bir yer yok."
    s "Don't look down. There is no such place as down."

# game/scene3_koridor.rpy:291
translate english sahne3_gecis_basari_fc29a48b:

    # si "Son adım. Karşı kenar. Zemin."
    si "Last step. The far edge. Ground."

# game/scene3_koridor.rpy:293
translate english sahne3_gecis_basari_0db0998a:

    # s "Geçtim."
    s "I made it."

# game/scene3_koridor.rpy:295
translate english sahne3_gecis_basari_bb98fc9b:

    # s "Kimse alkışlamıyor. Alışıyorum."
    s "Nobody's clapping. I'm getting used to it."

# game/scene3_koridor.rpy:299
translate english sahne3_gecis_basari_f881e015:

    # si "Lamba hâlâ elimde. Alev, teşekkür eder gibi bir parmak yükseliyor."
    si "The lamp is still in my hand. The flame rises a finger, as if in thanks."

# game/scene3_koridor.rpy:307
translate english sahne3_gecis_basarisiz_3e2fe2dc:

    # si "Üçüncü adımda taş, topuğumun altında ufalanıyor."
    si "On the third step, the stone crumbles under my heel."

# game/scene3_koridor.rpy:309
translate english sahne3_gecis_basarisiz_1588633d:

    # s "Düşüyorum—"
    s "I'm falling—"

# game/scene3_koridor.rpy:311
translate english sahne3_gecis_basarisiz_80abede2:

    # si "Elim kendiliğinden bir çatlağa saplanıyor."
    si "My hand jams itself into a crack."

# game/scene3_koridor.rpy:313
translate english sahne3_gecis_basarisiz_ce103683:

    # si "Omzum, bütün ağırlığımı tek başına yutuyor."
    si "My shoulder swallows all of my weight alone."

# game/scene3_koridor.rpy:317
translate english sahne3_gecis_basarisiz_d6928eff:

    # si "Öbür elim lambayı havaya kaldırıyor. Düşerken bile."
    si "My other hand holds the lamp up high. Even while falling."

# game/scene3_koridor.rpy:319
translate english sahne3_gecis_basarisiz_5542e9b0:

    # s "Önce lambayı kurtardım. Kendimden önce."
    s "I saved the lamp first. Before myself."

# game/scene3_koridor.rpy:321
translate english sahne3_gecis_basarisiz_1b764b0c:

    # s "Bu normal mi?"
    s "Is that normal?"

# game/scene3_koridor.rpy:325
translate english sahne3_gecis_basarisiz_6a34a111:

    # si "Omzumda bir şey kopuyor. Sıcak bir kopuş."
    si "Something tears in my shoulder. A hot tearing."

# game/scene3_koridor.rpy:327
translate english sahne3_gecis_basarisiz_ddc5371d:

    # si "Kendimi kenardan yukarı çekiyorum. Taşın üstünde, nefes nefese."
    si "I haul myself up over the edge. On the stone, gasping."

# game/scene3_koridor.rpy:329
translate english sahne3_gecis_basarisiz_5aa5853f:

    # s "Bu omuz bir daha eskisi gibi olmayacak."
    s "This shoulder will never be what it was."

# game/scene3_koridor.rpy:335
translate english sahne3_gecis_basarisiz_359a3e26:

    # si "Ve lamba... alev, düşüş sırasında küçülmüş."
    si "And the lamp... the flame shrank during the fall."

# game/scene3_koridor.rpy:337
translate english sahne3_gecis_basarisiz_c5ea6fdc:

    # si "Koridorun duvarları da yaklaşmış sanki."
    si "The corridor walls seem closer too."

# game/scene3_koridor.rpy:339
translate english sahne3_gecis_basarisiz_04cc4492:

    # s "Işık küçülünce dünya da küçülüyor."
    s "When the light shrinks, the world shrinks with it."

# game/scene3_koridor.rpy:347
translate english sahne3_gecis_krit_fiyasko_7e0e10f0:

    # si "Üçüncü adımda taş, topuğumun altında kayboluyor."
    si "On the third step, the stone vanishes under my heel."

# game/scene3_koridor.rpy:349
translate english sahne3_gecis_krit_fiyasko_9ac28085:

    # s "Taş değilmiş."
    s "It wasn't stone."

# game/scene3_koridor.rpy:351
translate english sahne3_gecis_krit_fiyasko_db024835:

    # s "Gölgeymiş."
    s "It was shadow."

# game/scene3_koridor.rpy:353
translate english sahne3_gecis_krit_fiyasko_39a5ecd3:

    # si "Düşüyorum."
    si "I fall."

# game/scene3_koridor.rpy:355
translate english sahne3_gecis_krit_fiyasko_cf8dab6d:

    # si "Işığın çemberi benimle birlikte düşüyor. Küçülüyor. Küçülüyor."
    si "The circle of light falls with me. Shrinking. Shrinking."

# game/scene3_koridor.rpy:357
translate english sahne3_gecis_krit_fiyasko_e408cd9f:

    # s "Alev sönmeden hemen önce, aşağıda beni bekleyen şeyi görüyorum."
    s "Just before the flame dies, I see the thing waiting for me below."

# game/scene3_koridor.rpy:373
translate english sahne3_son_af001ef0:

    # si "Uçurum geride. Kalbim hâlâ kaburgalarımı yokluyor."
    si "The chasm is behind me. My heart is still testing my ribs."

# game/scene3_koridor.rpy:375
translate english sahne3_son_9539720a:

    # si "Ve bir şey... bir şey öğrendim. Bedenim öğrendi."
    si "And I learned... something. My body learned it."

# game/scene3_koridor.rpy:380
translate english sahne3_son_f9dc5a7f:

    # si "Koridor devam ediyor. Ben de."
    si "The corridor goes on. So do I."

# game/scene3_koridor.rpy:385
translate english sahne3_son_66cc3ddf:

    # si "Ve sonra — ileride, karanlığın içinde — bir ışık."
    si "And then — ahead, inside the darkness — a light."

# game/scene3_koridor.rpy:387
translate english sahne3_son_13482d31:

    # s "Kırmızı bir ışık."
    s "A red light."

# game/scene3_koridor.rpy:389
translate english sahne3_son_839b1435:

    # si "Benimki gibi. Kısık, sıcak, kırmızı."
    si "Like mine. Low, warm, red."

# game/scene3_koridor.rpy:391
translate english sahne3_son_ae0af5dd:

    # s "Bir lamba daha."
    s "Another lamp."

# game/scene3_koridor.rpy:393
translate english sahne3_son_b31078b7:

    # si "Ve yaklaşıyor."
    si "And it is getting closer."

# game/scene3_koridor.rpy:398
translate english sahne3_son_4c56160d:

    # s "İlk defa... sesin sustu."
    s "For the first time... your voice went quiet."

translate english strings:

    # game/scene3_koridor.rpy:108
    old "«Dur. Dinle.»"
    new "«Stop. Listen.»"

    # game/scene3_koridor.rpy:120
    old "«Yürü. Sakın arkana bakma.»"
    new "«Walk. Don't you dare look back.»"

    # game/scene3_koridor.rpy:167
    old "«Lambayı kemerine as. İki elin de serbest olsun.»"
    new "«Hang the lamp on your belt. Keep both hands free.»"

    # game/scene3_koridor.rpy:170
    old "«Lambayı bırakma. Alev sönmemeli.»"
    new "«Don't let go of the lamp. The flame must not die.»"

    # game/scene3_koridor.rpy:174
    old "«Geri dön. Başka bir yol olmalı.»"
    new "«Turn back. There must be another way.»"
# TODO: Translation updated at 2026-09-03 13:38

# game/scene3_koridor.rpy:366
translate english sahne3_gecis_krit_fiyasko_1302b98d:

    # si "Ve kapatmıyorum."
    si "And I don't close them."

# game/scene3_koridor.rpy:368
translate english sahne3_gecis_krit_fiyasko_8d7139e0:

    # si "Bir kök. Bir çıkıntı. Bir şey — parmaklarım kendiliğinden kapanıyor."
    si "A root. A ledge. Something — my fingers close on it by themselves."

# game/scene3_koridor.rpy:370
translate english sahne3_gecis_krit_fiyasko_ff451d9a:

    # si "Omzum yerinden çıkacak gibi. Çıkmıyor. Sadece bağırıyor."
    si "My shoulder feels like it will tear loose. It doesn't. It only screams."

# game/scene3_koridor.rpy:376
translate english sahne3_gecis_krit_fiyasko_7256d608:

    # si "Yukarı tırmanıyorum. Tırnaklarımdan biri taşta kaldı."
    si "I climb back up. One of my nails stays behind in the stone."

# game/scene3_koridor.rpy:378
translate english sahne3_gecis_krit_fiyasko_f4203fe7:

    # si "Lambam düşerken kapağı açılmış. Alev artık bir parmak boyu."
    si "The lamp's cap came open when it fell. The flame is a finger tall now."

